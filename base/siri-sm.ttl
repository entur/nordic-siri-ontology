        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:stopFacility ;
            siri:xsdSequenceOrder 6 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:extensions ;
            siri:xsdSequenceOrder 7 ],
        siri:AbstractIdentifiedItemStructure .

siri:ServiceExceptionStructure a owl:Class ;
    rdfs:label "ServiceException" ;
    rdfs:comment "Type for whether service is unavailable for all or some services SIRI 2.0" ;
    rdfs:subClassOf [ a owl:Restriction ;
