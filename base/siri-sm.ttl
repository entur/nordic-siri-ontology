siri:DeliveryVariantStructure a owl:Class ;
    rdfs:label "DeliveryVariant" ;
    rdfs:comment "Type for Delivery Variant (since SIRI 2.0)" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:variantType ;
            siri:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:content ;
            siri:xsdSequenceOrder 2 ] .

siri:MonitoredStopVisit a owl:Class ;
    rdfs:label "MonitoredStopVisit" ;
    rdfs:subClassOf siri:MonitoredStopVisitStructure ;
    siri:xsdElement true .

siri:MonitoredStopVisitCancellation a owl:Class ;
    rdfs:label "MonitoredStopVisitCancellation" ;
    rdfs:subClassOf siri:MonitoredStopVisitCancellationStructure ;
    siri:xsdElement true .

siri:ServiceException a owl:Class ;
    rdfs:label "ServiceException" ;
    rdfs:subClassOf siri:ServiceExceptionStructure ;
    siri:xsdElement true .

siri:ServiceExceptionEnumeration a rdfs:Datatype ;
    rdfs:label "ServiceExceptionEnumeration" ;
    rdfs:comment "Classification of the service exception" ;
    owl:oneOf ( "beforeFirstJourney" "afterLastJourney" "noServiceToday" "transportTemporarilySuspended" "transportLongtermSuspended" "transportSeverlyDisrupted" "realtimeDataNotAvailable" "realtimeDataAvailable" ) .

siri:StopLineNotice a owl:Class ;
    rdfs:label "StopLineNotice" ;
    rdfs:subClassOf siri:StopLineNoticeStructure ;
    siri:xsdElement true .

siri:StopLineNoticeCancellation a owl:Class ;
    rdfs:label "StopLineNoticeCancellation" ;
    rdfs:subClassOf siri:StopLineNoticeCancellationStructure ;
    siri:xsdElement true .

siri:StopMonitoringCapabilitiesResponse a owl:Class ;
    rdfs:label "StopMonitoringCapabilitiesResponse" ;
    rdfs:subClassOf siri:StopMonitoringCapabilitiesResponseStructure ;
    siri:xsdElement true .

siri:StopMonitoringCapabilityRequestPolicyStructure a owl:Class ;
    rdfs:label "StopMonitoringCapabilityRequestPolicy" ;
    rdfs:comment "Type for Monitoring Service Capability Request Policy." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:useReferences ;
            siri:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:useNames ;
            siri:xsdSequenceOrder 2 ],
        siri:CapabilityRequestPolicyStructure .

siri:StopMonitoringDeliveriesStructure a owl:Class ;
    rdfs:label "StopMonitoringDeliveries" ;
    rdfs:comment "Type for Deliveries for Stop Monitoring Service. Used in WSDL." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:stopMonitoringDelivery ;
            siri:xsdSequenceOrder 1 ] .

siri:StopMonitoringDelivery a owl:Class ;
    rdfs:label "StopMonitoringDelivery" ;
    rdfs:subClassOf siri:StopMonitoringDeliveryStructure ;
    siri:xsdElement true .

siri:StopMonitoringDetailEnumeration a rdfs:Datatype ;
    rdfs:label "StopMonitoringDetailEnumeration" ;
    rdfs:comment "Detail Levels for Stop Monitoring Request." ;
    owl:oneOf ( "minimum" "basic" "normal" "calls" "full" ) .

