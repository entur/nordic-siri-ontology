siri:MonitoredStopVisitStructure a owl:Class ;
    rdfs:label "MonitoredStopVisit" ;
    rdfs:comment "Type for Visit of a VEHICLE to a stop monitoring point. May provide information about the arrival, the departure or both." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:validUntilTime ;
            siri:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:monitoringRef ;
            siri:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
