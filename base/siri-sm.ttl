siri:MonitoredStopVisitCancellationStructure a owl:Class ;
    rdfs:label "MonitoredStopVisitCancellation" ;
    rdfs:comment "Type for Cancellation of an earlier Stop Visit." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:monitoringRef ;
            siri:xsdSequenceOrder 1 ],
