    rdfs:comment "Facility Definition." ;
    siri:xsdType "AnnotatedFacilityStructure" .

siri:annotatedLineRef a owl:ObjectProperty ;
    rdfs:label "AnnotatedLineRef" ;
    siri:isReference true .

siri:annotatedStopPointRef a owl:ObjectProperty ;
    rdfs:label "AnnotatedStopPointRef" ;
    siri:isReference true .

siri:connectionLinkName a owl:ObjectProperty ;
    rdfs:label "ConnectionLinkName" ;
    rdfs:comment "Name of SCHEDULED CONNECTION LINK. DetailLevel=minimum" ;
    siri:xsdType "NaturalLanguageStringStructure" .

siri:connectionLinkRef a owl:ObjectProperty ;
    rdfs:label "ConnectionLinkRef" ;
    rdfs:comment "Identifer of the connection link. DetailLevel=minimum" ;
    siri:isReference true ;
    siri:xsdType "ConnectionLinkRefStructure" .

siri:connectionLinksDetailLevel a owl:DatatypeProperty ;
    rdfs:label "ConnectionLinksDetailLevel" ;
    rdfs:comment "Level of detail to include in response. Default is 'normal'. (since SIRI 2.0)" ;
    siri:xsdType "ConnectionLinksDetailEnumeration" .

siri:destinationRef a owl:ObjectProperty ;
    rdfs:label "DestinationRef" ;
    rdfs:range siri:Destination ;
    siri:isReference true ;
    siri:xsdType "DestinationRefStructure" .

siri:destinations a owl:DatatypeProperty ;
    rdfs:label "Destinations" ;
    rdfs:comment "DESTINATIONs to which the LINE runs. Detail level is 'normal'" .

siri:directionRef a owl:ObjectProperty ;
    rdfs:label "DirectionRef" ;
    rdfs:comment "Direction in which destination lies. relatoive to currernt stop SIRI 2.0" ;
    rdfs:range siri:Direction ;
    siri:isReference true ;
    siri:xsdType "DirectionRefStructure" .

siri:directions a owl:DatatypeProperty ;
    rdfs:label "Directions" ;
    rdfs:comment "DIRECTIONs and Stops for the LINE. 'normal'" .

siri:distributorStopPointName a owl:ObjectProperty ;
    rdfs:label "DistributorStopPointName" ;
    rdfs:comment "Name of the distributor's stop. DetailLevel=full" ;
    siri:xsdType "NaturalLanguageStringStructure" .

siri:distributorStopPointRef a owl:ObjectProperty ;
    rdfs:label "DistributorStopPointRef" ;
    rdfs:comment "Identifer of the distributor's stop. DetailLevel=normal" ;
    siri:isReference true ;
    siri:xsdType "StopPointRefStructure" .

siri:facilityDetailLevel a owl:DatatypeProperty ;
    rdfs:label "FacilityDetailLevel" ;
    rdfs:comment "Level of detail to include in response. Default is 'normal'. (since SIRI 2.0)" ;
    siri:xsdType "FacilityDetailEnumeration" .

siri:features a owl:DatatypeProperty ;
    rdfs:label "Features" ;
    rdfs:comment "Service features of stop. Detail level is 'full'" .

siri:feederStopPointName a owl:ObjectProperty ;
    rdfs:label "FeederStopPointName" ;
    rdfs:comment "Name of the feeder's stop. DetailLevel=full" ;
    siri:xsdType "NaturalLanguageStringStructure" .

siri:feederStopPointRef a owl:ObjectProperty ;
    rdfs:label "FeederStopPointRef" ;
    rdfs:comment "Identifer of the feeder's stop. DetailLevel=normal" ;
    siri:isReference true ;
    siri:xsdType "StopPointRefStructure" .

siri:infoChannel a owl:DatatypeProperty ;
    rdfs:label "InfoChannel" .

siri:infoChannelCode a owl:DatatypeProperty ;
    rdfs:label "InfoChannelCode" ;
    rdfs:comment "Identifier of classification." ;
    siri:xsdType "InfoChannelCodeType" .

siri:journeyPatterns a owl:DatatypeProperty ;
    rdfs:label "JourneyPatterns" ;
    rdfs:comment "JourneyPatterns in Direction of route (since SIRI 2.0)" .

siri:lineDirectionRef a owl:ObjectProperty ;
    rdfs:label "LineDirectionRef" ;
    rdfs:comment "Reference to line for which details are to be returned (v2.0)" ;
    siri:isReference true ;
    siri:xsdType "LineDirectionStructure" .

siri:lineName a owl:ObjectProperty ;
    rdfs:label "LineName" ;
    rdfs:comment "Name of LINE. (Unbounded since SIRI 2.0)" ;
    siri:xsdType "NaturalLanguageStringStructure" .

siri:lines a owl:DatatypeProperty ;
    rdfs:label "Lines" ;
    rdfs:comment "LINEs that use stop. Detail level is 'full'" .

siri:linesDetailLevel a owl:DatatypeProperty ;
    rdfs:label "LinesDetailLevel" ;
    rdfs:comment "Level of detail to include in response. Default is 'normal'. (since SIRI 2.0)" ;
    siri:xsdType "LinesDetailEnumeration" .

siri:linkProjectionToNextStopPoint a owl:ObjectProperty ;
    rdfs:label "LinkProjectionToNextStopPoint" ;
    rdfs:comment "GIs projection of Link to the next provided StopPoint. NB Line here means Geometry Polyline, not Transmodel Transport Line." ;
    siri:xsdType "ifopt:LinkProjectionStructure" .

siri:location a owl:ObjectProperty ;
    rdfs:label "Location" ;
    rdfs:comment "Coordinates to use to show stop as a poitn on map. Detail level is 'normal'.+SIRI.v2.0" ;
    siri:xsdType "LocationStructure" .

siri:onwardLinkShape a owl:ObjectProperty ;
    rdfs:label "OnwardLinkShape" ;
    rdfs:comment "Plot of points from this stop to next Stop. Detail level is 'full'. (since SIRI 2.0)" ;
    siri:xsdType "LineShapeStructure" .

siri:order a owl:DatatypeProperty ;
    rdfs:label "Order" ;
    rdfs:comment "Order of STOP POINT in route (since SIRI 2.0)" ;
    siri:xsdType "xsd:positiveInteger" .

siri:placeName a owl:ObjectProperty ;
    rdfs:label "PlaceName" ;
    rdfs:comment "Name of destination TOPOGRAPHIC PLACE. (Unbounded since SIRI 2.0)" ;
    siri:xsdType "NaturalLanguageStringStructure" .

siri:productCategory a owl:DatatypeProperty ;
    rdfs:label "ProductCategory" .

siri:productCategoryCode a owl:DatatypeProperty ;
    rdfs:label "ProductCategoryCode" ;
    rdfs:comment "Identifier of TYPE OF PRODUCT CATEGORY classification. SIRI provides a recommended set of values covering most usages, intended to be TPEG compatible. See the SIRI facilities packaged." ;
    siri:xsdType "ProductCategoryCodeType" .

siri:serviceFeature a owl:DatatypeProperty ;
    rdfs:label "ServiceFeature" .

siri:serviceFeatureCode a owl:DatatypeProperty ;
    rdfs:label "ServiceFeatureCode" ;
    rdfs:comment "Identifier of classification. SIRI provides a recommended set of values covering most usages, intended to be TPEG compatible. See the SIRI facilities packaged." ;
    siri:xsdType "ServiceFeatureCodeType" .

siri:stopAreaRef a owl:ObjectProperty ;
    rdfs:label "StopAreaRef" ;
    rdfs:comment "Identifer of the sSTOP AREA to which SCHEDULED STOP POINT belongs. +SIRI.v2.0" ;
    siri:isReference true ;
    siri:xsdType "StopAreaRefStructure" .

siri:stopName a owl:ObjectProperty ;
    rdfs:label "StopName" ;
    rdfs:comment "Name of SCHEDULED STOP POINT. Detail level is 'normal'. (Unbounded since SIRI 2.0)" ;
    siri:xsdType "NaturalLanguageStringStructure" .

siri:stopPointRef a owl:ObjectProperty ;
    rdfs:label "StopPointRef" ;
    rdfs:comment "Identifer of the stop." ;
    siri:isReference true ;
    siri:xsdType "StopPointRefStructure" .

siri:stopPointsDetailLevel a owl:DatatypeProperty ;
    rdfs:label "StopPointsDetailLevel" ;
    rdfs:comment "Level of detail to include in response. Default is 'normal'. (since SIRI 2.0)" ;
    siri:xsdType "StopPointsDetailEnumeration" .

siri:timingPoint a owl:DatatypeProperty ;
    rdfs:label "TimingPoint" .

siri:vehicleFeature a owl:DatatypeProperty ;
    rdfs:label "VehicleFeature" .

siri:vehicleFeatureCode a owl:DatatypeProperty ;
    rdfs:label "VehicleFeatureCode" ;
    rdfs:comment "Identifier of feature of VEHICLE. SIRI provides a recommended set of values covering most usages, intended to be TPEG compatible. See the SIRI facilities packaged." ;
    siri:xsdType "VehicleFeatureCodeType" .

siri:AnnotatedStopPointStructure a owl:Class ;
    rdfs:label "AnnotatedStopPoint" ;
    rdfs:comment "View of a SCHEDULED STOP POINT description." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:stopPointRef ;
            siri:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:timingPoint ;
            siri:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:monitored ;
            siri:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:onProperty siri:stopName ;
            siri:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:stopAreaRef ;
            siri:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:features ;
            siri:xsdSequenceOrder 6 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:lines ;
            siri:xsdSequenceOrder 7 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:location ;
            siri:xsdSequenceOrder 8 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:url ;
            siri:xsdSequenceOrder 9 ] .

siri:url a owl:DatatypeProperty ;
    rdfs:label "Url" ;
    rdfs:comment "Web page associated with Stop. Detail level is 'full'+SIRI.v2.0" ;
    siri:xsdType "xsd:anyURI" .

siri:circle a owl:ObjectProperty ;
    rdfs:label "Circle" ;
    rdfs:comment "Circle containing stops be returned. Point indicates centre, precision indicates radius ((since SIRI 2.0))" ;
    siri:xsdType "LocationStructure" .

siri:monitored a owl:DatatypeProperty ;
    rdfs:label "Monitored" ;
    rdfs:comment "Whether the LINE has real-time info. Default is 'true'." ;
    siri:xsdType "xsd:boolean" .

siri:boundingBox a owl:ObjectProperty ;
    rdfs:label "BoundingBox" ;
    rdfs:comment "Rectangle containing stops be returned. ((since SIRI 2.0))" ;
    siri:xsdType "BoundingBoxStructure" .

siri:icon a owl:DatatypeProperty ;
    rdfs:label "Icon" ;
    rdfs:comment "Icon used to represent TYPE OF PRODUCT CATEGORY." ;
    siri:xsdType "xsd:anyURI" .

siri:lineRef a owl:ObjectProperty ;
    rdfs:label "LineRef" ;
    rdfs:comment "Filter the results to include only stops for the given LINE. ((since SIRI 2.0))" ;
    siri:isReference true ;
    siri:xsdType "LineRefStructure" .

siri:name a owl:ObjectProperty ;
    rdfs:label "Name" ;
    rdfs:comment "Name of classification (Unbounded since SIRI 2.0)" ;
    siri:xsdType "NaturalLanguageStringStructure" .

siri:operatorRef a owl:ObjectProperty ;
    rdfs:label "OperatorRef" ;
    rdfs:comment "Filter the results to include only stops run by the specified OPERATOR. ((since SIRI 2.0))" ;
    siri:isReference true ;
    siri:xsdType "OperatorRefStructure" .

siri:placeRef a owl:ObjectProperty ;
    rdfs:label "PlaceRef" ;
    rdfs:comment "Filter the results to include only stops associated with the PLACE . ((since SIRI 2.0))" ;
    siri:isReference true ;
    siri:xsdType "xsd:normalizedString" .

siri:language a owl:DatatypeProperty ;
    rdfs:label "Language" ;
    rdfs:comment "Preferred languages in which to return text values. (since SIRI 2.0)" ;
    siri:xsdType "xsd:language" .

siri:extensions a owl:DatatypeProperty ;
    rdfs:label "Extensions" .

