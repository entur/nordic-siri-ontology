    siri:xsdElement true .

siri:StopPointInPatternStructure a owl:Class ;
    rdfs:label "StopPointInPattern" ;
    rdfs:comment "Summary information about a stop within line" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:order ;
            siri:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:onwardLinkShape ;
            siri:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:linkProjectionToNextStopPoint ;
            siri:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:extensions ;
            siri:xsdSequenceOrder 4 ],
        siri:AnnotatedStopPointStructure .

siri:StopPointsDelivery a owl:Class ;
    rdfs:label "StopPointsDelivery" ;
    rdfs:subClassOf siri:StopPointsDeliveryStructure ;
    siri:xsdElement true .

