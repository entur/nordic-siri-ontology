siri:RouteDirectionStructure a owl:Class ;
    rdfs:label "RouteDirection" ;
    rdfs:comment "Summary information about a Direction of a Line" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:journeyPatterns ;
            siri:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:extensions ;
            siri:xsdSequenceOrder 2 ],
        siri:DirectionStructure .

