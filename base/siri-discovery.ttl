siri:ConnectionLinksDetailEnumeration a rdfs:Datatype ;
    rdfs:label "ConnectionLinksDetailEnumeration" ;
    rdfs:comment "Detail Levels for CONNECTION LINKs Discovery Request. (since SIRI 2.0)" ;
