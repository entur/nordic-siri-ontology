    rdfs:comment "Values for ScopeType - TPEG Pts36, AlertForType with additional values" ;
    owl:oneOf ( "unknown" "stopPlace" "line" "route" "publicTransportService" "operator" "city" "area" "stopPoint" "stopPlaceComponent" "place" "network" "vehicleJourney" "datedVehicleJourney" "connectionLink" "interchange" "allPT" "general" "road" "undefined" ) .

siri:SectionRefStructure a owl:Class ;
