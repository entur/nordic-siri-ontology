siri:SituationSimpleRefStructure a owl:Class ;
    rdfs:label "SituationSimple" ;
    rdfs:comment "Type for reference to a SITUATION. Includes the Particpant identifier and version components of the identifier." .

siri:accessControl a owl:DatatypeProperty ;
    rdfs:label "AccessControl" ;
    rdfs:comment "Optional Access control capabilities." .

siri:accessFeatureType a owl:DatatypeProperty ;
    rdfs:label "AccessFeatureType" ;
    rdfs:comment "Type of AccessFeature (+SIRI.20)" ;
    siri:xsdType "AccessibilityFeatureEnumeration" .

siri:accessibilityFeature a owl:DatatypeProperty ;
    rdfs:label "AccessibilityFeature" ;
    rdfs:comment "Nature of CONNECTION link." ;
    siri:xsdType "AccessibilityFeatureEnumeration" .

siri:accessibilityNeedFilter a owl:ObjectProperty ;
    rdfs:label "AccessibilityNeedFilter" ;
    rdfs:comment "Parameters to filter Situation Exchange Service requests, based on specific needs ." ;
    siri:xsdType "acsb:PassengerAccessibilityNeedsStructure" .

siri:actionData a owl:ObjectProperty ;
    rdfs:label "ActionData" ;
    rdfs:comment "Data associated with action." ;
    siri:xsdType "ActionDataStructure" .

siri:actionPriority a owl:DatatypeProperty ;
    rdfs:label "ActionPriority" ;
    rdfs:comment "Prioritises a passenger information action from the information owner's point of view, e.g. suitable for sorting or hiding individual passenger information actions. 1 = highest priority." ;
    siri:xsdType "xsd:positiveInteger" .

siri:actionRef a owl:ObjectProperty ;
    rdfs:label "ActionRef" ;
    rdfs:comment "Reference to the action number within the incident concept." ;
    siri:isReference true ;
    siri:xsdType "EntryQualifierStructure" .

siri:actionStatus a owl:DatatypeProperty ;
    rdfs:label "ActionStatus" ;
    rdfs:comment "Processing Status of action at time of SITUATION publication. Default is 'open'." ;
    siri:xsdType "ActionStatusEnumeration" .

siri:actions a owl:ObjectProperty ;
    rdfs:label "Actions" ;
    rdfs:comment "Actions that apply to all SITUATIONs unless overridden." ;
    siri:xsdType "ActionsStructure" .

siri:actualArrivalTime a owl:DatatypeProperty ;
    rdfs:label "ActualArrivalTime" .

siri:actualDepartureTime a owl:DatatypeProperty ;
    rdfs:label "ActualDepartureTime" .

siri:adviceName a owl:ObjectProperty ;
    rdfs:label "AdviceName" ;
    rdfs:comment "Textual classification of advice, from which a standardized message can be generated. Not normally needed, except when AdviceType is absent." ;
    siri:xsdType "NaturalLanguageStringStructure" .

siri:adviceRef a owl:ObjectProperty ;
    rdfs:label "AdviceRef" ;
    rdfs:comment "Reference to a standard advisory NOTICE to be given to passengers if a particular condition arises." ;
    siri:isReference true ;
    siri:xsdType "AdviceRefStructure" .

siri:adviceType a owl:DatatypeProperty ;
    rdfs:label "AdviceType" ;
    rdfs:comment "Structured classification of advice for passengers in the given SITUATION, from which a standardized message can be generated." ;
    siri:xsdType "AdviceTypeEnumeration" .

siri:affectedComponents a owl:DatatypeProperty ;
    rdfs:label "AffectedComponents" ;
    rdfs:comment "Quays affected by SITUATION." .

siri:affectedInterchanges a owl:DatatypeProperty ;
    rdfs:label "AffectedInterchanges" .

siri:affectedLine a owl:ObjectProperty ;
    rdfs:label "AffectedLine" ;
    rdfs:comment "Information about the indvidual LINEs in the network that are affected. If not explicitly overridden, modes and submodes will be defaulted to any values present (i) in the AffectedNetwork (ii) In the general context." ;
    siri:xsdType "AffectedLineStructure" .

siri:affectedModes a owl:ObjectProperty ;
    rdfs:label "AffectedModes" ;
    rdfs:comment "Modes within station/stop affected by the SITUATION. If not specified, assume all modes of that station." ;
    siri:xsdType "AffectedModesStructure" .

siri:affectedNavigationPaths a owl:DatatypeProperty ;
    rdfs:label "AffectedNavigationPaths" ;
    rdfs:comment "PathLinks affected by SITUATION." .

siri:affectedPathLink a owl:ObjectProperty ;
    rdfs:label "AffectedPathLink" ;
    rdfs:comment "PATH LINKs affected by a SITUATION." ;
    siri:xsdType "AffectedPathLinkStructure" .

siri:affectedRoad a owl:ObjectProperty ;
    rdfs:label "AffectedRoad" ;
    rdfs:comment "Description of affected road." ;
    siri:xsdType "AffectedRoadStructure" .

siri:affectedSection a owl:ObjectProperty ;
    rdfs:label "AffectedSection" ;
    rdfs:comment "Only some COMMON SECTIONs are affected, LINE level information not available." ;
    siri:xsdType "AffectedSectionStructure" .

siri:agentReference a owl:DatatypeProperty ;
    rdfs:label "AgentReference" ;
    rdfs:comment "Reference to an Agent, i.e. Capture client user who input a SITUATION. Available for use in intranet exchange of SITUATIONs." ;
    siri:xsdType "xsd:string" .

siri:aimedArrivalTime a owl:DatatypeProperty ;
    rdfs:label "AimedArrivalTime" .

siri:aimedDepartureTime a owl:DatatypeProperty ;
    rdfs:label "AimedDepartureTime" .

siri:aimedHeadwayInterval a owl:DatatypeProperty ;
    rdfs:label "AimedHeadwayInterval" .

siri:allModes a owl:DatatypeProperty ;
    rdfs:label "AllModes" ;
    rdfs:comment "All known modes for stop." ;
    siri:xsdType "EmptyType" .

siri:areaOfInterest a owl:DatatypeProperty ;
    rdfs:label "AreaOfInterest" ;
    rdfs:comment "Affected overall Geographic scope." ;
    siri:xsdType "D2LogicalModel:AreaOfInterestEnum" .

siri:arrivalPlatformName a owl:DatatypeProperty ;
    rdfs:label "ArrivalPlatformName" .

siri:arrivalStatus a owl:DatatypeProperty ;
    rdfs:label "ArrivalStatus" .

siri:beforeNotices a owl:DatatypeProperty ;
    rdfs:label "BeforeNotices" ;
    rdfs:comment "Whether reminders should be sent." .

siri:blocking a owl:ObjectProperty ;
    rdfs:label "Blocking" ;
    rdfs:comment "How Disruption should be handled in Info systems." ;
    siri:xsdType "BlockingStructure" .

siri:boarding a owl:ObjectProperty ;
    rdfs:label "Boarding" ;
    rdfs:comment "Change to normal boarding activity allowed at stop." ;
    siri:xsdType "BoardingStructure" .

siri:boardingStretch a owl:DatatypeProperty ;
    rdfs:label "BoardingStretch" ;
    rdfs:comment "Whether this is a Hail and Ride Stop. Default is 'false'." ;
    siri:xsdType "xsd:boolean" .

siri:byEmail a owl:DatatypeProperty ;
    rdfs:label "ByEmail" ;
    rdfs:comment "Send as email alert." ;
    siri:xsdType "xsd:boolean" .

siri:byMobile a owl:DatatypeProperty ;
    rdfs:label "ByMobile" ;
    rdfs:comment "Send as mobile alert by SMS or WAP push." ;
    siri:xsdType "xsd:boolean" .

siri:callCondition a owl:DatatypeProperty ;
    rdfs:label "CallCondition" ;
    rdfs:comment "Status of CALL TPEG 13_6" ;
    siri:xsdType "RoutePointTypeEnumeration" .

siri:calls a owl:DatatypeProperty ;
    rdfs:label "Calls" ;
    rdfs:comment "CALLs making up VEHICLE JOURNEY [equivalent to TPEG pti15 3 stop, 15_5 not-stopping, 15-6 temporary stop route_description_type]" .

siri:casualties a owl:ObjectProperty ;
    rdfs:label "Casualties" ;
    rdfs:comment "Information on casualties." ;
    siri:xsdType "CasualtiesStructure" .

siri:cause a owl:ObjectProperty ;
    rdfs:label "cause" ;
    rdfs:comment "Impact of Road SITUATION as specified by Datex2 model." ;
    siri:xsdType "D2LogicalModel:Cause" .

siri:ceefax a owl:DatatypeProperty ;
    rdfs:label "Ceefax" ;
    rdfs:comment "Publish to Ceefax. Default is 'true'." ;
    siri:xsdType "xsd:boolean" .

siri:clearNotice a owl:DatatypeProperty ;
    rdfs:label "ClearNotice" ;
    rdfs:comment "Whether a clearing notice should be displayed." ;
    siri:xsdType "xsd:boolean" .

siri:componentName a owl:ObjectProperty ;
    rdfs:label "ComponentName" ;
    rdfs:comment "Name of component. (Unbounded since SIRI 2.0)" ;
    siri:xsdType "NaturalLanguageStringStructure" .

siri:componentRef a owl:ObjectProperty ;
    rdfs:label "ComponentRef" ;
    rdfs:comment "Reference to a STOP PLACE." ;
    siri:isReference true ;
    siri:xsdType "ifopt:StopPlaceComponentRefStructure" .

siri:componentType a owl:DatatypeProperty ;
    rdfs:label "ComponentType" ;
    rdfs:comment "Type of Component." ;
    siri:xsdType "ifopt:StopPlaceComponentTypeEnumeration" .

siri:condition a owl:DatatypeProperty ;
    rdfs:label "Condition" ;
    rdfs:comment "Structured classification(s) of effect on service, from which a standardized message can be generated." .

siri:conditionName a owl:ObjectProperty ;
    rdfs:label "ConditionName" ;
    rdfs:comment "Textual classification of effect on service, from which a standardized message can be generated. Not normally needed, except when Condition is absent." ;
    siri:xsdType "NaturalLanguageStringStructure" .

siri:connectingStopPointName a owl:ObjectProperty ;
    rdfs:label "ConnectingStopPointName" ;
    rdfs:comment "Name of other connecting STOP POINT of a CONNECTION link. Derivable from StopRef. (Unbounded since SIRI 2.0)" ;
    siri:xsdType "NaturalLanguageStringStructure" .

siri:connectingStopPointRef a owl:ObjectProperty ;
    rdfs:label "ConnectingStopPointRef" ;
    rdfs:comment "Reference to other connecting STOP POINT of a CONNECTION link. If blank, both feeder and distributor vehicles go to same stop." ;
    siri:isReference true ;
    siri:xsdType "StopPointRefStructure" .

siri:connectingVehicleJourneyRef a owl:ObjectProperty ;
    rdfs:label "ConnectingVehicleJourneyRef" ;
    rdfs:comment "Reference to connecting VEHICLE JOURNEY affected by a SITUATION." ;
    siri:isReference true ;
    siri:xsdType "DatedVehicleJourneyRefStructure" .

siri:connectingZoneRef a owl:ObjectProperty ;
    rdfs:label "ConnectingZoneRef" ;
    rdfs:comment "Zone in which connecting stop lies." ;
    siri:isReference true ;
    siri:xsdType "ZoneRefStructure" .

siri:connectionDirection a owl:DatatypeProperty ;
    rdfs:label "ConnectionDirection" ;
    rdfs:comment "Direction of SERVICE JOURNEY INTERCHANGE. Default is 'both'." ;
    siri:xsdType "ConnectionDirectionEnumeration" .

siri:connectionLink a owl:ObjectProperty ;
    rdfs:label "ConnectionLink" ;
    rdfs:comment "Reference to a CONNECTION Link affected by a SITUATION." ;
    siri:xsdType "AffectedConnectionLinkStructure" .

siri:connectionLinks a owl:DatatypeProperty ;
    rdfs:label "ConnectionLinks" ;
    rdfs:comment "CONNECTION links from stop." .

siri:connectionName a owl:ObjectProperty ;
    rdfs:label "ConnectionName" ;
    rdfs:comment "Name of CONNECTION link affected by a SITUATION." ;
    siri:xsdType "NaturalLanguageStringStructure" .

siri:consequence a owl:ObjectProperty ;
    rdfs:label "Consequence" ;
    rdfs:comment "Nature of the effect to disrupt (or restore) service, and further details." ;
    siri:xsdType "PtConsequenceStructure" .

siri:consequenceContent a owl:ObjectProperty ;
    rdfs:label "ConsequenceContent" ;
    rdfs:comment "Content for n consequences of a passenger information action. For hiding / sorting descriptions in end devices, a consequence priority can be set." ;
    siri:xsdType "ConsequenceContentStructure" .

siri:consequencePriority a owl:DatatypeProperty ;
    rdfs:label "ConsequencePriority" ;
    rdfs:comment "Prioritises a consequence from the information owner's point of view, e.g. usable for sorting or hiding individual consequences. 1 = highest priority." ;
    siri:xsdType "xsd:positiveInteger" .

siri:consequenceText a owl:ObjectProperty ;
    rdfs:label "ConsequenceText" ;
    rdfs:comment "Consequence of passenger information action in a specific language." ;
    siri:xsdType "DefaultedTextStructure" .

siri:country a owl:ObjectProperty ;
    rdfs:label "Country" ;
    rdfs:comment "Country of origin of source element." ;
    siri:isReference true ;
    siri:xsdType "ifopt:CountryRefStructure" .

siri:courseOfJourneyRef a owl:ObjectProperty ;
    rdfs:label "CourseOfJourneyRef" ;
    rdfs:comment "COURSE OF JOURNEY ('Run') that VEHICLE is running." ;
    siri:isReference true ;
    siri:xsdType "CourseOfJourneyRefStructure" .

siri:currentLocation a owl:ObjectProperty ;
    rdfs:label "CurrentLocation" ;
    rdfs:comment "Current Location of the VEHICLE" ;
    siri:xsdType "LocationStructure" .

siri:datedVehicleJourneyRef a owl:ObjectProperty ;
    rdfs:label "DatedVehicleJourneyRef" ;
    rdfs:comment "Reference to a specific DATED VEHICLE JOURNEY affected by a SITUATION." ;
    rdfs:range siri:DatedVehicleJourney ;
    siri:isReference true ;
    siri:xsdType "DatedVehicleJourneyRefStructure" .

siri:datex2Locations a owl:ObjectProperty ;
    rdfs:label "Datex2Locations" ;
    rdfs:comment "Refereences to road network locations affected by the SITUATION." ;
    siri:xsdType "D2LogicalModel:GroupOfLocations" .

siri:defaultLanguage a owl:DatatypeProperty ;
    rdfs:label "DefaultLanguage" ;
    rdfs:comment "Default language of text." ;
    siri:xsdType "xsd:language" .

siri:delay a owl:DatatypeProperty ;
    rdfs:label "Delay" ;
    rdfs:comment "Additional journey time needed to overcome disruption." ;
    siri:xsdType "PositiveDurationType" .

siri:delayBand a owl:DatatypeProperty ;
    rdfs:label "DelayBand" ;
    rdfs:comment "Time band into which delay will fall." ;
    siri:xsdType "DelayBandEnumeration" .

siri:delayType a owl:DatatypeProperty ;
    rdfs:label "DelayType" ;
    rdfs:comment "Category of delay." ;
    siri:xsdType "D2LogicalModel:DelaysTypeEnum" .

siri:delays a owl:ObjectProperty ;
    rdfs:label "Delays" ;
    rdfs:comment "Information on delays." ;
    siri:xsdType "DelaysStructure" .

siri:departurePlatformName a owl:DatatypeProperty ;
    rdfs:label "DeparturePlatformName" .

siri:departureStatus a owl:DatatypeProperty ;
    rdfs:label "DepartureStatus" .

siri:descriptionContent a owl:ObjectProperty ;
    rdfs:label "DescriptionContent" ;
    rdfs:comment "Content for n descriptions of a passenger information action. For hiding / sorting descriptions in end devices, a description priority can be set." ;
    siri:xsdType "DescriptionContentStructure" .

siri:descriptionPriority a owl:DatatypeProperty ;
    rdfs:label "DescriptionPriority" ;
    rdfs:comment "Prioritises a description from the information owner's point of view, e.g. usable for sorting or hiding individual descriptions. 1 = highest priority." ;
    siri:xsdType "xsd:positiveInteger" .

siri:descriptionText a owl:ObjectProperty ;
    rdfs:label "DescriptionText" ;
    rdfs:comment "Description of passenger information action in a specific language. Should not repeat any strap line included in Summary." ;
    siri:xsdType "DefaultedTextStructure" .

siri:destinationAimedArrivalTime a owl:DatatypeProperty ;
    rdfs:label "DestinationAimedArrivalTime" ;
    rdfs:comment "Timetabled arrival time of journey at Destination." ;
    siri:xsdType "xsd:dateTime" .

siri:destinationDisplay a owl:ObjectProperty ;
    rdfs:label "DestinationDisplay" ;
    rdfs:comment "Destination to show for the VEHICLE at the specific stop (vehicle signage), if different to the Destination Name for the full journey." ;
    siri:xsdType "NaturalLanguageStringStructure" .

siri:destinationDisplayAtOrigin a owl:ObjectProperty ;
    rdfs:label "DestinationDisplayAtOrigin" ;
    rdfs:comment "DESTINATION name shown for journey at the origin. Can be Used to identify journey for user. (since SIRI 2.0)" ;
    siri:xsdType "NaturalLanguagePlaceNameStructure" .

siri:details a owl:ObjectProperty ;
    rdfs:label "Details" ;
    rdfs:comment "Further textual advice to passengers. (Unbounded since SIRI 2.0)" ;
    siri:xsdType "NaturalLanguageStringStructure" .

siri:directionBound a owl:DatatypeProperty ;
    rdfs:label "directionBound" ;
    rdfs:comment "The DIRECTION at the reference point in terms of general destination DIRECTION. If absent both." ;
    siri:xsdType "D2LogicalModel:DirectionEnum" .

siri:directionRef a owl:ObjectProperty ;
    rdfs:label "DirectionRef" ;
    rdfs:comment "DIRECTION of LINE in which journey runs." ;
    rdfs:range siri:Direction ;
    siri:isReference true ;
    siri:xsdType "DirectionRefStructure" .

siri:distanceFromEnd a owl:DatatypeProperty ;
    rdfs:label "DistanceFromEnd" ;
    rdfs:comment "Distance in metres from end of link at which SITUATION is to be shown. I f absent use end of link." ;
    siri:xsdType "xsd:unsignedInt" .

siri:distanceFromStart a owl:DatatypeProperty ;
    rdfs:label "DistanceFromStart" ;
    rdfs:comment "Distance in metres from start of link at which SITUATION is to be shown. I f absent use start of link." ;
    siri:xsdType "xsd:unsignedInt" .

siri:durationContent a owl:ObjectProperty ;
    rdfs:label "DurationContent" ;
    rdfs:comment "Content for the duration of a passenger information action." ;
    siri:xsdType "DurationContentStructure" .

siri:durationText a owl:ObjectProperty ;
    rdfs:label "DurationText" ;
    rdfs:comment "Indicates the currently expected duration of a SITUATION in a specific language. An estimation should be given here, because an indefinite duration is not helpful to the passenger. The duration can be adjusted at any time, if the traffic operator has additional information." ;
    siri:xsdType "DefaultedTextStructure" .

siri:easement a owl:ObjectProperty ;
    rdfs:label "Easement" ;
    rdfs:comment "Description of fare exceptions allowed because of disruption. (Unbounded since SIRI 2.0)" ;
    siri:xsdType "NaturalLanguageStringStructure" .

siri:easementRef a owl:ObjectProperty ;
    rdfs:label "EasementRef" ;
    rdfs:comment "Refernce to a fare exceptions code that is allowed because of the disruption. An easement may relax a fare condition, for example \"You may use your metro ticket on the bus', or 'You may use your bus ticket in teh metro between these two stops'." ;
    siri:isReference true ;
    siri:xsdType "xsd:normalizedString" .

siri:easements a owl:ObjectProperty ;
    rdfs:label "Easements" ;
    rdfs:comment "Description of fare exceptions allowed because of disruption." ;
    siri:xsdType "EasementsStructure" .

siri:endStopPointRef a owl:ObjectProperty ;
    rdfs:label "EndStopPointRef" ;
    rdfs:comment "Identifier of stop point at which availability last applies." ;
    siri:isReference true ;
    siri:xsdType "StopPointRefStructure" .

siri:equipmentRef a owl:ObjectProperty ;
    rdfs:label "EquipmentRef" ;
    rdfs:comment "Reference to an EQUIPMENT found at SITE." ;
    siri:isReference true ;
    siri:xsdType "xsd:NMTOKEN" .

siri:expectedArrivalTime a owl:DatatypeProperty ;
    rdfs:label "ExpectedArrivalTime" .

siri:expectedDepartureTime a owl:DatatypeProperty ;
    rdfs:label "ExpectedDepartureTime" .

siri:expectedHeadwayInterval a owl:DatatypeProperty ;
    rdfs:label "ExpectedHeadwayInterval" .

siri:externalCode a owl:DatatypeProperty ;
    rdfs:label "ExternalCode" ;
    rdfs:comment "External system reference to SITUATION." ;
    siri:xsdType "xsd:string" .

siri:externalReference a owl:DatatypeProperty ;
    rdfs:label "ExternalReference" ;
    rdfs:comment "A single string that identifiers the referenced SITUATION." ;
    siri:xsdType "xsd:string" .

siri:facilities a owl:DatatypeProperty ;
    rdfs:label "Facilities" ;
    rdfs:comment "Facilities available for VEHICLE JOURNEY (since SIRI 2.0)" .

siri:facilityName a owl:ObjectProperty ;
    rdfs:label "FacilityName" ;
    rdfs:comment "Name of FACILITY." ;
    siri:xsdType "NaturalLanguageStringStructure" .

siri:facilityStatus a owl:DatatypeProperty ;
    rdfs:label "FacilityStatus" ;
    rdfs:comment "Status of Facility" ;
    siri:xsdType "FacilityStatusEnumeration" .

siri:fax a owl:DatatypeProperty ;
    rdfs:label "Fax" ;
    rdfs:comment "Fax number of Supplier of information." ;
    siri:xsdType "PhoneType" .

siri:generalPublicComment a owl:ObjectProperty ;
    rdfs:label "generalPublicComment" ;
    rdfs:comment "Datex 2 comments for public use." ;
    siri:xsdType "D2LogicalModel:Comment" .

siri:groupOfLocations a owl:ObjectProperty ;
    rdfs:label "groupOfLocations" ;
    rdfs:comment "Datex 2 model of where event ois taking place on the road." ;
    siri:xsdType "D2LogicalModel:GroupOfLocations" .

siri:headwayService a owl:DatatypeProperty ;
    rdfs:label "HeadwayService" ;
    rdfs:comment "Whether this is a Headway Service, that is shown as operating at a prescribed interval rather than to a fixed timetable. Default is 'false'." ;
    siri:xsdType "xsd:boolean" .

siri:iPAddress a owl:DatatypeProperty ;
    rdfs:label "IPAddress" ;
    rdfs:comment "Internet protocol address of the VEHICLE in form 000.000.000.000" ;
    siri:xsdType "xsd:NMTOKEN" .

siri:imageBinary a owl:DatatypeProperty ;
    rdfs:label "ImageBinary" ;
    rdfs:comment "Embedded image." ;
    siri:xsdType "xsd:base64Binary" .

siri:imageContent a owl:DatatypeProperty ;
    rdfs:label "ImageContent" ;
    rdfs:comment "Categorisation of image content." ;
    siri:xsdType "ImageContentEnumeration" .

siri:imageRef a owl:ObjectProperty ;
    rdfs:label "ImageRef" ;
    rdfs:comment "Reference to an image." ;
    siri:isReference true ;
    siri:xsdType "xsd:anyURI" .

siri:impact a owl:ObjectProperty ;
    rdfs:label "impact" ;
    rdfs:comment "Impact of Road SITUATION as specified by Datex2." ;
    siri:xsdType "D2LogicalModel:Impact" .

siri:inCongestion a owl:DatatypeProperty ;
    rdfs:label "InCongestion" ;
    rdfs:comment "Whether the VEHICLE is in traffic congestion. If not, present, not known." ;
    siri:xsdType "xsd:boolean" .

siri:inPanic a owl:DatatypeProperty ;
    rdfs:label "InPanic" ;
    rdfs:comment "Whether the panic alarm on the VEHICLE is activated. Default is 'false'." ;
    siri:xsdType "xsd:boolean" .

siri:includeOnlyIfInPublicationWindow a owl:DatatypeProperty ;
    rdfs:label "IncludeOnlyIfInPublicationWindow" ;
    rdfs:comment "Only incidents that are currently within their publication window shouldbe included. Otherwose all incidents will be included. Default is false" ;
    siri:xsdType "xsd:boolean" .

siri:includeTranslations a owl:DatatypeProperty ;
    rdfs:label "IncludeTranslations" .

siri:incrementalUpdates a owl:DatatypeProperty ;
    rdfs:label "IncrementalUpdates" ;
    rdfs:comment "Whether the producer will return the complete set of current data, or only provide updates to this data, i.e. additions, modifications and deletions. If false or omitted, each subscription response will contain the full information as specified in this request." ;
    siri:xsdType "xsd:boolean" .

siri:indirectSectionRef a owl:ObjectProperty ;
    rdfs:label "IndirectSectionRef" ;
    rdfs:comment "An indirect reference to a COMMON SECTION by stating the stop point ref of the first and last POINT IN JOURNEY PATTERN of the section in question. Intermediate POINTs should be added if necessary to distinguish different sections having the same start and end point and is a means to exclude sections not containing those stop points." ;
    siri:isReference true .

siri:infoLink a owl:ObjectProperty ;
    rdfs:label "InfoLink" ;
    rdfs:comment "Hyperlinks to other resources associated with SITUATION." ;
    siri:xsdType "InfoLinkStructure" .

siri:interchangeStatusType a owl:DatatypeProperty ;
    rdfs:label "InterchangeStatusType" .

siri:interchangeStopPointName a owl:ObjectProperty ;
    rdfs:label "InterchangeStopPointName" ;
    rdfs:comment "Name of other Connecting STOP POINT of a connection. Derivable from InterchangeStopRef. (Unbounded since SIRI 2.0)" ;
    siri:xsdType "NaturalLanguageStringStructure" .

siri:interchangeStopPointRef a owl:ObjectProperty ;
    rdfs:label "InterchangeStopPointRef" ;
    rdfs:comment "Identifier of STOP POINT of a stop at which VEHICLE JOURNEY meets for interchange If blank, same stop as destination." ;
    siri:isReference true ;
    siri:xsdType "StopPointRefStructure" .

siri:journeyCondition a owl:DatatypeProperty ;
    rdfs:label "JourneyCondition" ;
    rdfs:comment "Status of service for this Vehicle Journey - TPEG value. Multiple Conditions can be valid at the same time. (since SIRI 2.0)" ;
    siri:xsdType "ServiceConditionEnumeration" .

siri:journeyName a owl:ObjectProperty ;
    rdfs:label "JourneyName" ;
    rdfs:comment "Name of journey affected by a SITUATION. (Unbounded since SIRI 2.0)" ;
    siri:xsdType "NaturalLanguageStringStructure" .

siri:journeyParts a owl:DatatypeProperty ;
    rdfs:label "JourneyParts" ;
    rdfs:comment "JOURNEY PARTs making up JOURNEY +SIRIv2.0 e." .

siri:journeyPlanner a owl:DatatypeProperty ;
    rdfs:label "JourneyPlanner" ;
    rdfs:comment "Whether information about parts of the NETWORK identified by AffectsScope should be blocked from the Journey Planner. Default is false; do not suppress." ;
    siri:xsdType "xsd:boolean" .

siri:label a owl:ObjectProperty ;
    rdfs:label "Label" ;
    rdfs:comment "Label for Link. (Unbounded since SIRI 2.0)" ;
    siri:xsdType "NaturalLanguageStringStructure" .

siri:linePermissions a owl:DatatypeProperty ;
    rdfs:label "LinePermissions" .

siri:linkContent a owl:DatatypeProperty ;
    rdfs:label "LinkContent" ;
    rdfs:comment "Categorisation of link content." ;
    siri:xsdType "LinkContentEnumeration" .

siri:linkDirection a owl:DatatypeProperty ;
    rdfs:label "LinkDirection" ;
    rdfs:comment "Description of a DIRECTION of CONNECTION link." ;
    siri:xsdType "xsd:string" .

siri:linkName a owl:ObjectProperty ;
    rdfs:label "LinkName" ;
    rdfs:comment "Description of Link. (Unbounded since SIRI 2.0)" ;
    siri:xsdType "NaturalLanguageStringStructure" .

siri:linkRef a owl:ObjectProperty ;
    rdfs:label "LinkRef" ;
    rdfs:comment "Identifier of CONNECTION link." ;
    siri:isReference true ;
    siri:xsdType "xsd:NMTOKEN" .

siri:management a owl:ObjectProperty ;
    rdfs:label "management" ;
    siri:xsdType "D2LogicalModel:Management" .

siri:maximumNumberOfSituationElements a owl:DatatypeProperty ;
    rdfs:label "MaximumNumberOfSituationElements" ;
    rdfs:comment "The maximum number of SITUATION elements to return in a given delivery. The most recent n Events within the look ahead window are included." ;
    siri:xsdType "xsd:positiveInteger" .

siri:mode a owl:DatatypeProperty ;
    rdfs:label "Mode" ;
    rdfs:comment "Mode affected by SITUATION." .

siri:network a owl:ObjectProperty ;
    rdfs:label "Network" ;
    rdfs:comment "Default Network of affected LINEs. These values apply to all SITUATIONs unless overridden on individual instances." ;
    siri:xsdType "NetworkStructure" .

siri:networkContext a owl:ObjectProperty ;
    rdfs:label "NetworkContext" ;
    rdfs:comment "Default context for common properties of Public Transport SITUATIONs." ;
    siri:xsdType "NetworkContextStructure" .

siri:networks a owl:DatatypeProperty ;
    rdfs:label "Networks" ;
    rdfs:comment "Networks affected by SITUATION." .

siri:nonGeneralPublicComment a owl:ObjectProperty ;
    rdfs:label "nonGeneralPublicComment" ;
    rdfs:comment "Ccomments not for public use." ;
    siri:xsdType "D2LogicalModel:Comment" .

siri:numberOfDeaths a owl:DatatypeProperty ;
    rdfs:label "NumberOfDeaths" ;
    rdfs:comment "Number of fatalities." ;
    siri:xsdType "xsd:nonNegativeInteger" .

siri:numberOfInjured a owl:DatatypeProperty ;
    rdfs:label "NumberOfInjured" ;
    rdfs:comment "Number of injured presons." ;
    siri:xsdType "xsd:nonNegativeInteger" .

siri:onBoard a owl:DatatypeProperty ;
    rdfs:label "OnBoard" ;
    rdfs:comment "Include onboard displays." ;
    siri:xsdType "xsd:boolean" .

siri:onPlace a owl:DatatypeProperty ;
    rdfs:label "OnPlace" ;
    rdfs:comment "Include in SITUATION lists on station displays." ;
    siri:xsdType "xsd:boolean" .

siri:operatorName a owl:ObjectProperty ;
    rdfs:label "OperatorName" ;
    rdfs:comment "Public Name of OPERATOR. Can be derived from OperatorRef. (Unbounded since SIRI 2.0)" ;
    siri:xsdType "NaturalLanguageStringStructure" .

siri:operatorPermissions a owl:DatatypeProperty ;
    rdfs:label "OperatorPermissions" .

siri:operatorShortName a owl:ObjectProperty ;
    rdfs:label "OperatorShortName" ;
    rdfs:comment "Short Name for OPERATOR. Can be derived from OperatorRef. (Unbounded since SIRI 2.0)" ;
    siri:xsdType "NaturalLanguageStringStructure" .

siri:operators a owl:DatatypeProperty ;
    rdfs:label "Operators" ;
    rdfs:comment "Affected OPERATORs. If absent, taken from context. If present, any OPERATORs stated completely replace those from context." .

siri:order a owl:DatatypeProperty ;
    rdfs:label "Order" ;
    rdfs:comment "Order of visit to stop within JOURNEY PATTERN of journey." ;
    siri:xsdType "xsd:positiveInteger" .

siri:originAimedDepartureTime a owl:DatatypeProperty ;
    rdfs:label "OriginAimedDepartureTime" ;
    rdfs:comment "Timetabled departure tme of journey from Origin." ;
    siri:xsdType "xsd:dateTime" .

siri:originDisplay a owl:ObjectProperty ;
    rdfs:label "OriginDisplay" ;
    rdfs:comment "Origin to show for the VEHICLE at the specific stop (vehicle signage), if different to the Origin Name for the full journey. (since SIRI 2.0)" ;
    siri:xsdType "NaturalLanguageStringStructure" .

siri:originDisplayAtDestination a owl:ObjectProperty ;
    rdfs:label "OriginDisplayAtDestination" ;
    rdfs:comment "DESTINATION name shown for journey at the origin. Can be Used to identify journey for user. (since SIRI 2.0)," ;
    siri:xsdType "NaturalLanguagePlaceNameStructure" .

siri:other a owl:DatatypeProperty ;
    rdfs:label "Other" ;
    rdfs:comment "Other information about source." ;
    siri:xsdType "xsd:string" .

siri:ownerRef a owl:ObjectProperty ;
    rdfs:label "OwnerRef" ;
    rdfs:comment "The organisation which owns this passenger information." ;
    siri:isReference true ;
    siri:xsdType "OrganisationRefStructure" .

siri:pager a owl:DatatypeProperty ;
    rdfs:label "Pager" ;
    rdfs:comment "Pager number of pager to be notified." ;
    siri:xsdType "xsd:NMTOKEN" .

siri:pagerGroupRef a owl:ObjectProperty ;
    rdfs:label "PagerGroupRef" ;
    rdfs:comment "Reference to a pager group to be notified." ;
    siri:isReference true ;
    siri:xsdType "xsd:string" .

siri:passengerInformationAction a owl:DatatypeProperty ;
    rdfs:label "PassengerInformationAction" ;
    rdfs:comment "Description of the whole passenger information of one action." .

siri:period a owl:ObjectProperty ;
    rdfs:label "Period" ;
    rdfs:comment "Period of effect of disruption, if different from that of SITUATION." ;
    siri:xsdType "HalfOpenTimestampOutputRangeStructure" .

siri:perspective a owl:DatatypeProperty ;
    rdfs:label "Perspective" ;
    rdfs:comment "Perspective of the passenger, e.g. general, vehicleJourney, stopPoint." ;
    siri:xsdType "PerspectiveEnumeration" .

siri:phoneNumber a owl:DatatypeProperty ;
    rdfs:label "PhoneNumber" ;
    rdfs:comment "(Mobile) phone number on which the vehicle can be called" ;
    siri:xsdType "PhoneType" .

siri:placeCategory a owl:DatatypeProperty ;
    rdfs:label "PlaceCategory" ;
    rdfs:comment "Category of TOPOGRAPHIC PLACE or SITE." ;
    siri:xsdType "xsd:NMTOKEN" .

siri:places a owl:DatatypeProperty ;
    rdfs:label "Places" ;
    rdfs:comment "Places other than STOP POINTs affected by SITUATION." .

siri:pointProjection a owl:DatatypeProperty ;
    rdfs:label "PointProjection" .

siri:predictability a owl:DatatypeProperty ;
    rdfs:label "Predictability" ;
    rdfs:comment "Whether just planned, unplanned or both SITUATIONs will be returned." ;
    siri:xsdType "PredictabilityEnumeration" .

siri:premium a owl:DatatypeProperty ;
    rdfs:label "Premium" ;
    rdfs:comment "Whether content is flagged as subject to premium charge. Default is 'false'." ;
    siri:xsdType "xsd:boolean" .

siri:previewInterval a owl:DatatypeProperty ;
    rdfs:label "PreviewInterval" ;
    rdfs:comment "Forward duration for which SITUATIONs should be included, that is, only SITUATIONs that start before the end of this window time will be included." ;
    siri:xsdType "PositiveDurationType" .

siri:privateCode a owl:DatatypeProperty ;
    rdfs:label "PrivateCode" ;
    rdfs:comment "Alternative identifier of SITE or TOPOGRAPHIC PLACE" ;
    siri:xsdType "xsd:NMTOKEN" .

siri:privateRef a owl:ObjectProperty ;
    rdfs:label "PrivateRef" ;
    rdfs:comment "Alternative private code of stop." ;
    siri:isReference true ;
    siri:xsdType "xsd:string" .

siri:probabilityOfOccurrence a owl:DatatypeProperty ;
    rdfs:label "probabilityOfOccurrence" ;
    rdfs:comment "An assessment of the degree of likelihood that the reported event will occur." ;
    siri:xsdType "D2LogicalModel:ProbabilityOfOccurrenceEnum" .

siri:productCategoryRef a owl:ObjectProperty ;
    rdfs:label "ProductCategoryRef" ;
    rdfs:comment "Product Classification of VEHICLE JOURNEY- subdivides a transport mode. e.g. express, loacl." ;
    rdfs:range siri:ProductCategory ;
    siri:isReference true ;
    siri:xsdType "ProductCategoryRefStructure" .

siri:prompt a owl:ObjectProperty ;
    rdfs:label "Prompt" ;
    rdfs:comment "Display prompt for presenting action to user. (Unbounded since SIRI 2.0)" ;
    siri:xsdType "NaturalLanguageStringStructure" .

siri:ptSituationContext a owl:ObjectProperty ;
    rdfs:label "PtSituationContext" ;
    rdfs:comment "Default context for common properties of SITUATIONs, Values specified apply to all SITUATIONs unless overridden. Can be used optionally to reduce file bulk." ;
    siri:xsdType "ContextStructure" .

siri:publishingAction a owl:ObjectProperty ;
    rdfs:label "PublishingAction" ;
    rdfs:comment "Description of the whole action to be published. >SIRI 2.0" ;
    siri:xsdType "PublishingActionStructure" .

siri:radioAddress a owl:DatatypeProperty ;
    rdfs:label "RadioAddress" ;
    rdfs:comment "Radio address of the VEHICLE" ;
    siri:xsdType "xsd:NMTOKEN" .

siri:realTime a owl:DatatypeProperty ;
    rdfs:label "RealTime" ;
    rdfs:comment "Whether information about parts of the NETWORK identified by AffectsScope should be blocked from real-time departure info systems. Default is false; do not suppress." ;
    siri:xsdType "xsd:boolean" .

siri:reasonContent a owl:ObjectProperty ;
    rdfs:label "ReasonContent" ;
    rdfs:comment "Content for reason of a passenger information action" ;
    siri:xsdType "ReasonContentStructure" .

siri:reasonText a owl:ObjectProperty ;
    rdfs:label "ReasonText" ;
    rdfs:comment "Reason of passenger information action in a specific language." ;
    siri:xsdType "DefaultedTextStructure" .

siri:recommendationContent a owl:ObjectProperty ;
    rdfs:label "RecommendationContent" ;
    rdfs:comment "Content for n recommendations of a passenger information action. For hiding / sorting descriptions in end devices, a recommendation priority can be set." ;
    siri:xsdType "RecommendationContentStructure" .

siri:recommendationPriority a owl:DatatypeProperty ;
    rdfs:label "RecommendationPriority" ;
    rdfs:comment "Prioritises a recommendation from the information owner's point of view, e.g. usable for sorting or hiding individual recommendations. 1 = highest priority." ;
    siri:xsdType "xsd:positiveInteger" .

siri:recommendationText a owl:ObjectProperty ;
    rdfs:label "RecommendationText" ;
    rdfs:comment "Recommendation of passenger information action in a specific language." ;
    siri:xsdType "DefaultedTextStructure" .

siri:recordedAtTime a owl:DatatypeProperty ;
    rdfs:label "RecordedAtTime" ;
    rdfs:comment "The time of the last update. This must be the timestamp of the original data source and not that of an intermediate system, such as a data hub. This timestamp has to be changed by the source system with every update." ;
    siri:xsdType "xsd:dateTime" .

siri:referencePointIdentifier a owl:DatatypeProperty ;
    rdfs:label "referencePointIdentifier" ;
    rdfs:comment "Road reference POINT identifier, unique on the specified road." ;
    siri:xsdType "D2LogicalModel:String" .

siri:references a owl:ObjectProperty ;
    rdfs:label "References" ;
    rdfs:comment "Associations with other SITUATIONs." ;
    siri:xsdType "ReferencesStructure" .

siri:relatedAs a owl:DatatypeProperty ;
    rdfs:label "RelatedAs" ;
    rdfs:comment "Relationship of refercence to the referncing SITUATION e." ;
    siri:xsdType "RelatedToEnumeration" .

siri:relatedToRef a owl:ObjectProperty ;
    rdfs:label "RelatedToRef" ;
    rdfs:comment "A reference to another SITUATION with an indication of the nature of the association, e.g. a cause, a result, an update. Note that a Entry that is an update, i.e. has the same IdentifierNumber but a later version number as a previous Entry alway has a supercedes relationship and this does not need to be expliciitly coded." ;
    siri:isReference true ;
    siri:xsdType "RelatedSituationStructure" .

siri:remark a owl:ObjectProperty ;
    rdfs:label "Remark" ;
    rdfs:comment "Further remark to passengers, e,g, \"For more information call xy\"." ;
    siri:xsdType "DefaultedTextStructure" .

siri:remarkContent a owl:ObjectProperty ;
    rdfs:label "RemarkContent" ;
    rdfs:comment "Content for n remarks of a passenger information action, e,g, \"For more information call xy\". For hiding / sorting descriptions in end devices, a remark priority can be set." ;
    siri:xsdType "RemarkContentStructure" .

siri:remarkPriority a owl:DatatypeProperty ;
    rdfs:label "RemarkPriority" ;
    rdfs:comment "Prioritises a remark from the information owner's point of view, e.g. usable for sorting or hiding individual remarks. 1 = highest priority." ;
    siri:xsdType "xsd:positiveInteger" .

siri:requestPolicy a owl:DatatypeProperty ;
    rdfs:label "RequestPolicy" ;
    rdfs:comment "Request Policy capabilities." .

siri:requestStop a owl:DatatypeProperty ;
    rdfs:label "RequestStop" ;
    rdfs:comment "Whether Vehicle stops only if requested explicitly by passenger. Default is 'false'." ;
    siri:xsdType "xsd:boolean" .

siri:responseFeatures a owl:DatatypeProperty ;
    rdfs:label "ResponseFeatures" ;
    rdfs:comment "Optional Response capabilities." .

siri:road a owl:ObjectProperty ;
    rdfs:label "Road" ;
    rdfs:comment "Affected Road as described by a Datex 2 location." ;
    siri:xsdType "D2LogicalModel:RoadsideReferencePointLinear" .

siri:roadNumber a owl:DatatypeProperty ;
    rdfs:label "roadNumber" ;
    rdfs:comment "Identifier or number of the road on which the reference POINT is located." ;
    siri:xsdType "D2LogicalModel:String" .

siri:roads a owl:ObjectProperty ;
    rdfs:label "Roads" ;
    rdfs:comment "Roads affected by." ;
    siri:xsdType "AffectedRoadsStructure" .

siri:route a owl:ObjectProperty ;
    rdfs:label "Route" ;
    rdfs:comment "ROUTE affected by the SITUATION." ;
    siri:xsdType "AffectedRouteStructure" .

siri:routeLinks a owl:DatatypeProperty ;
    rdfs:label "RouteLinks" ;
    rdfs:comment "ROUTE LINKs affected by SITUATION." .

siri:routeRef a owl:ObjectProperty ;
    rdfs:label "RouteRef" ;
    rdfs:comment "Reference to a ROUTE affected by SITUATION." ;
    siri:isReference true ;
    siri:xsdType "RouteRefStructure" .

siri:routes a owl:DatatypeProperty ;
    rdfs:label "Routes" ;
    rdfs:comment "Restricts the affected scope to the specified ROUTEs" .

siri:routesAffected a owl:ObjectProperty ;
    rdfs:label "RoutesAffected" ;
    rdfs:comment "Textual description of overall routes affected. Should correspond to any structured description in the AffectedLines element. (Unbounded since SIRI 2.0)" ;
    siri:xsdType "NaturalLanguageStringStructure" .

siri:scope a owl:DatatypeProperty ;
    rdfs:label "Scope" ;
    rdfs:comment "Types of SITUATION to include." ;
    siri:xsdType "ScopeTypeEnumeration" .

siri:sectionRef a owl:ObjectProperty ;
    rdfs:label "SectionRef" ;
    rdfs:comment "Reference to a section of ROUTE affected by a SITUATION." ;
    siri:isReference true ;
    siri:xsdType "SectionRefStructure" .

siri:selectedRoutes a owl:ObjectProperty ;
    rdfs:label "SelectedRoutes" ;
    rdfs:comment "Only some ROUTEs are affected, LINE level information not available. See the RoutesAffected element for textual description." ;
    siri:xsdType "AffectedRouteStructure" .

siri:serviceFeatureRef a owl:ObjectProperty ;
    rdfs:label "ServiceFeatureRef" ;
    rdfs:comment "Classification of service into arbitrary Service categories, e.g. school bus. Recommended SIRI values based on TPEG are given in SIRI documentation and enumerated in the siri_facilities package. Corresponds to NeTEX TYPE OF SERVICe." ;
    rdfs:range siri:ServiceFeature ;
    siri:isReference true .

siri:situationExchangeDelivery a owl:DatatypeProperty ;
    rdfs:label "SituationExchangeDelivery" ;
    rdfs:comment "Delivery for Vehicle Activity Service." .

siri:situationExchangePermissions a owl:DatatypeProperty ;
    rdfs:label "SituationExchangePermissions" .

siri:situationExchangeRequest a owl:DatatypeProperty ;
    rdfs:label "SituationExchangeRequest" .

siri:situationExchangeServiceCapabilities a owl:DatatypeProperty ;
    rdfs:label "SituationExchangeServiceCapabilities" .

siri:situationFullRef a owl:ObjectProperty ;
    rdfs:label "SituationFullRef" ;
    rdfs:comment "Reference to a SITUATION. Elements of SITUATION identfier are expressed as atomic elements." ;
    siri:isReference true .

siri:situationRecord a owl:ObjectProperty ;
    rdfs:label "SituationRecord" ;
    rdfs:comment "Datex2 SITUATION Record." ;
    siri:xsdType "D2LogicalModel:SituationRecord" .

siri:situationRecordCreationReference a owl:DatatypeProperty ;
    rdfs:label "situationRecordCreationReference" ;
    rdfs:comment "A unique alphanumeric reference (either an external reference or GUID) of the SITUATIONRecord object (the first version of the record) that was created by the original supplier." ;
    siri:xsdType "D2LogicalModel:String" .

siri:situationRecordCreationTime a owl:DatatypeProperty ;
    rdfs:label "situationRecordCreationTime" ;
    rdfs:comment "The date/time that the SITUATION Record object (the first version of the record) was created by the original supplier." ;
    siri:xsdType "D2LogicalModel:DateTime" .

siri:situationRecordExtension a owl:ObjectProperty ;
    rdfs:label "situationRecordExtension" ;
    siri:xsdType "D2LogicalModel:ExtensionType" .

siri:situationRecordFirstSupplierVersionTime a owl:DatatypeProperty ;
    rdfs:label "situationRecordFirstSupplierVersionTime" ;
    rdfs:comment "The date/time that the current version of the SITUATION Record was written into the database of the original supplier in the supply chain." ;
    siri:xsdType "D2LogicalModel:DateTime" .

siri:situationRecordObservationTime a owl:DatatypeProperty ;
    rdfs:label "situationRecordObservationTime" ;
    rdfs:comment "The date/time that the information represented by the current version of the SITUATIONRecord was observed by the original (potentially external) source of the information." ;
    siri:xsdType "D2LogicalModel:DateTime" .

siri:situationRecordVersion a owl:DatatypeProperty ;
    rdfs:label "situationRecordVersion" ;
    rdfs:comment "Each record within a SITUATION may iterate through a series of versions during its life time. The SITUATION record version uniquely identifies the version of a particular record within a SITUATION. It is generated and used by systems external to DATEX 2." ;
    siri:xsdType "D2LogicalModel:NonNegativeInteger" .

siri:situationRecordVersionTime a owl:DatatypeProperty ;
    rdfs:label "situationRecordVersionTime" ;
    rdfs:comment "The date/time that this current version of the SITUATION Record was written into the database of the supplier which is involved in the data exchange." ;
    siri:xsdType "D2LogicalModel:DateTime" .

siri:situationRoadFilter a owl:DatatypeProperty ;
    rdfs:label "SituationRoadFilter" ;
    rdfs:comment "Parameters to filter Situation Exchange Service requests, based on the SITUATION Road. Logically ANDed with other values." .

siri:situationSimpleRef a owl:ObjectProperty ;
    rdfs:label "SituationSimpleRef" ;
    siri:isReference true .

siri:situations a owl:DatatypeProperty ;
    rdfs:label "Situations" ;
    rdfs:comment "SITUATIONs in Delivery." .

siri:socialNetwork a owl:DatatypeProperty ;
    rdfs:label "SocialNetwork" ;
    rdfs:comment "Include in social NETWORK indicated by this name. Possible value could be \"twitter.com\", \"facebook.com\", \"vk.com\" and so on. Parameters may be specified as Action data. (SIRI 2.1)" ;
    siri:xsdType "xsd:normalizedString" .

siri:sourceFile a owl:DatatypeProperty ;
    rdfs:label "SourceFile" ;
    rdfs:comment "Electronic file / attachment containing information about SITUATION." ;
    siri:xsdType "xsd:anyURI" .

siri:sourceMethod a owl:DatatypeProperty ;
    rdfs:label "SourceMethod" ;
    rdfs:comment "Nature of method used to get Source." ;
    siri:xsdType "D2LogicalModel:SourceTypeEnum" .

siri:sourceRef a owl:ObjectProperty ;
    rdfs:label "SourceRef" ;
    rdfs:comment "The system which created this passenger information. If absent, the same system as the PtSituationElement.ParticipantRef." ;
    rdfs:range siri:Source ;
    siri:isReference true ;
    siri:xsdType "ParticipantRefStructure" .

siri:sourceRole a owl:DatatypeProperty ;
    rdfs:label "SourceRole" ;
    rdfs:comment "Job title of Source." ;
    siri:xsdType "xsd:string" .

siri:sourceType a owl:DatatypeProperty ;
    rdfs:label "SourceType" ;
    rdfs:comment "Nature of Source." ;
    siri:xsdType "SituationSourceTypeEnumeration" .

siri:startStopPointRef a owl:ObjectProperty ;
    rdfs:label "StartStopPointRef" ;
    rdfs:comment "Identifier of stop point at which availability first applies." ;
    siri:isReference true ;
    siri:xsdType "StopPointRefStructure" .

siri:startTime a owl:DatatypeProperty ;
    rdfs:label "StartTime" ;
    rdfs:comment "Start time for selecting SITUATIONs to be sent. Only SITUATIONs or updates created after this time will be sent. This enables a restart without resending everything." ;
    siri:xsdType "xsd:dateTime" .

siri:stopCondition a owl:DatatypeProperty ;
    rdfs:label "StopCondition" ;
    rdfs:comment "Status of STOP" ;
    siri:xsdType "RoutePointTypeEnumeration" .

siri:stopPlaceComponentRef a owl:ObjectProperty ;
    rdfs:label "StopPlaceComponentRef" ;
    rdfs:comment "Reference to part of a STOP PLACE. (since SIRI 2.0)" ;
    siri:isReference true ;
    siri:xsdType "ifopt:StopPlaceSpaceRefStructure" .

siri:stopPlaceName a owl:ObjectProperty ;
    rdfs:label "StopPlaceName" ;
    rdfs:comment "Name of STOP PLACE related to this affected StopPoint. (Unbounded to allow a text for every language)" ;
    siri:xsdType "NaturalLanguageStringStructure" .

siri:stopPlaceType a owl:DatatypeProperty ;
    rdfs:label "StopPlaceType" ;
    rdfs:comment "Type of STOP PLACE." ;
    siri:xsdType "StopPlaceTypeEnumeration" .

siri:stopPointName a owl:ObjectProperty ;
    rdfs:label "StopPointName" ;
    rdfs:comment "Name of SCHEDULED STOP POINT. (Unbounded since SIRI 2.0)" ;
    siri:xsdType "NaturalLanguageStringStructure" .

siri:stopPointType a owl:DatatypeProperty ;
    rdfs:label "StopPointType" ;
    rdfs:comment "Type of stop type. Normally implicit in VEHICLE mode. TPEG table pti 17_4" ;
    siri:xsdType "StopPointTypeEnumeration" .

siri:subscriptionPolicy a owl:ObjectProperty ;
    rdfs:label "SubscriptionPolicy" ;
    rdfs:comment "Subscription Policy capabilities." ;
    siri:xsdType "CapabilitySubscriptionPolicyStructure" .

siri:suitabilities a owl:DatatypeProperty ;
    rdfs:label "Suitabilities" ;
    rdfs:comment "Effect on different passenger needs." .

siri:summaryContent a owl:ObjectProperty ;
    rdfs:label "SummaryContent" ;
    rdfs:comment "Content for summary of a passenger information action" ;
    siri:xsdType "SummaryContentStructure" .

siri:summaryText a owl:ObjectProperty ;
    rdfs:label "SummaryText" ;
    rdfs:comment "Summary of passenger information action in a specific language." ;
    siri:xsdType "DefaultedTextStructure" .

siri:teletext a owl:DatatypeProperty ;
    rdfs:label "Teletext" ;
    rdfs:comment "Publish to Teletext. Default is 'true'." ;
    siri:xsdType "xsd:boolean" .

siri:textualContent a owl:ObjectProperty ;
    rdfs:label "TextualContent" ;
    rdfs:comment "The actual, structured passenger information for a specific TextualContentSize." ;
    siri:xsdType "TextualContentStructure" .

siri:textualContentSize a owl:DatatypeProperty ;
    rdfs:label "TextualContentSize" ;
    rdfs:comment "Class of size, e.g. L (large), M (medium), S (small)" ;
    siri:xsdType "xsd:NMTOKENS" .

siri:ticker a owl:DatatypeProperty ;
    rdfs:label "Ticker" ;
    rdfs:comment "Include in moving ticker band. Default is 'false'." ;
    siri:xsdType "xsd:boolean" .

siri:ticketRestrictions a owl:DatatypeProperty ;
    rdfs:label "TicketRestrictions" ;
    rdfs:comment "Ticket restriction conditions in effect. TPEG pti table pti25." ;
    siri:xsdType "TicketRestrictionEnumeration" .

siri:timeOfCommunication a owl:DatatypeProperty ;
    rdfs:label "TimeOfCommunication" ;
    rdfs:comment "Time of communication of message, if different from creation time." ;
    siri:xsdType "xsd:dateTime" .

siri:timingPoint a owl:DatatypeProperty ;
    rdfs:label "TimingPoint" .

siri:topicFiltering a owl:DatatypeProperty ;
    rdfs:label "TopicFiltering" ;
    rdfs:comment "Filtering Capabilities." .

siri:topographicPlaceName a owl:ObjectProperty ;
    rdfs:label "TopographicPlaceName" ;
    rdfs:comment "Name of locality in which SITUATIONs apply. Derivable from LocalityRef. (Unbounded since SIRI 2.0)" ;
    siri:xsdType "NaturalLanguageStringStructure" .

siri:topographicPlaceRef a owl:ObjectProperty ;
    rdfs:label "TopographicPlaceRef" ;
    rdfs:comment "Refrence to a TOPOGRAPHIC PLACE (locality). Also Derivable from an individual StopRef." ;
    siri:isReference true ;
    siri:xsdType "xsd:NMTOKEN" .

siri:trafficElementExtension a owl:ObjectProperty ;
    rdfs:label "trafficElementExtension" ;
    siri:xsdType "D2LogicalModel:ExtensionType" .

siri:trainBlockPart a owl:ObjectProperty ;
    rdfs:label "TrainBlockPart" ;
    rdfs:comment "If a VEHICLE JOURNEY is a coupled journey, i.e. comprises several coupled BLOCK PARTs, there will be a separate delivery for each BLOCK PART and this element will indicate the vehicles that the journey part uses." ;
    siri:xsdType "TrainBlockPartStructure" .

siri:trainNumbers a owl:DatatypeProperty ;
    rdfs:label "TrainNumbers" ;
    rdfs:comment "TRAIN NUMBERs for journey. (since SIRI 2.0)" .

siri:type a owl:DatatypeProperty ;
    rdfs:label "Type" ;
    rdfs:comment "Data type of action data." ;
    siri:xsdType "xsd:NMTOKEN" .

siri:uri a owl:DatatypeProperty ;
    rdfs:label "Uri" ;
    rdfs:comment "URI for link." ;
    siri:xsdType "xsd:anyURI" .

siri:userName a owl:DatatypeProperty ;
    rdfs:label "UserName" ;
    rdfs:comment "Name of user to be notified." ;
    siri:xsdType "xsd:string" .

siri:userRef a owl:ObjectProperty ;
    rdfs:label "UserRef" ;
    rdfs:comment "Reference to a user to be notified." ;
    siri:isReference true ;
    siri:xsdType "xsd:string" .

siri:validity a owl:ObjectProperty ;
    rdfs:label "validity" ;
    siri:xsdType "D2LogicalModel:Validity" .

siri:value a owl:DatatypeProperty ;
    rdfs:label "Value" ;
    rdfs:comment "Value for action." ;
    siri:xsdType "xsd:anyType" .

siri:vehicleAtStop a owl:DatatypeProperty ;
    rdfs:label "VehicleAtStop" .

siri:vehicleFeatureRef a owl:ObjectProperty ;
    rdfs:label "VehicleFeatureRef" ;
    rdfs:comment "Features of VEHICLE providing journey. Recommended SIRI values based on TPEG are given in SIRI documentation and enumerated in the siri_facilities package." ;
    rdfs:range siri:VehicleFeature ;
    siri:isReference true ;
    siri:xsdType "VehicleFeatureRefStructure" .

siri:vehicleJourneys a owl:DatatypeProperty ;
    rdfs:label "VehicleJourneys" ;
    rdfs:comment "Specific journeys affected by SITUATION." .

siri:vehicleLocationAtStop a owl:ObjectProperty ;
    rdfs:label "VehicleLocationAtStop" ;
    rdfs:comment "Exact location that VEHICLE will take up / or has taken at STOP POINT." ;
    siri:xsdType "LocationStructure" .

siri:vehicleRegistrationNumberPlate a owl:DatatypeProperty ;
    rdfs:label "VehicleRegistrationNumberPlate" ;
    rdfs:comment "Registration plate of VEHICLE" ;
    siri:xsdType "xsd:normalizedString" .

siri:vehicles a owl:DatatypeProperty ;
    rdfs:label "Vehicles" ;
    rdfs:comment "Specific vehicles affected by SITUATION. ((since SIRI 2.0))" .

siri:versionCountryRef a owl:ObjectProperty ;
    rdfs:label "VersionCountryRef" ;
    rdfs:comment "Unique identifier of a Country of a Participant who created Update SITUATION element. Provides namespace for VersionParticipant If absent same as." ;
    siri:isReference true ;
    siri:xsdType "ifopt:CountryRefStructure" .

siri:versionedAtTime a owl:DatatypeProperty ;
    rdfs:label "VersionedAtTime" ;
    rdfs:comment "Time at which SITUATION element was versioned. Once versioned, no further changes can be made." ;
    siri:xsdType "xsd:dateTime" .

siri:web a owl:DatatypeProperty ;
    rdfs:label "Web" ;
    rdfs:comment "Information was obtained from a web site URL of site and/or page." ;
    siri:xsdType "xsd:anyURI" .

siri:workgroupRef a owl:ObjectProperty ;
    rdfs:label "WorkgroupRef" ;
    rdfs:comment "Workgroup of user to be notified." ;
    siri:isReference true ;
    siri:xsdType "xsd:string" .

siri:zoneProjection a owl:DatatypeProperty ;
    rdfs:label "ZoneProjection" .

siri:AffectedStopPlaceElementStructure a owl:Class ;
    rdfs:label "AffectedStopPlaceElement" ;
    rdfs:comment "Type for information about the quays affected by an SITUATION." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:accessibilityAssessment ;
            siri:xsdSequenceOrder 1 ] .

siri:SituationElementStructure a owl:Class ;
    rdfs:label "SituationElement" ;
    rdfs:comment "Type for loggable Entry." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:references ;
            siri:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:source ;
            siri:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:versionedAtTime ;
            siri:xsdSequenceOrder 3 ],
        siri:AbstractSituationElementStructure .

siri:SituationExchangeDeliveryStructure a owl:Class ;
    rdfs:label "SituationExchangeDelivery" ;
    rdfs:comment "Type for Delivery for Situation Exchange Service. Provides information about one or more vehicles; each has its own VEHICLE activity element." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:ptSituationContext ;
            siri:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:situations ;
            siri:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:extensions ;
            siri:xsdSequenceOrder 3 ],
        siri:AbstractServiceDeliveryStructure .

siri:affectedFacilities a owl:DatatypeProperty ;
    rdfs:label "AffectedFacilities" ;
    rdfs:comment "Facilities available for VEHICLE JOURNEY (since SIRI 2.0)" .

siri:affectedOperator a owl:ObjectProperty ;
    rdfs:label "AffectedOperator" ;
    rdfs:comment "Operators of LINEs affected by incident. Overrides any value specified for (i) General Context." ;
    siri:xsdType "AffectedOperatorStructure" .

siri:alertCause a owl:DatatypeProperty ;
    rdfs:label "AlertCause" .

siri:allLines a owl:DatatypeProperty ;
    rdfs:label "AllLines" ;
    siri:xsdType "EmptyType" .

siri:arrivalBoardingActivity a owl:DatatypeProperty ;
    rdfs:label "ArrivalBoardingActivity" ;
    rdfs:comment "Type of alighting allowed at stop. Default is 'Alighting'." ;
    siri:xsdType "ArrivalBoardingActivityEnumeration" .

siri:audience a owl:DatatypeProperty ;
    rdfs:label "Audience" ;
    rdfs:comment "Intended audience of SITUATION." ;
    siri:xsdType "AudienceEnumeration" .

siri:blockRef a owl:ObjectProperty ;
    rdfs:label "BlockRef" ;
    rdfs:comment "BLOCK which journey runs. (since SIRI 2.0)" ;
    siri:isReference true ;
    siri:xsdType "BlockRefStructure" .

siri:connectionLinkRef a owl:ObjectProperty ;
    rdfs:label "ConnectionLinkRef" ;
    siri:isReference true .

siri:consequences a owl:ObjectProperty ;
    rdfs:label "Consequences" ;
    rdfs:comment "Structured model describing effect of the SITUATION on PT system." ;
    siri:xsdType "PtConsequencesStructure" .

siri:controlActionRef a owl:ObjectProperty ;
    rdfs:label "ControlActionRef" ;
    rdfs:comment "Reference to a ControlAction being a reason for the situation. It is place in the ReasonGroup to emphasise that the CONTROL ACTION is the reason for the SITUATION, and not the way around: in the opposite case (a SITUATION being the reason for the CONTROL ACTION, some weather condition, or an accident, for example) the CONTROL ACTION will refer the SITUATION. Note that if the ControlAction is the master ControlAction of a GroupOfControlActions it is assumed that the refence is valid for all the ControlActions of the group." ;
    siri:isReference true ;
    siri:xsdType "ControlActionRefStructure" .

siri:creationTime a owl:DatatypeProperty ;
    rdfs:label "CreationTime" ;
    rdfs:comment "Time of creation of SITUATION." ;
    siri:xsdType "xsd:dateTime" .

siri:departureBoardingActivity a owl:DatatypeProperty ;
    rdfs:label "DepartureBoardingActivity" ;
    rdfs:comment "Type of boarding allowed at stop. Default is 'Boarding'." ;
    siri:xsdType "DepartureBoardingActivityEnumeration" .

siri:destinations a owl:ObjectProperty ;
    rdfs:label "Destinations" ;
    rdfs:comment "Restricts the affected scope to the specified DESTINATIONs" ;
    siri:xsdType "AffectedStopPointStructure" .

siri:detail a owl:ObjectProperty ;
    rdfs:label "Detail" ;
    rdfs:comment "Additional descriptive details about the SITUATION (Unbounded since SIRI 2.0)." ;
    siri:xsdType "DefaultedTextStructure" .

siri:direction a owl:ObjectProperty ;
    rdfs:label "Direction" ;
    rdfs:comment "DIRECTIONs affected." ;
    siri:xsdType "DirectionStructure" .

siri:email a owl:DatatypeProperty ;
    rdfs:label "Email" ;
    rdfs:comment "Email of Supplier of information." ;
    siri:xsdType "EmailAddressType" .

siri:environmentReason a owl:DatatypeProperty ;
    rdfs:label "EnvironmentReason" ;
    rdfs:comment "DEPRECATED since SIRI 2.1 - use only AlertCause." .

siri:environmentSubReason a owl:DatatypeProperty ;
    rdfs:label "EnvironmentSubReason" .

siri:equipmentReason a owl:DatatypeProperty ;
    rdfs:label "EquipmentReason" ;
    rdfs:comment "DEPRECATED since SIRI 2.1 - use only AlertCause." .

siri:equipmentSubReason a owl:DatatypeProperty ;
    rdfs:label "EquipmentSubReason" .

siri:facilityRef a owl:ObjectProperty ;
    rdfs:label "FacilityRef" ;
    siri:isReference true .

siri:homePage a owl:DatatypeProperty ;
    rdfs:label "HomePage" ;
    rdfs:comment "Include on home page on web site. Default is 'false'." ;
    siri:xsdType "xsd:boolean" .

siri:image a owl:ObjectProperty ;
    rdfs:label "Image" ;
    rdfs:comment "Image to use when presenting hyperlink." ;
    siri:xsdType "ImageStructure" .

siri:images a owl:DatatypeProperty ;
    rdfs:label "Images" ;
    rdfs:comment "Any images associated with SITUATION." .

siri:incidents a owl:DatatypeProperty ;
    rdfs:label "Incidents" ;
    rdfs:comment "Include in SITUATION lists on web site. Default is 'true'." ;
    siri:xsdType "xsd:boolean" .

siri:infoLinks a owl:DatatypeProperty ;
    rdfs:label "InfoLinks" ;
    rdfs:comment "Hyperlinks to other resources associated with SITUATION." .

siri:interchangeRef a owl:ObjectProperty ;
    rdfs:label "InterchangeRef" ;
    siri:isReference true .

siri:likelihood a owl:DatatypeProperty ;
    rdfs:label "Likelihood" ;
    rdfs:comment "Likellihood of a future situation happening." ;
    siri:xsdType "D2LogicalModel:ProbabilityOfOccurrenceEnum" .

siri:manualAction a owl:DatatypeProperty ;
    rdfs:label "ManualAction" .

siri:miscellaneousReason a owl:DatatypeProperty ;
    rdfs:label "MiscellaneousReason" ;
    rdfs:comment "DEPRECATED since SIRI 2.1 - use only AlertCause." .

siri:miscellaneousSubReason a owl:DatatypeProperty ;
    rdfs:label "MiscellaneousSubReason" .

siri:name a owl:ObjectProperty ;
    rdfs:label "Name" ;
    rdfs:comment "Name of Source." ;
    siri:xsdType "NaturalLanguageStringStructure" .

siri:networkName a owl:ObjectProperty ;
    rdfs:label "NetworkName" ;
    rdfs:comment "Name of NETWORK. Can be derived from NetworkRef. (Unbounded since SIRI 2.0)" ;
    siri:xsdType "NaturalLanguageStringStructure" .

siri:notifyByEmailAction a owl:DatatypeProperty ;
    rdfs:label "NotifyByEmailAction" .

siri:notifyByPagerAction a owl:DatatypeProperty ;
    rdfs:label "NotifyByPagerAction" .

siri:notifyBySmsAction a owl:DatatypeProperty ;
    rdfs:label "NotifyBySmsAction" .

siri:notifyUserAction a owl:DatatypeProperty ;
    rdfs:label "NotifyUserAction" .

siri:operationalUnitRef a owl:ObjectProperty ;
    rdfs:label "OperationalUnitRef" ;
    rdfs:comment "OPERATIONAL UNIT responsible for managing services." ;
    siri:isReference true ;
    siri:xsdType "OperationalUnitRefStructure" .

siri:operator a owl:ObjectProperty ;
    rdfs:label "Operator" ;
    rdfs:comment "Default OPERATOR for SITUATIONs." ;
    siri:xsdType "AffectedOperatorStructure" .

siri:origins a owl:ObjectProperty ;
    rdfs:label "Origins" ;
    rdfs:comment "Restricts the affected scope to the specified origins" ;
    siri:xsdType "AffectedStopPointStructure" .

siri:personnelReason a owl:DatatypeProperty ;
    rdfs:label "PersonnelReason" ;
    rdfs:comment "DEPRECATED since SIRI 2.1 - use only AlertCause." .

siri:personnelSubReason a owl:DatatypeProperty ;
    rdfs:label "PersonnelSubReason" .

siri:phone a owl:DatatypeProperty ;
    rdfs:label "Phone" ;
    rdfs:comment "Phone number of Supplier of information." ;
    siri:xsdType "PhoneType" .

siri:planned a owl:DatatypeProperty ;
    rdfs:label "Planned" ;
    rdfs:comment "Whether the SITUATION was planned (e.g. engineering works) or unplanned (e.g. service alteration). Default is 'false', i.e. unplanned." ;
    siri:xsdType "xsd:boolean" .

siri:priority a owl:DatatypeProperty ;
    rdfs:label "Priority" ;
    rdfs:comment "Arbitrary rating of priority 1-High." ;
    siri:xsdType "xsd:nonNegativeInteger" .

siri:publicEventReason a owl:DatatypeProperty ;
    rdfs:label "PublicEventReason" ;
    rdfs:comment "Structured classification of Public Event, from which a standardized message can be generated." ;
    siri:xsdType "D2LogicalModel:PublicEventTypeEnum" .

siri:publication a owl:DatatypeProperty ;
    rdfs:label "Publication" ;
    rdfs:comment "Publishing status one of a specified set of substates to which a SITUATION can be assigned." ;
    siri:xsdType "PublicationStatusType" .

siri:publishAtScope a owl:DatatypeProperty ;
    rdfs:label "PublishAtScope" ;
    rdfs:comment "Defines the information area where the action has to be published." .

siri:publishToAlertsAction a owl:DatatypeProperty ;
    rdfs:label "PublishToAlertsAction" .

siri:publishToDisplayAction a owl:DatatypeProperty ;
    rdfs:label "PublishToDisplayAction" .

siri:publishToMobileAction a owl:DatatypeProperty ;
    rdfs:label "PublishToMobileAction" .

siri:publishToTvAction a owl:DatatypeProperty ;
    rdfs:label "PublishToTvAction" .

siri:publishToWebAction a owl:DatatypeProperty ;
    rdfs:label "PublishToWebAction" .

siri:publishingActions a owl:ObjectProperty ;
    rdfs:label "PublishingActions" ;
    rdfs:comment "Structured model describing distribution actions to handle SITUATION. Any actions stated completely replace those from Context. If no actions are stated, any actions from general Context are used." ;
    siri:xsdType "ActionsStructure" .

siri:qualityIndex a owl:DatatypeProperty ;
    rdfs:label "QualityIndex" ;
    rdfs:comment "Assessement of likely correctness of data. Default is reliable" ;
    siri:xsdType "QualityIndexEnumeration" .

siri:reasonName a owl:ObjectProperty ;
    rdfs:label "ReasonName" ;
    rdfs:comment "Textual classification of nature of SITUATION, from which a standardized message can be generated. Not normally needed, except when TpegReason and PublicEventReason are absent. (Unbounded since SIRI 2.0)" ;
    siri:xsdType "NaturalLanguageStringStructure" .

siri:repetitions a owl:DatatypeProperty ;
    rdfs:label "Repetitions" ;
    rdfs:comment "Situation applies only on the repeated day types within the overall validity period(s). For example, Sunday." .

siri:reportType a owl:DatatypeProperty ;
    rdfs:label "ReportType" .

siri:scopeType a owl:DatatypeProperty ;
    rdfs:label "ScopeType" ;
    rdfs:comment "Nature of scope, e.g. general, network." .

siri:secondaryReasons a owl:DatatypeProperty ;
    rdfs:label "SecondaryReasons" ;
    rdfs:comment "Additional reasons" .

siri:sections a owl:DatatypeProperty ;
    rdfs:label "Sections" ;
    rdfs:comment "Restricts the affected scope to the specified LINE SECTIONs" .

siri:sensitivity a owl:DatatypeProperty ;
    rdfs:label "Sensitivity" ;
    rdfs:comment "Confidentiality of SITUATION." ;
    siri:xsdType "SensitivityEnumeration" .

siri:source a owl:ObjectProperty ;
    rdfs:label "Source" ;
    rdfs:comment "Information about source of information, that is, where the agent using the capture client obtained an item of information, or in the case of an automated feed, an identifier of the specific feed. Can be used to obtain updates, verify details or otherwise assess relevance." ;
    siri:xsdType "SituationSourceStructure" .

siri:stopPlaces a owl:DatatypeProperty ;
    rdfs:label "StopPlaces" ;
    rdfs:comment "Places other than STOP POINTs affected by SITUATION." .

siri:stopPointRef a owl:ObjectProperty ;
    rdfs:label "StopPointRef" ;
    siri:isReference true .

siri:summary a owl:ObjectProperty ;
    rdfs:label "Summary" ;
    rdfs:comment "Summary of SITUATION. If absent should be generated from structure elements, and/or by condensing Description. (Unbounded since SIRI 2.0)" ;
    siri:xsdType "DefaultedTextStructure" .

siri:undefinedReason a owl:DatatypeProperty ;
    rdfs:label "UndefinedReason" ;
    rdfs:comment "DEPRECATED since SIRI 2.1 - use only AlertCause." .

siri:unknownReason a owl:DatatypeProperty ;
    rdfs:label "UnknownReason" ;
    rdfs:comment "DEPRECATED since SIRI 2.1 - use only AlertCause." .

siri:vehicleJourneyRef a owl:ObjectProperty ;
    rdfs:label "VehicleJourneyRef" ;
    siri:isReference true .

siri:vehicleRef a owl:ObjectProperty ;
    rdfs:label "VehicleRef" ;
    rdfs:range siri:Vehicle ;
    siri:isReference true .

siri:accessMode a owl:DatatypeProperty ;
    rdfs:label "AccessMode" ;
    siri:xsdType "ifopt:AccessModesEnumeration" .

siri:advice a owl:ObjectProperty ;
    rdfs:label "Advice" ;
    rdfs:comment "Further advice to passengers. (Unbounded since SIRI 2.0)" ;
    siri:xsdType "DefaultedTextStructure" .

siri:affects a owl:ObjectProperty ;
    rdfs:label "Affects" ;
    rdfs:comment "Structured model identifiying parts of transport network affected by SITUATION. OPERATOR and NETWORK values will be defaulted to values in general Context unless explicitly overridden." ;
    siri:xsdType "AffectsScopeStructure" .

siri:airSubmode a owl:DatatypeProperty ;
    rdfs:label "AirSubmode" .

siri:busSubmode a owl:DatatypeProperty ;
    rdfs:label "BusSubmode" .

siri:coachSubmode a owl:DatatypeProperty ;
    rdfs:label "CoachSubmode" .

siri:description a owl:ObjectProperty ;
    rdfs:label "Description" ;
    rdfs:comment "Description of SITUATION. Should not repeat any strap line included in Summary. (Unbounded since SIRI 2.0)" ;
    siri:xsdType "DefaultedTextStructure" .

siri:framedVehicleJourneyRef a owl:ObjectProperty ;
    rdfs:label "FramedVehicleJourneyRef" ;
    rdfs:comment "Refercence to a VEHICLE JOURNEY framed by the day. SIRI 2.0" ;
    siri:isReference true ;
    siri:xsdType "FramedVehicleJourneyRefStructure" .

siri:internal a owl:ObjectProperty ;
    rdfs:label "Internal" ;
    rdfs:comment "For internal information only, not passenger relevant" ;
    siri:xsdType "DefaultedTextStructure" .

siri:keywords a owl:DatatypeProperty ;
    rdfs:label "Keywords" ;
    rdfs:comment "Arbitrary application specific classifiers. Only SITUATIONs that match these keywords will be returned." ;
    siri:xsdType "xsd:NMTOKENS" .

siri:language a owl:DatatypeProperty ;
    rdfs:label "Language" ;
    rdfs:comment "Preferred languages in which to return text values." ;
    siri:xsdType "xsd:language" .

siri:lines a owl:DatatypeProperty ;
    rdfs:label "Lines" ;
    rdfs:comment "Filter the results to include only situations along the given LINEs." .

siri:metroSubmode a owl:DatatypeProperty ;
    rdfs:label "MetroSubmode" .

siri:networkRef a owl:ObjectProperty ;
    rdfs:label "NetworkRef" ;
    rdfs:comment "Reference to a NETWORK." ;
    siri:isReference true ;
    siri:xsdType "OperatorRefStructure" .

siri:operatorRef a owl:ObjectProperty ;
    rdfs:label "OperatorRef" ;
    rdfs:comment "Referance to an OPERATOR. If unspecified, all OPERATOR.s." ;
    siri:isReference true ;
    siri:xsdType "OperatorRefStructure" .

siri:placeName a owl:ObjectProperty ;
    rdfs:label "PlaceName" ;
    rdfs:comment "Name of locality in which stop is found. Derivable from LocalityRef. (Unbounded since SIRI 2.0)" ;
    siri:xsdType "NaturalLanguageStringStructure" .

siri:placeRef a owl:ObjectProperty ;
    rdfs:label "PlaceRef" ;
    rdfs:comment "Reference to a TOPOGRAPHIC PLACE. Only incidents which are deemed to affect this place will be returned." ;
    siri:isReference true ;
    siri:xsdType "xsd:NMTOKEN" .

siri:progress a owl:DatatypeProperty ;
    rdfs:label "Progress" ;
    rdfs:comment "Workflow Progress Status. One of a specified set of overall processing states assigned to SITUATION. For example, 'Draft' for not yet published; 'Published' for live SITUATIONs; 'Closed' indicates a completed SITUATION. If not specified return open, published closing and closed. l." ;
    siri:xsdType "WorkflowStatusEnumeration" .

siri:publicationWindow a owl:ObjectProperty ;
    rdfs:label "PublicationWindow" ;
    rdfs:comment "Publication Window for SITUATION if different from validity period." ;
    siri:xsdType "HalfOpenTimestampOutputRangeStructure" .

siri:publishedLineName a owl:DatatypeProperty ;
    rdfs:label "PublishedLineName" .

siri:railSubmode a owl:DatatypeProperty ;
    rdfs:label "RailSubmode" .

siri:reality a owl:DatatypeProperty ;
    rdfs:label "Reality" ;
    rdfs:comment "Whether SITUATION is real or a test. If not specified return all." ;
    siri:xsdType "D2LogicalModel:InformationStatusEnum" .

siri:stopPlaceRef a owl:ObjectProperty ;
    rdfs:label "StopPlaceRef" ;
    rdfs:comment "Reference to a STOP PLACE." ;
    siri:isReference true ;
    siri:xsdType "ifopt:StopPlaceRefStructure" .

siri:stopPoints a owl:DatatypeProperty ;
    rdfs:label "StopPoints" ;
    rdfs:comment "STOP POINTs affected by SITUATION." .

siri:telecabinSubmode a owl:DatatypeProperty ;
    rdfs:label "TelecabinSubmode" .

siri:tramSubmode a owl:DatatypeProperty ;
    rdfs:label "TramSubmode" .

siri:validityPeriod a owl:ObjectProperty ;
    rdfs:label "ValidityPeriod" ;
    rdfs:comment "Temporal scope of Situations be included in response. The Situations must be valid within the specified period of time. (since SIRI 2.0)" ;
    siri:xsdType "HalfOpenTimestampInputRangeStructure" .

siri:vehicleMode a owl:DatatypeProperty ;
    rdfs:label "VehicleMode" .

siri:verification a owl:DatatypeProperty ;
    rdfs:label "Verification" ;
    rdfs:comment "Whether incident has been verified or not If not specified return all." ;
    siri:xsdType "VerificationStatusEnumeration" .

siri:waterSubmode a owl:DatatypeProperty ;
    rdfs:label "WaterSubmode" .

siri:lineRef a owl:ObjectProperty ;
    rdfs:label "LineRef" ;
    rdfs:comment "Filter the results to include only the given line." ;
    siri:isReference true .

siri:linkProjection a owl:ObjectProperty ;
    rdfs:label "LinkProjection" ;
    rdfs:comment "GIs projection of Section. NB Line here means Geometry Polyline, not Transmodel Transport Line." ;
    siri:xsdType "ifopt:LinkProjectionStructure" .

siri:location a owl:ObjectProperty ;
    rdfs:label "Location" ;
    rdfs:comment "Bounding box of an arbitrary area. Only incidents geocoded as falling within area will be included." ;
    siri:xsdType "LocationStructure" .

siri:offset a owl:ObjectProperty ;
    rdfs:label "Offset" ;
    rdfs:comment "Offset from start or end of section to use when projecting." ;
    siri:xsdType "OffsetStructure" .

siri:severity a owl:DatatypeProperty ;
    rdfs:label "Severity" ;
    rdfs:comment "Severity filter value to apply: only SITUATIONs with a severity greater than or equal to the specified value will be returned. See TPEG severities. Default is 'normal'." ;
    siri:xsdType "SeverityEnumeration" .

siri:situationNumber a owl:DatatypeProperty ;
    rdfs:label "SituationNumber" ;
    rdfs:comment "Unique identifier of SITUATION within a Participant. Excludes any version number." .

siri:updateCountryRef a owl:ObjectProperty ;
    rdfs:label "UpdateCountryRef" ;
    rdfs:comment "Unique identifier of a Country of a Participant who created Update SITUATION element. Provides namespace for VersionParticipant If absent same as." ;
    siri:isReference true ;
    siri:xsdType "ifopt:CountryRefStructure" .

siri:updateParticipantRef a owl:ObjectProperty ;
    rdfs:label "UpdateParticipantRef" ;
    rdfs:comment "Unique identifier of a Participant. Provides namespace for SITUATION. If absent provdied from context." ;
    siri:isReference true ;
    siri:xsdType "ParticipantRefStructure" .

siri:PushedActionStructure a owl:Class ;
    rdfs:label "PushedAction" ;
    rdfs:comment "Type for publication action." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:beforeNotices ;
            siri:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:clearNotice ;
            siri:xsdSequenceOrder 2 ],
        siri:ParameterisedActionStructure .

siri:accessibilityAssessment a owl:ObjectProperty ;
    rdfs:label "AccessibilityAssessment" ;
    rdfs:comment "Assessment of current ACCESSIBILITY of the STOP POINT as affected by the SITUATION." ;
    siri:xsdType "acsb:AccessibilityAssessmentStructure" .

siri:countryRef a owl:ObjectProperty ;
    rdfs:label "CountryRef" ;
    rdfs:comment "Unique identifier of a Country of a Participant who created SITUATION. Provides namespace for Participant If absent proided from context." ;
    siri:isReference true ;
    siri:xsdType "ifopt:CountryRefStructure" .

siri:participantRef a owl:ObjectProperty ;
    rdfs:label "ParticipantRef" ;
    rdfs:comment "Unique identifier of a Participant. Provides namespace for SITUATION." ;
    siri:isReference true ;
    siri:xsdType "ParticipantRefStructure" .

siri:version a owl:ObjectProperty ;
    rdfs:label "Version" ;
    rdfs:comment "Unique identifier of update version within a SITUATION Number Omit if reference to the base SITUATION." ;
    siri:xsdType "SituationVersion" .

siri:ParameterisedActionStructure a owl:Class ;
    rdfs:label "ParameterisedAction" ;
    rdfs:comment "Type for parameterised, i.e. user definable, actions." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:description ;
            siri:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:onProperty siri:actionData ;
            siri:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:onProperty siri:publicationWindow ;
            siri:xsdSequenceOrder 3 ],
        siri:SimpleActionStructure .

siri:extensions a owl:DatatypeProperty ;
    rdfs:label "Extensions" .

