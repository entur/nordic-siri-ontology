siri:SituationSourceTypeEnumeration a rdfs:Datatype ;
    rdfs:label "SituationSourceTypeEnumeration" ;
    rdfs:comment "Values for Type of Source." ;
    owl:oneOf ( "directReport" "email" "phone" "fax" "post" "feed" "radio" "tv" "web" "pager" "text" "other" ) .

siri:SituationVersion a owl:Class ;
    rdfs:label "SituationVersion" ;
    rdfs:comment "Type for SITUATION version number if entry is update to a previous version. Unique within IncidentNumber. Monotonically increasing within IncidentNumber. Any values for classification, description, affects, effects that are present in an update replace any values on previous incidents and updates with the same identifier. Values that are not updated remain in effect." .

siri:StopPlaceTypeEnumeration a rdfs:Datatype ;
    rdfs:label "StopPlaceTypeEnumeration" ;
    rdfs:comment "Values for STOP PLACE types - TPEG Pts041 and IFOPT" ;
    owl:oneOf ( "unknown" "railwayStation" "undergroundStation" "tramStation" "busStation" "airport" "pier" "harbourPort" "ferryStop" "lightRailwayStation" "cogwheelStation" "funicularStation" "ropewayStation" "coachStation" "ferryPort" "onStreetBus" "onStreetTram" "skiLift" "other" "undefinedStopPlaceType" "railStation" "metroStation" ) .

