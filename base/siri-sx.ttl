    rdfs:label "ReportTypeEnumeration" ;
    rdfs:comment "Values for TPEG Pti27 - ReportType" ;
    owl:oneOf ( "unknown" "incident" "general" "operator" "network" "stationTerminal" "stopPoint" "connectionLink" "point" "route" "individualService" "undefined" ) .

siri:RoadFilterStructure a owl:Class ;
    rdfs:label "RoadFilter" ;
    rdfs:comment "Type for Parameters to filter Situation Exchange Service requests, based on the SITUATION Road, Logically ANDed with other values." ;
