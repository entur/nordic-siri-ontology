    rdfs:subClassOf siri:RoadSituationElementStructure ;
    siri:xsdElement true .

siri:RoutePointTypeEnumeration a rdfs:Datatype ;
    rdfs:label "RoutePointTypeEnumeration" ;
    rdfs:comment "Values for ROUTE POINT type that correspond to TPEG Pts44: StopPlaceUsage (Pti15: deprecated since SIRI 2.1)." ;
    owl:oneOf ( "unknown" "origin" "destination" "intermediate" "legBoard" "legIntermediate" "legAlight" "firstRoutePoint" "lastRoutePoint" "affectedStopplace" "presentedStopplace" "undefinedStopplaceUsage" "startPoint" "stop" "via" "notStopping" "temporaryStop" "temporarilyNotStopping" "exceptionalStop" "additionalStop" "requestStop" "frontTrainDestination" "rearTrainDestination" "throughServiceDestination" "notVia" "alteredStartPoint" "alteredDestination" "undefinedRoutePoint" ) .

siri:ScopeTypeEnumeration a rdfs:Datatype ;
