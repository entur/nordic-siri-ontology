@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix siri: <https://siri-cen.eu/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

siri:AccessibilityFeatureEnumeration a rdfs:Datatype ;
    rdfs:label "AccessibilityFeatureEnumeration" ;
    rdfs:comment "Values for AccessibilityFeature - TPEG Pts040 and IFOPT" ;
    owl:oneOf ( "unknown" "singleStep" "stairs" "escalator" "travelator" "lift" "ramp" "mindTheGap" "tactilePaving" "seriesOfStairs" "shuttle" "barrier" "narrowEntrance" "confinedSpace" "queueManagement" "none" "other" "undefined" ) .

siri:ActionDataStructure a owl:Class ;
    rdfs:label "ActionData" ;
    rdfs:comment "Type for list of SITUATIONs." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:name ;
            siri:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:type ;
            siri:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:value ;
            siri:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:onProperty siri:prompt ;
            siri:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:publishAtScope ;
            siri:xsdSequenceOrder 5 ] .

siri:ActionStatusEnumeration a rdfs:Datatype ;
    rdfs:label "ActionStatusEnumeration" ;
    rdfs:comment "Values for Progress Status." ;
    owl:oneOf ( "open" "published" "closed" ) .

siri:ActionsStructure a owl:Class ;
    rdfs:label "Actions" ;
    rdfs:comment "Type for list of actions." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty siri:publishToWebAction ;
            siri:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:onProperty siri:notifyUserAction ;
            siri:xsdSequenceOrder 10 ],
        [ a owl:Restriction ;
            owl:onProperty siri:publishingAction ;
            siri:xsdSequenceOrder 11 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:extensions ;
            siri:xsdSequenceOrder 12 ],
        [ a owl:Restriction ;
            owl:onProperty siri:publishToMobileAction ;
            siri:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:onProperty siri:publishToTvAction ;
            siri:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:onProperty siri:publishToAlertsAction ;
            siri:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:onProperty siri:publishToDisplayAction ;
            siri:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            owl:onProperty siri:manualAction ;
            siri:xsdSequenceOrder 6 ],
        [ a owl:Restriction ;
            owl:onProperty siri:notifyByEmailAction ;
            siri:xsdSequenceOrder 7 ],
        [ a owl:Restriction ;
            owl:onProperty siri:notifyBySmsAction ;
            siri:xsdSequenceOrder 8 ],
        [ a owl:Restriction ;
            owl:onProperty siri:notifyByPagerAction ;
            siri:xsdSequenceOrder 9 ] .

siri:AdviceRefStructure a owl:Class ;
    rdfs:label "Advice" ;
    rdfs:comment "Type for reference to predefined advisory NOTICE." .

siri:AdviceTypeEnumeration a rdfs:Datatype ;
    rdfs:label "AdviceTypeEnumeration" ;
    rdfs:comment "Values for TPEG Pts039 - AdviceType, with some additional values" ;
    owl:oneOf ( "unknown" "useReplacementBus" "useReplacementTrain" "useAlternativeRoute" "goOnFoot" "dangerLeaveStation" "noMeansOfTravel" "useDifferentStops" "useAlternativeStop" "dangerDoNotLeaveVehicle" "takeAdviceAnnouncements" "takeAdvicePersonnel" "obeyAdvicePolice" "useOtherPT" "useInterchange" "noAdvice" "undefinedAdvice" "takeDetour" "useAlternativeAccess" ) .

siri:AffectedCallStructure a owl:Class ;
    rdfs:label "AffectedCall" ;
    rdfs:comment "Type for information about a CALL affected by an SITUATION." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:order ;
            siri:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:aimedArrivalTime ;
            siri:xsdSequenceOrder 10 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:actualArrivalTime ;
            siri:xsdSequenceOrder 11 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:expectedArrivalTime ;
            siri:xsdSequenceOrder 12 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:arrivalStatus ;
            siri:xsdSequenceOrder 13 ],
        [ a owl:Restriction ;
            owl:onProperty siri:arrivalPlatformName ;
            siri:xsdSequenceOrder 14 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:arrivalBoardingActivity ;
            siri:xsdSequenceOrder 15 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:aimedDepartureTime ;
            siri:xsdSequenceOrder 16 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:actualDepartureTime ;
            siri:xsdSequenceOrder 17 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:expectedDepartureTime ;
            siri:xsdSequenceOrder 18 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:departureStatus ;
            siri:xsdSequenceOrder 19 ],
        [ a owl:Restriction ;
            owl:onProperty siri:callCondition ;
            siri:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:onProperty siri:departurePlatformName ;
            siri:xsdSequenceOrder 20 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:departureBoardingActivity ;
            siri:xsdSequenceOrder 21 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:aimedHeadwayInterval ;
            siri:xsdSequenceOrder 22 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:expectedHeadwayInterval ;
            siri:xsdSequenceOrder 23 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:affectedInterchanges ;
            siri:xsdSequenceOrder 24 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:vehicleAtStop ;
            siri:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:vehicleLocationAtStop ;
            siri:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:timingPoint ;
            siri:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:boardingStretch ;
            siri:xsdSequenceOrder 6 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:requestStop ;
            siri:xsdSequenceOrder 7 ],
        [ a owl:Restriction ;
            owl:onProperty siri:originDisplay ;
            siri:xsdSequenceOrder 8 ],
        [ a owl:Restriction ;
            owl:onProperty siri:destinationDisplay ;
            siri:xsdSequenceOrder 9 ],
        siri:AffectedStopPointStructure .

siri:AffectedConnectionLinkStructure a owl:Class ;
    rdfs:label "AffectedConnectionLink" ;
    rdfs:comment "Type for a reference Information about a CONNECTION link from a given stop that is affected by a SITUATION." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty siri:connectionLinkRef ;
            siri:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:onProperty siri:affectedPathLink ;
            siri:xsdSequenceOrder 10 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:extensions ;
            siri:xsdSequenceOrder 11 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:connectionName ;
            siri:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:allLines ;
            siri:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:lineRef ;
            siri:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:onProperty siri:publishedLineName ;
            siri:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:connectingStopPointRef ;
            siri:xsdSequenceOrder 6 ],
        [ a owl:Restriction ;
            owl:onProperty siri:connectingStopPointName ;
            siri:xsdSequenceOrder 7 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:connectingZoneRef ;
            siri:xsdSequenceOrder 8 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:connectionDirection ;
            siri:xsdSequenceOrder 9 ] .

siri:AffectedFacilityStructure a owl:Class ;
    rdfs:label "AffectedFacility" ;
    rdfs:comment "Type for information about a FACILITY affected by an SITUATION. (since SIRI 2.0)" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:facilityRef ;
            siri:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:startStopPointRef ;
            siri:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:endStopPointRef ;
            siri:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:onProperty siri:facilityName ;
            siri:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:onProperty siri:facilityStatus ;
            siri:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            owl:onProperty siri:extensions ;
            siri:xsdSequenceOrder 6 ] .

siri:AffectedInterchangeStructure a owl:Class ;
    rdfs:label "AffectedInterchange" ;
    rdfs:comment "Information about a SERVICE JOURNEY INTERCHANGE at CONNECTION link from a given SCHEDULED STOP POINT." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:interchangeRef ;
            siri:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:interchangeStopPointRef ;
            siri:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:onProperty siri:interchangeStopPointName ;
            siri:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:connectingVehicleJourneyRef ;
            siri:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:interchangeStatusType ;
            siri:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            owl:onProperty siri:connectionLink ;
            siri:xsdSequenceOrder 6 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:extensions ;
            siri:xsdSequenceOrder 7 ] .

siri:AffectedLineStructure a owl:Class ;
    rdfs:label "AffectedLine" ;
    rdfs:comment "Information about the individual LINEs in the network that are affected by a SITUATION. If not explicitly overridden, modes and submodes will be defaulted to any values present (i) in the AffectedNetwork (ii) in the general context." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty siri:affectedOperator ;
            siri:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:stopPlaces ;
            siri:xsdSequenceOrder 10 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:extensions ;
            siri:xsdSequenceOrder 11 ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:lineRef ;
            siri:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:onProperty siri:publishedLineName ;
            siri:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:onProperty siri:origins ;
            siri:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:onProperty siri:destinations ;
            siri:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            owl:onProperty siri:direction ;
            siri:xsdSequenceOrder 6 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:routes ;
            siri:xsdSequenceOrder 7 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:sections ;
            siri:xsdSequenceOrder 8 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:stopPoints ;
            siri:xsdSequenceOrder 9 ] .

siri:AffectedModesStructure a owl:Class ;
    rdfs:label "AffectedModes" ;
    rdfs:comment "Type for TRANSPORT MODEs affecetd by a SITUATION." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:allModes ;
            siri:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:onProperty siri:mode ;
            siri:xsdSequenceOrder 2 ] .

siri:AffectedNetworkStructure a owl:Class ;
    rdfs:label "AffectedNetwork" ;
    rdfs:comment "Type for information about the parts of the network affected by an incident. If not explicitly overridden, modes and submodes will be defaulted to any values present in the general context." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty siri:affectedOperator ;
            siri:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:railSubmode ;
            siri:xsdSequenceOrder 10 ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:tramSubmode ;
            siri:xsdSequenceOrder 11 ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:waterSubmode ;
            siri:xsdSequenceOrder 12 ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:telecabinSubmode ;
            siri:xsdSequenceOrder 13 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:accessMode ;
            siri:xsdSequenceOrder 14 ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:allLines ;
            siri:xsdSequenceOrder 15 ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:selectedRoutes ;
            siri:xsdSequenceOrder 16 ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:affectedSection ;
            siri:xsdSequenceOrder 17 ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:affectedLine ;
            siri:xsdSequenceOrder 18 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:extensions ;
            siri:xsdSequenceOrder 19 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:networkRef ;
            siri:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:onProperty siri:networkName ;
            siri:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:onProperty siri:routesAffected ;
            siri:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:vehicleMode ;
            siri:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:airSubmode ;
            siri:xsdSequenceOrder 6 ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:busSubmode ;
            siri:xsdSequenceOrder 7 ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:coachSubmode ;
            siri:xsdSequenceOrder 8 ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:metroSubmode ;
            siri:xsdSequenceOrder 9 ] .

siri:AffectedOperatorStructure a owl:Class ;
    rdfs:label "AffectedOperator" ;
    rdfs:comment "Type for Annotated reference to an OPERATOR affected by a SITUATION." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:operatorRef ;
            siri:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:onProperty siri:operatorName ;
            siri:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:onProperty siri:operatorShortName ;
            siri:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:onProperty siri:operationalUnitRef ;
            siri:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:extensions ;
            siri:xsdSequenceOrder 5 ] .

siri:AffectedPathLinkStructure a owl:Class ;
    rdfs:label "AffectedPathLink" ;
    rdfs:comment "Information about a CONNECTION link from a given stop affected by a SITUATION." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty siri:linkRef ;
            siri:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:onProperty siri:linkName ;
            siri:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:accessibilityFeature ;
            siri:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:onProperty siri:linkDirection ;
            siri:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:linkProjection ;
            siri:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:offset ;
            siri:xsdSequenceOrder 6 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:extensions ;
            siri:xsdSequenceOrder 7 ] .

siri:AffectedPlaceStructure a owl:Class ;
    rdfs:label "AffectedPlace" ;
    rdfs:comment "Type for annotated references to a TOPOGRAPHIC PLACE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:placeRef ;
            siri:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:privateCode ;
            siri:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:onProperty siri:placeName ;
            siri:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:location ;
            siri:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:placeCategory ;
            siri:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            owl:onProperty siri:equipmentRef ;
            siri:xsdSequenceOrder 6 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:accessibilityAssessment ;
            siri:xsdSequenceOrder 7 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:extensions ;
            siri:xsdSequenceOrder 8 ] .

siri:AffectedRoadStructure a owl:Class ;
    rdfs:label "AffectedRoad" ;
    rdfs:comment "Type for Road scope for scope of SITUATION or effect." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:road ;
            siri:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:linkProjection ;
            siri:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:offset ;
            siri:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:extensions ;
            siri:xsdSequenceOrder 4 ] .

siri:AffectedRoadsStructure a owl:Class ;
    rdfs:label "AffectedRoads" ;
    rdfs:comment "Type for Location model for scope of SITUATION or effect." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:datex2Locations ;
            siri:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:onProperty siri:affectedRoad ;
            siri:xsdSequenceOrder 2 ] .

siri:AffectedRouteStructure a owl:Class ;
    rdfs:label "AffectedRoute" ;
    rdfs:comment "An ordered list of MAPPING POINTs defining one single path through the road (or rail) Network. A ROUTE may pass through the same MAPPING POINT more than once." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:routeRef ;
            siri:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:onProperty siri:direction ;
            siri:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:sections ;
            siri:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:stopPoints ;
            siri:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:routeLinks ;
            siri:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:extensions ;
            siri:xsdSequenceOrder 6 ] .

siri:AffectedSectionStructure a owl:Class ;
    rdfs:label "AffectedSection" ;
    rdfs:comment "Type for information about the SECTIONs affected by a SITUATION." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:sectionRef ;
            siri:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:indirectSectionRef ;
            siri:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:linkProjection ;
            siri:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:offset ;
            siri:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:extensions ;
            siri:xsdSequenceOrder 5 ] .

siri:AffectedStopPlaceComponentStructure a owl:Class ;
    rdfs:label "AffectedStopPlaceComponent" ;
    rdfs:comment "Type for information about the quays affected by an SITUATION." ;
