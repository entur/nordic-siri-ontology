siri:AudienceEnumeration a rdfs:Datatype ;
    rdfs:label "AudienceEnumeration" ;
    rdfs:comment "Values for Audience." ;
    owl:oneOf ( "public" "emergencyServices" "staff" "stationStaff" "management" "authorities" "infoServices" "transportOperators" ) .

siri:BlockingStructure a owl:Class ;
    rdfs:label "Blocking" ;
    rdfs:comment "Type for blocking." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
