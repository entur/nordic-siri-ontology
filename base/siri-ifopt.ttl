@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix siri: <https://siri-cen.eu/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

siri:AccessLinkRef a owl:Class ;
    rdfs:label "AccessLinkRef" ;
    rdfs:subClassOf siri:AccessLinkRefStructure ;
    siri:xsdElement true .

siri:AccessModesEnumeration a rdfs:Datatype ;
    rdfs:label "AccessModesEnumeration" ;
    rdfs:comment "Allowed categroies of access to STOP PLACE." ;
    owl:oneOf ( "foot" "bicycle" "car" "taxi" "shuttle" ) .

siri:AccessPathLinkRefStructure a owl:Class ;
    rdfs:label "AccessPathLink" ;
    rdfs:comment "Type for reference to identifier of PATHLINK." ;
    rdfs:subClassOf siri:StopPlaceComponentRefStructure .

siri:AccessSpaceRefStructure a owl:Class ;
    rdfs:label "AccessSpace" ;
    rdfs:comment "Type for reference to ACCESS SPACe." ;
    rdfs:subClassOf siri:StopPlaceSpaceRefStructure .

siri:AccessSpaceTypeEnumeration a rdfs:Datatype ;
    rdfs:label "AccessSpaceTypeEnumeration" ;
    rdfs:comment "Enumeration of ACCESS SPACE Types." ;
    owl:oneOf ( "concours" "bookingHall" "forecourt" "underpass" "overpass" "passage" "passageSection" "gallery" "garage" "shop" "waitingRoom" "restaurant" "other" ) .

siri:AdministrativeAreaRefStructure a owl:Class ;
    rdfs:label "AdministrativeArea" ;
    rdfs:comment "Type for a reference to an ADMINISTRATIVE ZONE." .

siri:AdministrativeAreaRefsStructure a owl:Class ;
    rdfs:label "AdministrativeAreaRefs" ;
    rdfs:comment "Type for a collection of one or more references to ADMINISTRATIVE ZONEs." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:administrativeAreaRef ;
            siri:xsdSequenceOrder 1 ] .

siri:AdministrativeAreaVersionedRefStructure a owl:Class ;
    rdfs:label "AdministrativeAreaVersioned" ;
    rdfs:comment "Type for a versioned reference to anADMINISTRATIVE ZONE." .

siri:AdministrativeRoleTypeEnumeration a rdfs:Datatype ;
    rdfs:label "AdministrativeRoleTypeEnumeration" ;
    rdfs:comment "Enumeration of allowed values for RESPONSIBILITY ROLEs." ;
    owl:oneOf ( "all" "collects" "validates" "aggregates" "distributes" "redistributes" ) .

siri:AdministratorRefStructure a owl:Class ;
    rdfs:label "Administrator" ;
    rdfs:comment "Type for a reference to an ORGANISATION with administrative responsibility." .

siri:AdministratorVersionedRefStructure a owl:Class ;
    rdfs:label "AdministratorVersioned" ;
    rdfs:comment "Type for a versioned reference to an ORGANISATION with administrative responsibility." .

siri:AliasStructure a owl:Class ;
    rdfs:label "Alias" ;
    rdfs:comment "Alternative Private Code." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:privateCode ;
            siri:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:identifierType ;
            siri:xsdSequenceOrder 2 ] .

siri:AuthorityRefStructure a owl:Class ;
    rdfs:label "Authority" ;
    rdfs:comment "Type for a reference to an AUTHORITY." .

siri:BoardingPositionRefStructure a owl:Class ;
    rdfs:label "BoardingPosition" ;
    rdfs:comment "Type for reference to BOARDING POSITION." ;
    rdfs:subClassOf siri:StopPlaceSpaceRefStructure .

siri:BoardingPositionTypeEnumeration a rdfs:Datatype ;
    rdfs:label "BoardingPositionTypeEnumeration" ;
    rdfs:comment "Enumeration of BOARDING POSITION Types." ;
    owl:oneOf ( "unknown" "doorFromAirlineGate" "positionOnRailPlatform" "positionOnMetroPlatform" "positionAtCoachStop" "positionAtBusStop" "boatGangway" "ferryGangway" "telecabinePlatform" "telecabinePlatfrom" "setDownPoint" "taxiBay" "other" ) .

siri:CheckPointProcessEnumeration a rdfs:Datatype ;
    rdfs:label "CheckPointProcessEnumeration" ;
    rdfs:comment "Allowed values for a CHECK CONSTRAINT." ;
    owl:oneOf ( "none" "unknown" "ticketPurchase" "ticketCollection" "ticketValidation" "baggageCheckIn" "oversizeBaggageCheckIn" "oversizeBaggageReclaim" "baggageReclaim" "leftLuggageDeposit" "leftLuggageReclaim" "firstclassCheckin" "specialNeedsCheckin" "baggageSecurityCheck" "securityCheck" "outgoingPassportControl" "incomingPassportControl" "fasttrackDepartures" "fasttrackArrivals" "incomingDutyFree" "outgoingDutyFree" "taxRefunds" "outgoingCustoms" "incomingCustoms" ) .

siri:CheckPointRefStructure a owl:Class ;
    rdfs:label "CheckPoint" ;
    rdfs:comment "Type for reference to am identifier of a hazard within a STOP PLACE." .

siri:CheckPointServiceEnumeration a rdfs:Datatype ;
    rdfs:label "CheckPointServiceEnumeration" ;
    rdfs:comment "Allowed values for a CHECK CONSTRAINT." ;
    owl:oneOf ( "selfserviceMachine" "counterService" "other" ) .

siri:CheckPointStructure a owl:Class ;
    rdfs:label "CheckPoint" ;
    rdfs:comment "Type for a CHECK CONSTRAINT Hazard that can be associated with." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:checkPointId ;
            siri:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:maximumLikelyDelay ;
            siri:xsdSequenceOrder 10 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:validityCondition ;
            siri:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:checkPointProcess ;
            siri:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:checkPointService ;
            siri:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:accessFeatureType ;
            siri:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:congestion ;
            siri:xsdSequenceOrder 6 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:facilityRef ;
            siri:xsdSequenceOrder 7 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:minimumLikelyDelay ;
            siri:xsdSequenceOrder 8 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:averageDelay ;
            siri:xsdSequenceOrder 9 ] .

siri:CompassBearing16Enumeration a rdfs:Datatype ;
    rdfs:label "CompassBearing16Enumeration" ;
    rdfs:comment "16 point compass." ;
    owl:oneOf ( "" "SW" "SE" "NW" "NE" "W" "E" "S" "N" ) .

siri:CompassBearing8Enumeration a rdfs:Datatype ;
    rdfs:label "CompassBearing8Enumeration" ;
    rdfs:comment "8 point compass." ;
    owl:oneOf ( "SW" "SE" "NW" "NE" "W" "E" "S" "N" ) .

siri:CongestionEnumeration a rdfs:Datatype ;
    rdfs:label "CongestionEnumeration" ;
    rdfs:comment "Allowed values for a CHECK CONSTRAINT." ;
    owl:oneOf ( "noWaiting" "queue" "crowding" "full" ) .

siri:CountryRefStructure a owl:Class ;
    rdfs:label "Country" ;
    rdfs:comment "Type for reference to a Country identifier." .

siri:DeltaModificationEnumeration a rdfs:Datatype ;
    rdfs:label "DeltaModificationEnumeration" ;
    rdfs:comment "Classification of modification as addition, deletion, revision or delta only. Enumerated value." ;
    owl:oneOf ( "new" "delete" "revise" "delta" ) .

siri:EquipmentRefStructure a owl:Class ;
    rdfs:label "Equipment" ;
    rdfs:comment "Type for reference to a EQUIPMENT." .

siri:EquipmentStatusEnumeration a rdfs:Datatype ;
    rdfs:label "EquipmentStatusEnumeration" ;
    rdfs:comment "Availabilityload status of a EQUIPMENT." ;
    owl:oneOf ( "unknown" "available" "notAvailable" ) .

siri:EquipmentTypeRefStructure a owl:Class ;
    rdfs:label "EquipmentType" ;
    rdfs:comment "Type for TYPE OF EQUIPMENT." .

siri:FeatureIdRefStructure a owl:Class ;
    rdfs:label "FeatureId" ;
    rdfs:comment "Type for reference to a GIS FEATURe." .

