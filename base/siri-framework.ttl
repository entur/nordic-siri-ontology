            siri:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:messageIdentifier ;
            siri:xsdSequenceOrder 3 ],
        siri:AuthenticatedRequestStructure ;
    siri:abstract true .

siri:AbstractFunctionalServiceRequestStructure a owl:Class ;
    rdfs:label "AbstractFunctionalServiceRequest" ;
    rdfs:comment "Abstract Service Request for SIRI Service request." ;
    rdfs:subClassOf siri:AbstractServiceRequestStructure ;
    siri:abstract true .

siri:AbstractNotificationStructure a owl:Class ;
