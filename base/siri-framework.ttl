siri:ErrorConditionElement a owl:Class ;
    rdfs:label "ErrorConditionElement" ;
    rdfs:subClassOf siri:ErrorConditionElementStructure ;
    siri:xsdElement true .

siri:ErrorDescriptionStructure a owl:Class ;
    rdfs:label "ErrorDescription" ;
    rdfs:comment "Type for Description of an error." .

siri:EstimatedTimetableCapabilitiesRequest a owl:Class ;
    rdfs:label "EstimatedTimetableCapabilitiesRequest" ;
    rdfs:subClassOf siri:ServiceCapabilitiesRequestStructure ;
    siri:xsdElement true .

siri:FacilityMonitoringCapabilitiesRequest a owl:Class ;
    rdfs:label "FacilityMonitoringCapabilitiesRequest" ;
    rdfs:subClassOf siri:ServiceCapabilitiesRequestStructure ;
