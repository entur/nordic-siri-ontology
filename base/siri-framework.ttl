@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix siri: <https://siri-cen.eu/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

siri:AbstractCapabilitiesStructure a owl:Class ;
    rdfs:label "AbstractCapabilities" ;
    rdfs:comment "Type for Capabilities of StopMonitopring Service." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:generalInteraction ;
            siri:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:transportDescription ;
            siri:xsdSequenceOrder 2 ] .

siri:AbstractDiscoveryDelivery a owl:Class ;
    rdfs:label "AbstractDiscoveryDelivery" ;
    rdfs:subClassOf siri:AbstractDiscoveryDeliveryStructure ;
    siri:xsdElement true .

siri:AbstractDiscoveryRequest a owl:Class ;
    rdfs:label "AbstractDiscoveryRequest" ;
    rdfs:subClassOf siri:AbstractDiscoveryRequestStructure ;
    siri:xsdElement true .

siri:AbstractFunctionalServiceCapabilitiesRequest a owl:Class ;
    rdfs:label "AbstractFunctionalServiceCapabilitiesRequest" ;
    rdfs:subClassOf siri:AbstractServiceRequestStructure ;
    siri:xsdElement true .

siri:AbstractFunctionalServiceCapabilitiesResponse a owl:Class ;
    rdfs:label "AbstractFunctionalServiceCapabilitiesResponse" ;
    rdfs:subClassOf siri:AbstractServiceCapabilitiesResponseStructure ;
    siri:xsdElement true .

siri:AbstractFunctionalServiceDelivery a owl:Class ;
    rdfs:label "AbstractFunctionalServiceDelivery" ;
    rdfs:subClassOf siri:AbstractServiceDeliveryStructure ;
    siri:xsdElement true .

siri:AbstractFunctionalServiceRequest a owl:Class ;
    rdfs:label "AbstractFunctionalServiceRequest" ;
    rdfs:subClassOf siri:AbstractFunctionalServiceRequestStructure ;
    siri:xsdElement true .

siri:AbstractFunctionalServiceSubscriptionRequest a owl:Class ;
    rdfs:label "AbstractFunctionalServiceSubscriptionRequest" ;
    rdfs:subClassOf siri:AbstractSubscriptionStructure ;
    siri:xsdElement true .

siri:AbstractIdentifiedItemStructure a owl:Class ;
    rdfs:label "AbstractIdentifiedItem" ;
    rdfs:comment "Type for an Activity that can be referenced." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:itemIdentifier ;
            siri:xsdSequenceOrder 1 ],
        siri:AbstractItemStructure ;
    siri:abstract true .

siri:AbstractReferencingItemStructure a owl:Class ;
    rdfs:label "AbstractReferencingItem" ;
    rdfs:comment "Type for an Activity that references a previous Activity." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:itemRef ;
            siri:xsdSequenceOrder 1 ],
        siri:AbstractItemStructure ;
    siri:abstract true .

siri:AbstractRequest a owl:Class ;
    rdfs:label "AbstractRequest" ;
    rdfs:subClassOf siri:AbstractRequestStructure ;
    siri:xsdElement true .

siri:AbstractRequiredIdentifiedItemStructure a owl:Class ;
    rdfs:label "AbstractRequiredIdentifiedItem" ;
    rdfs:comment "Type for an Activity that can be referenced." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:itemIdentifier ;
            siri:xsdSequenceOrder 1 ],
        siri:AbstractItemStructure ;
    siri:abstract true .

siri:AbstractRequiredReferencingItemStructure a owl:Class ;
    rdfs:label "AbstractRequiredReferencingItem" ;
    rdfs:comment "Type for an Activity that references a previous Activity." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:itemRef ;
            siri:xsdSequenceOrder 1 ],
        siri:AbstractItemStructure ;
    siri:abstract true .

siri:AbstractResponse a owl:Class ;
    rdfs:label "AbstractResponse" ;
    rdfs:subClassOf siri:ResponseStructure ;
    siri:xsdElement true .

siri:AbstractServiceRequest a owl:Class ;
    rdfs:label "AbstractServiceRequest" ;
    rdfs:subClassOf siri:AbstractServiceRequestStructure ;
    siri:xsdElement true .

siri:AbstractSubscriptionRequestStructure a owl:Class ;
    rdfs:label "AbstractSubscriptionRequest" ;
    rdfs:comment "Type for COmmon Subscription Request." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:consumerAddress ;
            siri:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:subscriptionFilterIdentifier ;
            siri:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:subscriptionContext ;
            siri:xsdSequenceOrder 3 ],
        siri:RequestStructure ;
    siri:abstract true .

siri:AbstractTrackedRequest a owl:Class ;
    rdfs:label "AbstractTrackedRequest" ;
    rdfs:subClassOf siri:RequestStructure ;
    siri:xsdElement true .

siri:AccessNotAllowedError a owl:Class ;
    rdfs:label "AccessNotAllowedError" ;
    rdfs:subClassOf siri:AccessNotAllowedErrorStructure ;
    siri:xsdElement true .

siri:AllowedResourceUsageExceededError a owl:Class ;
    rdfs:label "AllowedResourceUsageExceededError" ;
    rdfs:subClassOf siri:AllowedResourceUsageExceededErrorStructure ;
    siri:xsdElement true .

siri:AuthenticatedRequest a owl:Class ;
    rdfs:label "AuthenticatedRequest" ;
    rdfs:subClassOf siri:AuthenticatedRequestStructure ;
    siri:xsdElement true .

siri:BeyondDataHorizon a owl:Class ;
    rdfs:label "BeyondDataHorizon" ;
    rdfs:subClassOf siri:BeyondDataHorizonErrorStructure ;
    siri:xsdElement true .

siri:CapabilityGeneralInteractionStructure a owl:Class ;
    rdfs:label "CapabilityGeneralInteraction" ;
    rdfs:comment "Type for Common Request Policy capabilities." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:interaction ;
            siri:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:delivery ;
            siri:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:multipartDespatch ;
            siri:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:multipleSubscriberFilter ;
            siri:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:hasConfirmDelivery ;
            siri:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:hasHeartbeat ;
            siri:xsdSequenceOrder 6 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:visitNumberisOrder ;
            siri:xsdSequenceOrder 7 ] .

siri:CapabilityNotSupportedError a owl:Class ;
    rdfs:label "CapabilityNotSupportedError" ;
    rdfs:subClassOf siri:CapabilityNotSupportedErrorStructure ;
    siri:xsdElement true .

siri:CapabilityRefStructure a owl:Class ;
    rdfs:label "Capability" ;
    rdfs:comment "Type for capability ref." .

siri:CapabilityRequestPolicyStructure a owl:Class ;
    rdfs:label "CapabilityRequestPolicy" ;
    rdfs:comment "Type for Common Request Policy capabilities." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:nationalLanguage ;
            siri:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:translations ;
            siri:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:gmlCoordinateFormat ;
            siri:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:wgsDecimalDegrees ;
            siri:xsdSequenceOrder 4 ] .

siri:CapabilitySubscriptionPolicyStructure a owl:Class ;
    rdfs:label "CapabilitySubscriptionPolicy" ;
    rdfs:comment "Type for Common Subscription capabilities." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:hasIncrementalUpdates ;
            siri:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:hasChangeSensitivity ;
            siri:xsdSequenceOrder 2 ] .

siri:CheckStatusRequest a owl:Class ;
    rdfs:label "CheckStatusRequest" ;
    rdfs:subClassOf siri:CheckStatusRequestStructure ;
    siri:xsdElement true .

siri:CheckStatusResponse a owl:Class ;
    rdfs:label "CheckStatusResponse" ;
    rdfs:subClassOf siri:CheckStatusResponseStructure ;
    siri:xsdElement true .

siri:CheckStatusResponseBodyStructure a owl:Class ;
    rdfs:label "CheckStatusResponseBody" ;
    rdfs:comment "Type for Body of Service Status Check Response. Used in WSDL." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:status ;
            siri:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:dataReady ;
            siri:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:errorCondition ;
            siri:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:validUntil ;
            siri:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:shortestPossibleCycle ;
            siri:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:serviceStartedTime ;
            siri:xsdSequenceOrder 6 ] .

siri:CommunicationsTransportMethodEnumeration a rdfs:Datatype ;
    rdfs:label "CommunicationsTransportMethodEnumeration" ;
    rdfs:comment "Enumeration of communications transport method usage." ;
    owl:oneOf ( "httpPost" "other" "wsdlSoap" "wsdlSoapDocumentLiteral" "httpUrlJSON" "httpUrlProtoBuffers" ) .

siri:CompressionMethodEnumeration a rdfs:Datatype ;
    rdfs:label "CompressionMethodEnumeration" ;
    rdfs:comment "Enumeration of compression usage." ;
    owl:oneOf ( "gzip" "none" "other" ) .

siri:ConnectionMonitoringCapabilitiesRequest a owl:Class ;
    rdfs:label "ConnectionMonitoringCapabilitiesRequest" ;
    rdfs:subClassOf siri:ServiceCapabilitiesRequestStructure ;
    siri:xsdElement true .

siri:ConnectionTimetableCapabilitiesRequest a owl:Class ;
    rdfs:label "ConnectionTimetableCapabilitiesRequest" ;
    rdfs:subClassOf siri:ServiceCapabilitiesRequestStructure ;
    siri:xsdElement true .

siri:ContextualisedRequestStructure a owl:Class ;
    rdfs:label "ContextualisedRequest" ;
    rdfs:comment "Type for General SIRI Request." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:serviceRequestContext ;
            siri:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:requestTimestamp ;
            siri:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:accountId ;
            siri:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:accountKey ;
            siri:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:address ;
            siri:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:requestorRef ;
            siri:xsdSequenceOrder 6 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:messageIdentifier ;
            siri:xsdSequenceOrder 7 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:delegatorAddress ;
            siri:xsdSequenceOrder 8 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:delegatorRef ;
            siri:xsdSequenceOrder 9 ] ;
    siri:abstract true .

siri:ControlActionCapabilitiesRequest a owl:Class ;
    rdfs:label "ControlActionCapabilitiesRequest" ;
    rdfs:subClassOf siri:ServiceCapabilitiesRequestStructure ;
    siri:xsdElement true .

siri:DataNameSpacesStructure a owl:Class ;
    rdfs:label "DataNameSpaces" ;
    rdfs:comment "Name spaces." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:stopPointNameSpace ;
            siri:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:lineNameSpace ;
            siri:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:productCategoryNameSpace ;
            siri:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:serviceFeatureNameSpace ;
            siri:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:vehicleFeatureNameSpace ;
            siri:xsdSequenceOrder 5 ] .

siri:DataReadyAcknowledgement a owl:Class ;
    rdfs:label "DataReadyAcknowledgement" ;
    rdfs:subClassOf siri:DataReadyResponseStructure ;
