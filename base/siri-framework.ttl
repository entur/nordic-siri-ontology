siri:SubscriptionContextStructure a owl:Class ;
    rdfs:label "SubscriptionContext" ;
    rdfs:comment "Type for Subscription context - Configuration parameters which may be evrriden." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:heartbeatInterval ;
            siri:xsdSequenceOrder 1 ] .

