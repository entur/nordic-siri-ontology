siri:DataSupplyRequest a owl:Class ;
    rdfs:label "DataSupplyRequest" ;
    rdfs:subClassOf siri:DataSupplyRequestStructure ;
    siri:xsdElement true .

siri:DataSupplyRequestBodyStructure a owl:Class ;
    rdfs:label "DataSupplyRequestBody" ;
    rdfs:comment "Type for Body of Data Supply Request. Used in WSDL." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:notificationRef ;
            siri:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:allData ;
            siri:xsdSequenceOrder 2 ] .

siri:DeliveryMethodEnumeration a rdfs:Datatype ;
    rdfs:label "DeliveryMethodEnumeration" ;
    rdfs:comment "Delivery Method: Fetched or Direct Delivery." ;
    owl:oneOf ( "direct" "fetched" ) .

siri:EndpointDeniedAccessError a owl:Class ;
    rdfs:label "EndpointDeniedAccessError" ;
    rdfs:subClassOf siri:EndpointDeniedAccessStructure ;
