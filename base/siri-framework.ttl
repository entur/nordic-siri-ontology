    rdfs:label "HeartbeatNotification" ;
    rdfs:subClassOf siri:HeartbeatNotificationStructure ;
    siri:xsdElement true .

siri:InvalidDataReferencesError a owl:Class ;
    rdfs:label "InvalidDataReferencesError" ;
    rdfs:subClassOf siri:InvalidDataReferencesErrorStructure ;
    siri:xsdElement true .

siri:ItemRefStructure a owl:Class ;
    rdfs:label "Item" ;
    rdfs:comment "Type for reference to an Item." .

siri:MessageRefStructure a owl:Class ;
    rdfs:label "Message" ;
    rdfs:comment "Type for reference to a message." ;
    rdfs:subClassOf siri:MessageQualifierStructure .

