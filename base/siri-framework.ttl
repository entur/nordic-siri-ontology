siri:ParametersIgnoredError a owl:Class ;
    rdfs:label "ParametersIgnoredError" ;
    rdfs:subClassOf siri:ParametersIgnoredErrorStructure ;
    siri:xsdElement true .

siri:PredictorsEnumeration a rdfs:Datatype ;
    rdfs:label "PredictorsEnumeration" ;
    rdfs:comment "Allowed values for predictors." ;
    owl:oneOf ( "avmsOnly" "anyone" ) .

siri:ProducerRequest a owl:Class ;
    rdfs:label "ProducerRequest" ;
    rdfs:subClassOf siri:ProducerRequestEndpointStructure ;
    siri:xsdElement true .

siri:ProducerResponseEndpointStructure a owl:Class ;
    rdfs:label "ProducerResponseEndpoint" ;
    rdfs:comment "Type for Unique reference to reponse from producer. May be used to reference request in subsequent interactions. Used for WSDL." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:producerRef ;
            siri:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:address ;
            siri:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:responseMessageIdentifier ;
            siri:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:requestMessageRef ;
            siri:xsdSequenceOrder 4 ],
        siri:ResponseStructure .

siri:ProductionTimetableCapabilitiesRequest a owl:Class ;
    rdfs:label "ProductionTimetableCapabilitiesRequest" ;
    rdfs:subClassOf siri:ServiceCapabilitiesRequestStructure ;
    siri:xsdElement true .

siri:ResponseStatus a owl:Class ;
    rdfs:label "ResponseStatus" ;
    rdfs:subClassOf siri:StatusResponseStructure ;
