siri:ServiceDeliveryBodyStructure a owl:Class ;
    rdfs:label "ServiceDeliveryBody" ;
    rdfs:comment "Type for SIRI Service Delivery Body.." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:status ;
            siri:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:connectionTimetableDelivery ;
            siri:xsdSequenceOrder 10 ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:connectionMonitoringFeederDelivery ;
            siri:xsdSequenceOrder 11 ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:connectionMonitoringDistributorDelivery ;
            siri:xsdSequenceOrder 12 ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:generalMessageDelivery ;
            siri:xsdSequenceOrder 13 ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:facilityMonitoringDelivery ;
            siri:xsdSequenceOrder 14 ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:situationExchangeDelivery ;
            siri:xsdSequenceOrder 15 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:errorCondition ;
            siri:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:moreData ;
            siri:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:onProperty siri:includedSituationExchangeDelivery ;
            siri:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:productionTimetableDelivery ;
            siri:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:estimatedTimetableDelivery ;
            siri:xsdSequenceOrder 6 ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:stopTimetableDelivery ;
            siri:xsdSequenceOrder 7 ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:stopMonitoringDelivery ;
            siri:xsdSequenceOrder 8 ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:vehicleMonitoringDelivery ;
            siri:xsdSequenceOrder 9 ] .

