siri:SiriServiceDeliveryStructure a owl:Class ;
    rdfs:label "SiriServiceDelivery" ;
    rdfs:comment "Type for a SIRI SIRI Functional Service Delivery types.Used for WSDL." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty siri:includedSituationExchangeDelivery ;
            siri:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
