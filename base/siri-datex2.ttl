siri:AuthorityOperation a owl:Class ;
    rdfs:label "AuthorityOperation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:authorityOperationType ;
