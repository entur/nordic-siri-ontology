@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix siri: <https://siri-cen.eu/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

siri:AbnormalTraffic a owl:Class ;
    rdfs:label "AbnormalTraffic" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:abnormalTrafficType ;
            siri:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:numberOfVehiclesWaiting ;
            siri:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:queueLength ;
            siri:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:relativeTrafficFlow ;
            siri:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:trafficFlowCharacteristics ;
            siri:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:trafficTrendType ;
            siri:xsdSequenceOrder 6 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:abnormalTrafficExtension ;
            siri:xsdSequenceOrder 7 ],
        siri:TrafficElement .

siri:AbnormalTrafficTypeEnum a rdfs:Datatype ;
    rdfs:label "AbnormalTrafficTypeEnum" ;
    owl:oneOf ( "stationaryTraffic" "queuingTraffic" "slowTraffic" "heavyTraffic" "unspecifiedAbnormalTraffic" "other" ) .

siri:Accident a owl:Class ;
    rdfs:label "Accident" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:accidentCause ;
            siri:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:accidentType ;
            siri:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:totalNumberOfPeopleInvolved ;
            siri:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:totalNumberOfVehiclesInvolved ;
            siri:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:onProperty siri:vehicleInvolved ;
            siri:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            owl:onProperty siri:groupOfVehiclesInvolved ;
            siri:xsdSequenceOrder 6 ],
        [ a owl:Restriction ;
            owl:onProperty siri:groupOfPeopleInvolved ;
            siri:xsdSequenceOrder 7 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:accidentExtension ;
            siri:xsdSequenceOrder 8 ],
        siri:TrafficElement .

siri:AccidentCauseEnum a rdfs:Datatype ;
    rdfs:label "AccidentCauseEnum" ;
    owl:oneOf ( "avoidanceOfObstacles" "driverDistraction" "driverDrugAbuse" "driverIllness" "exceedingSpeedsLimits" "excessAlcohol" "excessiveDriverTiredness" "impermissibleManoeuvre" "limitedVisibility" "notKeepingASafeDistance" "onTheWrongSideOfTheRoad" "pedestrianInRoad" "poorLaneAdherence" "poorMergeEntryOrExitJudgement" "poorRoadSurfaceCondition" "poorSurfaceAdherence" "undisclosed" "unknown" "vehicleFailure" "other" ) .

siri:AccidentTypeEnum a rdfs:Datatype ;
    rdfs:label "AccidentTypeEnum" ;
    owl:oneOf ( "accident" "accidentInvolvingBicycles" "accidentInvolvingBuses" "accidentInvolvingHazardousMaterials" "accidentInvolvingHeavyLorries" "accidentInvolvingMassTransitVehicle" "accidentInvolvingMopeds" "accidentInvolvingMotorcycles" "accidentInvolvingRadioactiveMaterial" "accidentInvolvingTrain" "chemicalSpillageAccident" "collision" "collisionWithAnimal" "collisionWithObstruction" "collisionWithPerson" "earlierAccident" "fuelSpillageAccident" "headOnCollision" "headOnOrSideCollision" "jackknifedArticulatedLorry" "jackknifedCaravan" "jackknifedTrailer" "multipleVehicleCollision" "multivehicleAccident" "oilSpillageAccident" "overturnedHeavyLorry" "overturnedTrailer" "overturnedVehicle" "rearCollision" "secondaryAccident" "seriousAccident" "sideCollision" "vehicleOffRoad" "vehicleSpunAround" "other" ) .

siri:AlertCArea a owl:Class ;
    rdfs:label "AlertCArea" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:alertCLocationCountryCode ;
            siri:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:alertCLocationTableNumber ;
            siri:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:alertCLocationTableVersion ;
            siri:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:areaLocation ;
            siri:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:alertCAreaExtension ;
            siri:xsdSequenceOrder 5 ] .

siri:AlertCDirection a owl:Class ;
    rdfs:label "AlertCDirection" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:alertCDirectionCoded ;
            siri:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:alertCDirectionNamed ;
            siri:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:alertCDirectionSense ;
            siri:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:alertCDirectionExtension ;
            siri:xsdSequenceOrder 4 ] .

siri:AlertCDirectionEnum a rdfs:Datatype ;
    rdfs:label "AlertCDirectionEnum" ;
    owl:oneOf ( "both" "negative" "positive" "unknown" ) .

siri:AlertCLinearByCode a owl:Class ;
