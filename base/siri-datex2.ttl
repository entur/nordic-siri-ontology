        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:tpegAreaLocation ;
            siri:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:areaExtension ;
            siri:xsdSequenceOrder 3 ],
        siri:Location .

siri:AreaDestination a owl:Class ;
    rdfs:label "AreaDestination" ;
    rdfs:subClassOf [ a owl:Restriction ;
