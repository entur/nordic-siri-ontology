siri:AnimalPresenceTypeEnum a rdfs:Datatype ;
    rdfs:label "AnimalPresenceTypeEnum" ;
    owl:oneOf ( "animalsOnTheRoad" "herdOfAnimalsOnTheRoad" "largeAnimalsOnTheRoad" ) .

siri:Area a owl:Class ;
    rdfs:label "Area" ;
