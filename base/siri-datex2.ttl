siri:CarParkConfigurationEnum a rdfs:Datatype ;
    rdfs:label "CarParkConfigurationEnum" ;
    owl:oneOf ( "multiStorey" "parkAndRide" "singleLevel" "underground" ) .

siri:CarParkStatusEnum a rdfs:Datatype ;
    rdfs:label "CarParkStatusEnum" ;
    owl:oneOf ( "carParkClosed" "allCarParksFull" "carParkFacilityFaulty" "carParkFull" "carParkStatusUnknown" "enoughSpacesAvailable" "multiStoryCarParksFull" "noMoreParkingSpacesAvailable" "noParkAndRideInformation" "noParkingAllowed" "noParkingInformationAvailable" "normalParkingRestrictionsLifted" "onlyAFewSpacesAvailable" "parkAndRideServiceNotOperating" "parkAndRideServiceOperating" "specialParkingRestrictionsInForce" ) .

