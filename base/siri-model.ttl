            owl:onProperty siri:aimedLocationName ;
            siri:xsdSequenceOrder 8 ] .

siri:PredictionInaccurateReasonEnumeration a rdfs:Datatype ;
    rdfs:label "PredictionInaccurateReasonEnumeration" ;
    rdfs:comment "Allowed values for PredictionInaccurateReason, i.e., possible reasons for a change in prediction (in)accuracy." ;
    owl:oneOf ( "vehicleInTrafficJam" "technicalProblem" "dispatchAction" "missingUpdate" "unknown" ) .

siri:PredictionQualityStructure a owl:Class ;
    rdfs:label "PredictionQuality" ;
    rdfs:comment "Type for Prediction Quality quantifcation." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:predictionLevel ;
