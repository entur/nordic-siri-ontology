siri:PassageBetweenTrainsStructure a owl:Class ;
    rdfs:label "PassageBetweenTrains" ;
    rdfs:comment "Indicates whether passengers have access to adjacent TRAINs or TRAIN COMPONENTs within a COMPOUND TRAIN, i.e., whether passage between those wagons/coaches is possible. (since SIRI 2.1)" ;
