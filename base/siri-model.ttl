siri:RemovedDatedVehicleJourneyStructure a owl:Class ;
    rdfs:label "RemovedDatedVehicleJourney" ;
    rdfs:comment "Type for previously planned VEHICLE JOURNEY that is removed from the data producer when using incremental updates. (since SIRI 2.1)" ;
    rdfs:subClassOf [ a owl:Restriction ;
