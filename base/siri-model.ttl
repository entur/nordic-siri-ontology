            owl:onProperty siri:typeOfFuel ;
            siri:xsdSequenceOrder 8 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:euroClass ;
            siri:xsdSequenceOrder 9 ] .

siri:VehicleJourneyRefStructure a owl:Class ;
    rdfs:label "VehicleJourney" ;
    rdfs:comment "Type for reference to a VEHICLE JOURNEY." .

siri:VehicleRefStructure a owl:Class ;
    rdfs:label "Vehicle" ;
    rdfs:comment "Reference to a VEHICLE." .

siri:actualBoardingPositionName a owl:ObjectProperty ;
    rdfs:label "ActualBoardingPositionName" ;
    rdfs:comment "Recorded BOARDING POSITION name. Can be used to indicate the actually used boarding position." ;
    siri:xsdType "NaturalLanguageStringStructure" .

siri:actualBoardingPositionRef a owl:ObjectProperty ;
    rdfs:label "ActualBoardingPositionRef" ;
    rdfs:comment "Actually recorded BOARDING POSITION. Can be used to indicate the actually used boarding position." ;
    siri:isReference true ;
    siri:xsdType "BoardingPositionRefStructure" .

siri:actualFlexibleArea a owl:ObjectProperty ;
    rdfs:label "ActualFlexibleArea" ;
    rdfs:comment "Area that encompasses the actually recorded flexible stop locations." ;
    siri:xsdType "FlexibleAreaStructure" .

siri:actualFlexibleAreaRef a owl:ObjectProperty ;
    rdfs:label "ActualFlexibleAreaRef" ;
    siri:isReference true ;
    siri:xsdType "FlexibleAreaRefStructure" .

siri:actualHeadwayInterval a owl:DatatypeProperty ;
    rdfs:label "ActualHeadwayInterval" .

siri:actualLocationName a owl:ObjectProperty ;
    rdfs:label "ActualLocationName" ;
    rdfs:comment "Name or description (e.g. address) of the actually recorded location or flexible area." ;
    siri:xsdType "NaturalLanguageStringStructure" .

siri:actualQuayName a owl:ObjectProperty ;
    rdfs:label "ActualQuayName" ;
    rdfs:comment "Actual Platform name. Can be used to indicate recorded platform. (since SIRI 2.1)" ;
    siri:xsdType "NaturalLanguageStringStructure" .

siri:actualQuayRef a owl:ObjectProperty ;
    rdfs:label "ActualQuayRef" ;
    rdfs:comment "Physical QUAY actually used. (since SIRI 2.0)" ;
    siri:isReference true ;
    siri:xsdType "QuayRefStructure" .

siri:alightingCount a owl:DatatypeProperty ;
    rdfs:label "AlightingCount" ;
    rdfs:comment "Total number of alighting passengers for this vehicle journey at this STOP POINT." ;
    siri:xsdType "NumberOfPassengers" .

siri:bicycleOnboardCount a owl:DatatypeProperty ;
    rdfs:label "BicycleOnboardCount" ;
    rdfs:comment "Total number of bicycles on-board, i.e., number of bicycle racks that are occupied after departing the STOP POINT." ;
    siri:xsdType "xsd:nonNegativeInteger" .

siri:bicycleRackCapacity a owl:DatatypeProperty ;
    rdfs:label "BicycleRackCapacity" ;
    rdfs:comment "The number of bicycle racks on the vehicle." ;
    siri:xsdType "xsd:nonNegativeInteger" .

siri:boardingCount a owl:DatatypeProperty ;
    rdfs:label "BoardingCount" ;
    rdfs:comment "Total number of boarding passengers for this vehicle journey at this STOP POINT." ;
    siri:xsdType "NumberOfPassengers" .

siri:brandingCode a owl:DatatypeProperty ;
    rdfs:label "BrandingCode" ;
    rdfs:comment "Identity of BRANDING." ;
    siri:xsdType "xsd:NMTOKEN" .

siri:checkConnectionLinkRef a owl:ObjectProperty ;
    rdfs:label "CheckConnectionLinkRef" ;
    rdfs:comment "If access control is supported, whether access control by CONNECTION LINK is supported. Default is 'true'." ;
    siri:isReference true .

siri:checkMonitoringRef a owl:ObjectProperty ;
    rdfs:label "CheckMonitoringRef" ;
    siri:isReference true .

siri:compoundTrainCode a owl:DatatypeProperty ;
    rdfs:label "CompoundTrainCode" ;
    rdfs:comment "Identifier for COMPOUND TRAIN." ;
    siri:xsdType "CompoundTrainCodeType" .

siri:connectionLinkCode a owl:DatatypeProperty ;
    rdfs:label "ConnectionLinkCode" ;
    rdfs:comment "Identifier of CONNECTION LINk." ;
    siri:xsdType "ConnectionLinkCodeType" .

siri:connectionLinkPermissions a owl:DatatypeProperty ;
    rdfs:label "ConnectionLinkPermissions" .

siri:connectionMonitoring a owl:DatatypeProperty ;
    rdfs:label "ConnectionMonitoring" ;
    rdfs:comment "Whether connection monitoring is active or not for this connection. (since SIRI 2.0)" ;
    siri:xsdType "xsd:boolean" .

siri:dataFrameRef a owl:ObjectProperty ;
    rdfs:label "DataFrameRef" ;
    rdfs:comment "Identifier of data frame within participant service. Used to ensure that the Reference to a DATED VEHICLE JOURNEY is unique with the data horizon of the service. Often the OPERATING DAY is used for this purpose." ;
    siri:isReference true ;
    siri:xsdType "DataFrameRefStructure" .

siri:datedCalls a owl:DatatypeProperty ;
    rdfs:label "DatedCalls" ;
    rdfs:comment "Complete sequence of stops along the route path, in calling order." .

siri:datedVehicleJourneyCode a owl:DatatypeProperty ;
    rdfs:label "DatedVehicleJourneyCode" ;
    rdfs:comment "Identifier for a VEHICLE JOURNEY." ;
    siri:xsdType "DatedVehicleJourneyCodeType" .

siri:defaultDuration a owl:DatatypeProperty ;
    rdfs:label "DefaultDuration" ;
    rdfs:comment "Default time (Duration) needeed to traverse SERVICE JOURNEY INTERCHANGE from feeder to distributor." ;
    siri:xsdType "PositiveDurationType" .

siri:distributorConnectionLink a owl:ObjectProperty ;
    rdfs:label "DistributorConnectionLink" ;
    rdfs:comment "Link to Interchange stop from which the distributor journey departs. If omitted: the distributor journey stop is the same as the feeder journey stop, i.e. that of theh dated call." ;
    siri:xsdType "ContextualisedConnectionLinkStructure" .

siri:distributorConnectionLinkRef a owl:ObjectProperty ;
    rdfs:label "DistributorConnectionLinkRef" ;
    rdfs:comment "Reference to a physical CONNECTION LINK over which the SERVICE JOURNEY INTERCHANGE takes place." ;
    siri:isReference true ;
    siri:xsdType "ConnectionLinkRefStructure" .

siri:distributorJourneyRef a owl:ObjectProperty ;
    rdfs:label "DistributorJourneyRef" ;
    rdfs:comment "Reference to a connecting distributor VEHICLE JOURNEY. (since SIRI 2.0)" ;
    siri:isReference true ;
    siri:xsdType "ConnectingJourneyRefStructure" .

siri:distributorOrder a owl:DatatypeProperty ;
    rdfs:label "DistributorOrder" ;
    rdfs:comment "For implementations for which Order is not used for VisitNumber, (i.e. if VisitNumberIsOrder is false) then Order can be used to associate the Order as well if useful for translation." ;
    siri:xsdType "xsd:positiveInteger" .

siri:distributorVehicleJourneyRef a owl:ObjectProperty ;
    rdfs:label "DistributorVehicleJourneyRef" ;
    rdfs:comment "Reference to a (dated) distributor VEHICLE JOURNEY." ;
    siri:isReference true ;
    siri:xsdType "DatedVehicleJourneyRefStructure" .

siri:driverHasAcknowledgeWIllWait a owl:DatatypeProperty ;
    rdfs:label "DriverHasAcknowledgeWIllWait" ;
    rdfs:comment "DEPRECATED since SIRI 2.1" ;
    siri:xsdType "xsd:boolean" .

siri:driverHasAcknowledgedWillWait a owl:DatatypeProperty ;
    rdfs:label "DriverHasAcknowledgedWillWait" ;
    rdfs:comment "Whether an acknowledgement has been received that the driver will wait. (since SIRI 2.1)" ;
    siri:xsdType "xsd:boolean" .

siri:endTimeStatus a owl:DatatypeProperty ;
    rdfs:label "EndTimeStatus" ;
    rdfs:comment "If end time not provided, whethhr to interpret range as long, term, short term or unknown length of situation. Default is unknown. (Siri 2.0++)" ;
    siri:xsdType "EndTimeStatusEnumeration" .

siri:estimatedCalls a owl:DatatypeProperty ;
    rdfs:label "EstimatedCalls" ;
    rdfs:comment "Complete sequence of stops along the route path, in calling order. Normally this is only the onwards stops from the vehicle's current position." .

siri:estimatedVehicleJourneyCode a owl:DatatypeProperty ;
    rdfs:label "EstimatedVehicleJourneyCode" ;
    rdfs:comment "If this is the first message for an unplanned 'extra' VEHICLE JOURNEY, a new and unique code must be given for it. ExtraJourney should be set to 'true'. DEPRECATED from SIRI 2.0" ;
    siri:xsdType "EstimatedVehicleJourneyCodeType" .

siri:expectedArrivalTimeOfFeeder a owl:DatatypeProperty ;
    rdfs:label "ExpectedArrivalTimeOfFeeder" ;
    rdfs:comment "Time at which feeder VEHICLE is expected to arrive. (since SIRI 2.1)" ;
    siri:xsdType "xsd:dateTime" .

siri:expectedBoardingPositionName a owl:ObjectProperty ;
    rdfs:label "ExpectedBoardingPositionName" ;
    rdfs:comment "Expected BOARDING POSITION name. Can be used to indicate real-time prediction." ;
    siri:xsdType "NaturalLanguageStringStructure" .

siri:expectedBoardingPositionRef a owl:ObjectProperty ;
    rdfs:label "ExpectedBoardingPositionRef" ;
    rdfs:comment "Physical BOARDING POSITION to use according to the real-time prediction." ;
    siri:isReference true ;
    siri:xsdType "BoardingPositionRefStructure" .

siri:expectedDepartureTimeOfDistributor a owl:DatatypeProperty ;
    rdfs:label "ExpectedDepartureTimeOfDistributor" ;
    rdfs:comment "Time at which distributor VEHICLE is expected to depart. (since SIRI 2.0)" ;
    siri:xsdType "xsd:dateTime" .

siri:expectedFlexibleArea a owl:ObjectProperty ;
    rdfs:label "ExpectedFlexibleArea" ;
    rdfs:comment "Area that encompasses the expected flexible stop locations according to the real-time prediction." ;
    siri:xsdType "FlexibleAreaStructure" .

siri:expectedFlexibleAreaRef a owl:ObjectProperty ;
    rdfs:label "ExpectedFlexibleAreaRef" ;
    siri:isReference true ;
    siri:xsdType "FlexibleAreaRefStructure" .

siri:expectedLocationName a owl:ObjectProperty ;
    rdfs:label "ExpectedLocationName" ;
    rdfs:comment "Name or description (e.g. address) of the expected location or flexible area." ;
    siri:xsdType "NaturalLanguageStringStructure" .

siri:expectedQuayName a owl:ObjectProperty ;
    rdfs:label "ExpectedQuayName" ;
    rdfs:comment "Expected Platform name. Can be used to indicate real-time prediction. (since SIRI 2.1)" ;
    siri:xsdType "NaturalLanguageStringStructure" .

siri:expectedQuayRef a owl:ObjectProperty ;
    rdfs:label "ExpectedQuayRef" ;
    rdfs:comment "Physical QUAY to use according to the real-time prediction. (since SIRI 2.0)" ;
    siri:isReference true ;
    siri:xsdType "QuayRefStructure" .

siri:fareClasses a owl:DatatypeProperty ;
    rdfs:label "FareClasses" .

siri:feederJourneyRef a owl:ObjectProperty ;
    rdfs:label "FeederJourneyRef" ;
    rdfs:comment "Reference to a connecting feeder VEHICLE JOURNEY. (since SIRI 2.0)" ;
    siri:isReference true ;
    siri:xsdType "ConnectingJourneyRefStructure" .

siri:formationStatus a owl:ObjectProperty ;
    rdfs:label "FormationStatus" ;
    rdfs:comment "Status of formation, e.g., whether it has changed compared to the plan, certain VEHICLEs or features are missing or extra VEHICLEs are added." ;
    siri:xsdType "FormationStatusStructure" .

siri:frequentTravellerDuration a owl:DatatypeProperty ;
    rdfs:label "FrequentTravellerDuration" ;
    rdfs:comment "Time needeed by a traveller whis is familiar with SERVICE JOURNEY INTERCHANGE to traverse it. If absent, use DefaultDuration." ;
    siri:xsdType "PositiveDurationType" .

siri:fromServiceJourneyInterchange a owl:ObjectProperty ;
    rdfs:label "FromServiceJourneyInterchange" ;
    rdfs:comment "Information on any planned feeder connections. SIRI 2.0" ;
    siri:xsdType "FromServiceJourneyInterchangeStructure" .

siri:groupReservation a owl:ObjectProperty ;
    rdfs:label "GroupReservation" ;
    rdfs:comment "Reservations of travel groups, i.e., name of group and number of seats booked." ;
    siri:xsdType "GroupReservationStructure" .

siri:higherTimeLimit a owl:DatatypeProperty ;
    rdfs:label "HigherTimeLimit" ;
    rdfs:comment "Upper bound on time of prediction for confidence level if different from defaults. (since SIRI 2.0)" ;
    siri:xsdType "xsd:dateTime" .

siri:image a owl:DatatypeProperty ;
    rdfs:label "Image" ;
    rdfs:comment "Default image for TYPE OF VALUE." ;
    siri:xsdType "xsd:anyURI" .

siri:impairedAccessDuration a owl:DatatypeProperty ;
    rdfs:label "ImpairedAccessDuration" ;
    rdfs:comment "Time needeed by a traveller wos is mobility impaired to traverse SERVICE JOURNEY INTERCHANGE. If absent, use DefaultDuration and a standard impaired travel speed." ;
    siri:xsdType "PositiveDurationType" .

siri:interchangeStatus a owl:DatatypeProperty ;
    rdfs:label "InterchangeStatus" ;
    rdfs:comment "Whether this interchange is planned, updated, additional or cancelled. (since SIRI 2.1)" ;
    siri:xsdType "InterchangeStatusEnumeration" .

siri:journeyRelation a owl:ObjectProperty ;
    rdfs:label "JourneyRelation" ;
    siri:xsdType "JourneyRelationStructure" .

siri:journeyRelationType a owl:DatatypeProperty ;
    rdfs:label "JourneyRelationType" ;
    rdfs:comment "Specifies the type of the relation, e.g., joining, splitting, replacement etc. (since SIRI 2.1)" ;
    siri:xsdType "JourneyRelationTypeEnumeration" .

siri:lineNote a owl:ObjectProperty ;
    rdfs:label "LineNote" ;
    rdfs:comment "Additional Text associated with LINE. (Unbounded since SIRI 2.0)" ;
    siri:xsdType "NaturalLanguagePlaceNameStructure" .

siri:linePermissions a owl:DatatypeProperty ;
    rdfs:label "LinePermissions" .

siri:linkDistance a owl:DatatypeProperty ;
    rdfs:label "LinkDistance" ;
    rdfs:comment "The total distance in metres between the previous stop and the next stop." ;
    siri:xsdType "xsd:decimal" .

siri:lowerTimeLimit a owl:DatatypeProperty ;
    rdfs:label "LowerTimeLimit" ;
    rdfs:comment "Lower bound on time of prediction for confidence level if different from defaults. (since SIRI 2.0)" ;
    siri:xsdType "xsd:dateTime" .

siri:mode a owl:DatatypeProperty ;
    rdfs:label "Mode" ;
    rdfs:comment "A method of transportation such as bus, rail, etc." ;
    siri:xsdType "AllModesEnumeration" .

siri:monitoredCall a owl:ObjectProperty ;
    rdfs:label "MonitoredCall" ;
    rdfs:comment "Monitored CALL at the current stop. For SIRI-SM this is the stop for which data is requested. For SIRI-VM this is the most recent stop visited by the VEHICLE." ;
    siri:xsdType "MonitoredCallStructure" .

siri:monitoringRef a owl:ObjectProperty ;
    rdfs:label "MonitoringRef" ;
    rdfs:comment "Reference to a Stop Monitoring point (LOGICAL DISPLAY) to which permission applies." ;
    siri:isReference true ;
    siri:xsdType "MonitoringRefStructure" .

siri:nameOfGroup a owl:ObjectProperty ;
    rdfs:label "NameOfGroup" ;
    rdfs:comment "Name for which the travel group has made the reservation." ;
    siri:xsdType "NaturalLanguageStringStructure" .

siri:note a owl:ObjectProperty ;
    rdfs:label "Note" ;
    rdfs:comment "Text annotation that applies to an element." ;
    siri:xsdType "NaturalLanguageStringStructure" .

siri:numberOfBlockParts a owl:DatatypeProperty ;
    rdfs:label "NumberOfBlockParts" ;
    rdfs:comment "Total number of BLOCK parts making up the train of which this is part." ;
    siri:xsdType "xsd:positiveInteger" .

siri:numberOfCars a owl:DatatypeProperty ;
    rdfs:label "NumberOfCars" ;
    rdfs:comment "Number of cars needed in TRAIN." ;
    siri:xsdType "xsd:nonNegativeInteger" .

siri:numberOfReservedSeats a owl:DatatypeProperty ;
    rdfs:label "NumberOfReservedSeats" ;
    rdfs:comment "Number of seats that the group has booked." ;
    siri:xsdType "NumberOfPassengers" .

siri:occasionalTravellerDuration a owl:DatatypeProperty ;
    rdfs:label "OccasionalTravellerDuration" ;
    rdfs:comment "Time needeed by a traveller whis is not familiar with SERVICE JOURNEY INTERCHANGE to traverse it. If absent, use DefaultDuration and a standard weighting." ;
    siri:xsdType "PositiveDurationType" .

siri:occupancyLevel a owl:DatatypeProperty ;
    rdfs:label "OccupancyLevel" ;
    rdfs:comment "An approximate figure of how occupied or full a VEHICLE and its parts are, e.g. 'manySeatsAvailable' or 'standingRoomOnly'. More accurate data can be provided by the individual occupancies or capacities below." ;
    siri:xsdType "OccupancyEnumeration" .

siri:occupancyPercentage a owl:DatatypeProperty ;
    rdfs:label "OccupancyPercentage" ;
    rdfs:comment "Utilised percentage of maximum payload after departing the STOP POINT." ;
    siri:xsdType "PercentageType" .

siri:onboardCount a owl:DatatypeProperty ;
    rdfs:label "OnboardCount" ;
    rdfs:comment "Total number of passengers on-board after departing the STOP POINT." ;
    siri:xsdType "NumberOfPassengers" .

siri:onwardCall a owl:ObjectProperty ;
    rdfs:label "OnwardCall" ;
    siri:xsdType "OnwardCallStructure" .

siri:onwardCalls a owl:ObjectProperty ;
    rdfs:label "OnwardCalls" ;
    rdfs:comment "Information on CALLs at the intermediate stops beyond the current stop, up to and including the destination, in order of visits. Should only be included if the detail level was requested." ;
    siri:xsdType "OnwardCallsStructure" .

siri:operatorPermissions a owl:DatatypeProperty ;
    rdfs:label "OperatorPermissions" .

siri:participantRef a owl:ObjectProperty ;
    rdfs:label "ParticipantRef" ;
    rdfs:comment "PARTICIPANT reference that identifies data producer of journey." ;
    siri:isReference true ;
    siri:xsdType "ParticipantRefStructure" .

siri:passageIsPossible a owl:DatatypeProperty ;
    rdfs:label "PassageIsPossible" ;
    siri:xsdType "xsd:boolean" .

siri:passages a owl:DatatypeProperty ;
    rdfs:label "Passages" ;
    rdfs:comment "Specifies whether a passage from/to an adjacent TRAIN is possible for passengers." .

siri:percentage a owl:DatatypeProperty ;
    rdfs:label "Percentage" ;
    rdfs:comment "Percentage along link that VEHICLE has travelled." ;
    siri:xsdType "xsd:decimal" .

siri:percentile a owl:DatatypeProperty ;
    rdfs:label "Percentile" ;
    rdfs:comment "Percentile associated with range as specified by lower and upper bound. (since SIRI 2.0)" ;
    siri:xsdType "xsd:decimal" .

siri:permissionVersionRef a owl:ObjectProperty ;
    rdfs:label "PermissionVersionRef" ;
    rdfs:comment "Version of permission set." ;
    siri:isReference true ;
    siri:xsdType "VersionRefStructure" .

siri:phoneNumber a owl:DatatypeProperty ;
    rdfs:label "PhoneNumber" ;
    rdfs:comment "Phone number (since SIRI 2.0)" ;
    siri:xsdType "PhoneType" .

siri:placeName a owl:ObjectProperty ;
    rdfs:label "PlaceName" ;
    rdfs:comment "Names of place used to help identify the LINE." ;
    siri:xsdType "NaturalLanguagePlaceNameStructure" .

siri:placeRef a owl:ObjectProperty ;
    rdfs:label "PlaceRef" ;
    rdfs:comment "Reference to a TOPOGRAPHIC PLACE." ;
    siri:isReference true ;
    siri:xsdType "JourneyPlaceRefStructure" .

siri:placeShortName a owl:ObjectProperty ;
    rdfs:label "PlaceShortName" ;
    rdfs:comment "Short name of TOPOGRAPHIC PLACE. Should only be included if the detail level was requested." ;
    siri:xsdType "NaturalLanguagePlaceNameStructure" .

siri:platformTraversal a owl:DatatypeProperty ;
    rdfs:label "PlatformTraversal" ;
    rdfs:comment "For Rail, whether this is a platform traversal at speed, typically triggering an announcement to stand back from platform. If so Boarding Activity of arrival and deparure should be passthrough." ;
    siri:xsdType "xsd:boolean" .

siri:positionOfTrainBlockPart a owl:ObjectProperty ;
    rdfs:label "PositionOfTrainBlockPart" ;
    rdfs:comment "Description of position of train BLOCK part within Train to guide passengers where to find it. E.g. 'Front four coaches'." ;
    siri:xsdType "NaturalLanguageStringStructure" .

siri:pramPlaceCapacity a owl:DatatypeProperty ;
    rdfs:label "PramPlaceCapacity" ;
    rdfs:comment "The number of places on the vehicle that are suitable for prams." ;
    siri:xsdType "xsd:nonNegativeInteger" .

siri:pramsOnboardCount a owl:DatatypeProperty ;
    rdfs:label "PramsOnboardCount" ;
    rdfs:comment "Total number of prams on-board after departing the STOP POINT." ;
    siri:xsdType "xsd:nonNegativeInteger" .

siri:predictionLevel a owl:DatatypeProperty ;
    rdfs:label "PredictionLevel" ;
    rdfs:comment "An approxiimate characterisation of prediction quality as one of five values. (since SIRI 2.0)" ;
    siri:xsdType "QualityIndexEnumeration" .

siri:previousCall a owl:ObjectProperty ;
    rdfs:label "PreviousCall" ;
    siri:xsdType "PreviousCallStructure" .

siri:previousCalls a owl:ObjectProperty ;
    rdfs:label "PreviousCalls" ;
    rdfs:comment "Information on stops called at previously, origin and all intermediate stops up to but not including the current stop, in order or visits. Should only be included if the detail level was requested." ;
    siri:xsdType "PreviousCallsStructure" .

siri:pushchairCapacity a owl:DatatypeProperty ;
    rdfs:label "PushchairCapacity" ;
    rdfs:comment "The number of push chair places on the vehicle." ;
    siri:xsdType "NumberOfPassengers" .

siri:pushchairsOnboardCount a owl:DatatypeProperty ;
    rdfs:label "PushchairsOnboardCount" ;
    rdfs:comment "Total number of pushchairs on-board after departing the STOP POINT." ;
    siri:xsdType "NumberOfPassengers" .

siri:recommendedAction a owl:ObjectProperty ;
    rdfs:label "RecommendedAction" ;
    rdfs:comment "Information on recommendations for passengers on how to deal with the formation change." ;
    siri:xsdType "RecommendedActionStructure" .

siri:recordedAtTime a owl:DatatypeProperty ;
    rdfs:label "RecordedAtTime" ;
    rdfs:comment "Time at which data of individual journey was recorded if differet from that of frame. ((since SIRI 2.0).)" ;
    siri:xsdType "xsd:dateTime" .

siri:recordedCalls a owl:DatatypeProperty ;
    rdfs:label "RecordedCalls" ;
    rdfs:comment "Complete sequence of stops already visited along the route path, in calling order. Only used if observed stop data is being recorded. (SIRI 2.0)" .

siri:relatedJourney a owl:DatatypeProperty ;
    rdfs:label "RelatedJourney" .

siri:reversesAtStop a owl:DatatypeProperty ;
    rdfs:label "ReversesAtStop" ;
    rdfs:comment "Whether VEHICLE will reverse at stop. Default is 'false'." ;
    siri:xsdType "xsd:boolean" .

siri:seatingCapacity a owl:DatatypeProperty ;
    rdfs:label "SeatingCapacity" ;
    rdfs:comment "The seating capacity of the vehicle in number of passengers." ;
    siri:xsdType "NumberOfPassengers" .

siri:signalStatus a owl:DatatypeProperty ;
    rdfs:label "SignalStatus" ;
    rdfs:comment "Status of signal clearance for TRAIN. This may affect the prioritiisition and emphasis given to arrival or departure on displays - e.g. cleared trains appear first, flashing in green." ;
    siri:xsdType "xsd:NMTOKEN" .

siri:situationFullRef a owl:ObjectProperty ;
    rdfs:label "SituationFullRef" ;
    siri:isReference true .

siri:situationSimpleRef a owl:ObjectProperty ;
    rdfs:label "SituationSimpleRef" ;
    siri:isReference true .

siri:specialPlaceCapacity a owl:DatatypeProperty ;
    rdfs:label "SpecialPlaceCapacity" ;
    rdfs:comment "The number of special places on the vehicle, e.g. seats for the disabled or lounge seats." ;
    siri:xsdType "NumberOfPassengers" .

siri:specialPlacesOccupied a owl:DatatypeProperty ;
    rdfs:label "SpecialPlacesOccupied" ;
    rdfs:comment "Total number of special places, e.g. seats for the disabled or lounge seats, that are occupied after departing the STOP POINT." ;
    siri:xsdType "NumberOfPassengers" .

siri:standingCapacity a owl:DatatypeProperty ;
    rdfs:label "StandingCapacity" ;
    rdfs:comment "The standing capacity of the vehicle in number of passengers." ;
    siri:xsdType "NumberOfPassengers" .

siri:targetedCall a owl:DatatypeProperty ;
    rdfs:label "TargetedCall" .

siri:targetedInterchange a owl:ObjectProperty ;
    rdfs:label "TargetedInterchange" ;
    rdfs:comment "Information on any planned distributor connections (deprecated from SIRI V2.0 ... see 2 next attributes)" ;
    siri:xsdType "TargetedInterchangeStructure" .

siri:toServiceJourneyInterchange a owl:ObjectProperty ;
    rdfs:label "ToServiceJourneyInterchange" ;
    rdfs:comment "Information on any planned distributor connections. SIRI 2.0" ;
    siri:xsdType "ToServiceJourneyInterchangeStructure" .

siri:totalCapacity a owl:DatatypeProperty ;
    rdfs:label "TotalCapacity" ;
    rdfs:comment "The total capacity of the vehicle in number of passengers." ;
    siri:xsdType "NumberOfPassengers" .

siri:totalNumberOfReservedSeats a owl:DatatypeProperty ;
    rdfs:label "TotalNumberOfReservedSeats" ;
    rdfs:comment "Total number of booked seats from individual and group reservations." ;
    siri:xsdType "NumberOfPassengers" .

siri:train a owl:DatatypeProperty ;
    rdfs:label "Train" .

siri:trainCode a owl:DatatypeProperty ;
    rdfs:label "TrainCode" ;
    rdfs:comment "Identifier for TRAIN." ;
    siri:xsdType "TrainCodeType" .

siri:trainComponentCode a owl:DatatypeProperty ;
    rdfs:label "TrainComponentCode" ;
    rdfs:comment "Identifier for TRAIN COMPONENT." ;
    siri:xsdType "TrainComponentCodeType" .

siri:trainComponents a owl:DatatypeProperty ;
    rdfs:label "TrainComponents" ;
    rdfs:comment "Ordered collection of TRAIN COMPONENTs making up the TRAIN." .

siri:trainElement a owl:DatatypeProperty ;
    rdfs:label "TrainElement" .

siri:trainElementCode a owl:DatatypeProperty ;
    rdfs:label "TrainElementCode" ;
    rdfs:comment "Identifier for TRAIN ELEMENT." ;
    siri:xsdType "TrainElementCodeType" .

siri:trainElementType a owl:DatatypeProperty ;
    rdfs:label "TrainElementType" ;
    rdfs:comment "Type of TRAIN ELEMENT." ;
    siri:xsdType "TrainElementTypeEnumeration" .

siri:trainInCompoundTrainCode a owl:DatatypeProperty ;
    rdfs:label "TrainInCompoundTrainCode" ;
    rdfs:comment "Identifier for TRAIN IN COMPOUND TRAIN." ;
    siri:xsdType "TrainInCompoundTrainCodeType" .

siri:trainPartRef a owl:ObjectProperty ;
    rdfs:label "TrainPartRef" ;
    rdfs:comment "Reference to a train BLOCK part." ;
    siri:isReference true ;
    siri:xsdType "TrainPartRefStructure" .

siri:trainSizeType a owl:DatatypeProperty ;
    rdfs:label "TrainSizeType" ;
    rdfs:comment "Nature of TRAIN size, e.g \"short\", \"long\", \"normal\". Default is \"normal\"." ;
    siri:xsdType "TrainSizeEnumeration" .

siri:trainStopAssignment a owl:ObjectProperty ;
    rdfs:label "TrainStopAssignment" ;
    rdfs:comment "References to the QUAY on which the particular VEHICLE, i.e., component of the formation, arrives or departs from. If a QUAY is divided into sub-QUAYs or sectors (with the help of STOP ASSIGNMENTs), and a TRAIN COMPONENT spans over multiple sectors of the QUAY, the FORMATION ASSIGNMENT must reference all of them (in multiple STOP ASSIGNMENTs)." ;
    siri:xsdType "StopAssignmentStructure" .

siri:trainsInCompoundTrain a owl:DatatypeProperty ;
    rdfs:label "TrainsInCompoundTrain" ;
    rdfs:comment "Ordered collection of TRAINs making up the COMPOUND TRAIN." .

siri:typeOfActionRef a owl:ObjectProperty ;
    rdfs:label "TypeOfActionRef" ;
    rdfs:comment "Type of the recommendation, e.g. 'unknown', 'replacement' or 'otherRoute'." ;
    siri:isReference true ;
    siri:xsdType "TypeOfValueRefStructure" .

siri:vehicleLocationAtStop a owl:ObjectProperty ;
    rdfs:label "VehicleLocationAtStop" ;
    rdfs:comment "Exact location that VEHICLE will take up / or has taken at STOP POINT." ;
    siri:xsdType "LocationStructure" .

siri:vehicleNumber a owl:DatatypeProperty ;
    rdfs:label "VehicleNumber" ;
    rdfs:comment "Denotes the official \"registration number\" of the vehicle or wagon/coach. In rail transport VEHICLE NUMBER would be equal to the 12-digit UIC wagon/coach number, possibly followed by other combinations of letters, e.g. by the UIC classification of railway coaches." ;
    siri:xsdType "xsd:normalizedString" .

siri:viaPriority a owl:DatatypeProperty ;
    rdfs:label "ViaPriority" ;
    rdfs:comment "Relative priority to give to VIA name in displays. 1=high. Default is 2. (since SIRI 2.0)" ;
    siri:xsdType "xsd:nonNegativeInteger" .

siri:waitUntilTime a owl:DatatypeProperty ;
    rdfs:label "WaitUntilTime" ;
    rdfs:comment "Time up until which the distributor will wait. (since SIRI 2.0)" ;
    siri:xsdType "xsd:dateTime" .

siri:wheelchairPlaceCapacity a owl:DatatypeProperty ;
    rdfs:label "WheelchairPlaceCapacity" ;
    rdfs:comment "The number of wheelchair places on the vehicle." ;
    siri:xsdType "NumberOfPassengers" .

siri:wheelchairsOnboardCount a owl:DatatypeProperty ;
    rdfs:label "WheelchairsOnboardCount" ;
    rdfs:comment "Total number of wheelchairs on-board after departing the STOP POINT." ;
    siri:xsdType "NumberOfPassengers" .

siri:willNotWait a owl:DatatypeProperty ;
    rdfs:label "WillNotWait" ;
    rdfs:comment "Distributor will not wait, i.e., connection is not guaranteed or broken. SIRI 2.0" ;
    siri:xsdType "EmptyType" .

siri:willWait a owl:ObjectProperty ;
    rdfs:label "WillWait" ;
    rdfs:comment "Details about how (long) the distributor services may be held in order to guarantee the connection. (since SIRI 2.0)" ;
    siri:xsdType "WillWaitStructure" .

siri:FormationAssignmentStructure a owl:Class ;
    rdfs:label "FormationAssignment" ;
    rdfs:comment "Assignment of the arrival/departure of a VEHICLE within a formation, e.g. carriage in a TRAIN composition, to a physical QUAY or nested QUAY (i.e. platform or sector of a platform). (since SIRI 2.1)" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:compoundTrainRef ;
            siri:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:trainRef ;
            siri:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:trainInCompoundTrainRef ;
            siri:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:trainElementRef ;
            siri:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:trainComponentRef ;
            siri:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:entranceToVehicleRef ;
            siri:xsdSequenceOrder 6 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:vehicleInFormationStatus ;
            siri:xsdSequenceOrder 7 ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:trainStopAssignment ;
            siri:xsdSequenceOrder 8 ] .

siri:JourneyPlaceRefStructure a owl:Class ;
    rdfs:label "JourneyPlace" ;
    rdfs:comment "Reference to a PLACE visited by a VEHICLE JOURNEY." .

siri:OperatorRefStructure a owl:Class ;
    rdfs:label "Operator" ;
    rdfs:comment "Reference to an OPERATOR." .

siri:PassengerCapacityStructure a owl:Class ;
    rdfs:label "PassengerCapacity" ;
    rdfs:comment "Real-time capacities of a VEHICLE (by fare class), i.e., number of available seats. Alternative way to communicate occupancy measurements. (since SIRI 2.1)" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:compoundTrainRef ;
            siri:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:seatingCapacity ;
            siri:xsdSequenceOrder 10 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:standingCapacity ;
            siri:xsdSequenceOrder 11 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:specialPlaceCapacity ;
            siri:xsdSequenceOrder 12 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:pushchairCapacity ;
            siri:xsdSequenceOrder 13 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:wheelchairPlaceCapacity ;
            siri:xsdSequenceOrder 14 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:pramPlaceCapacity ;
            siri:xsdSequenceOrder 15 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:bicycleRackCapacity ;
            siri:xsdSequenceOrder 16 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:trainRef ;
            siri:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:trainInCompoundTrainRef ;
            siri:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:trainElementRef ;
            siri:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:trainComponentRef ;
            siri:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:entranceToVehicleRef ;
            siri:xsdSequenceOrder 6 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:fareClass ;
            siri:xsdSequenceOrder 7 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:passengerCategory ;
            siri:xsdSequenceOrder 8 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:totalCapacity ;
            siri:xsdSequenceOrder 9 ] .

siri:VehicleOccupancyStructure a owl:Class ;
    rdfs:label "VehicleOccupancy" ;
    rdfs:comment "Real-time occupancies of a VEHICLE (by fare class). Could be feedback from an automatic passenger counting system (APC) or estimated values from statistics. (since SIRI 2.1)" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:compoundTrainRef ;
            siri:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:occupancyPercentage ;
            siri:xsdSequenceOrder 10 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:alightingCount ;
            siri:xsdSequenceOrder 11 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:boardingCount ;
            siri:xsdSequenceOrder 12 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:onboardCount ;
            siri:xsdSequenceOrder 13 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:specialPlacesOccupied ;
            siri:xsdSequenceOrder 14 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:pushchairsOnboardCount ;
            siri:xsdSequenceOrder 15 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:wheelchairsOnboardCount ;
            siri:xsdSequenceOrder 16 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:pramsOnboardCount ;
            siri:xsdSequenceOrder 17 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:bicycleOnboardCount ;
            siri:xsdSequenceOrder 18 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:totalNumberOfReservedSeats ;
            siri:xsdSequenceOrder 19 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:trainRef ;
            siri:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:onProperty siri:groupReservation ;
            siri:xsdSequenceOrder 20 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:trainInCompoundTrainRef ;
            siri:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:trainElementRef ;
            siri:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:trainComponentRef ;
            siri:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:entranceToVehicleRef ;
            siri:xsdSequenceOrder 6 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:fareClass ;
            siri:xsdSequenceOrder 7 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:passengerCategory ;
            siri:xsdSequenceOrder 8 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:occupancyLevel ;
            siri:xsdSequenceOrder 9 ] .

siri:VehicleOrientationRelativeToQuay a owl:Class ;
    rdfs:label "VehicleOrientationRelativeToQuay" ;
    rdfs:comment "Indication of the direction of travel of the vehicle (e.g. TRAIN formation) with respect to the platform, or more precisely the QUAY. (since SIRI 2.1) Examples: - \"towards A\" or \"towards sector A\" if the QUAY is separated into sub-QUAYs or so called sectors. This would be equivalent to the vehicle arriving or departing in the direction of sector A on a QUAY with sectors A-B-C-D. If the arriving vehicle is represented as an arrow, \"towards A\" would be abstracted as \"=> A-B-C-D\". If the departing vehicle is represented as an arrow, \"towards A\" would be abstracted as \"<= A-B-C-D\". - \"towards 0\" or \"towards reference point 0\" if sectors are not available or the QUAY has a reference point, e.g. for measuring the length of the QUAY, identified by \"0\". This would be equivalent to the vehicle arriving or departing in the direction of this reference point. If the arriving vehicle is represented as an arrow, \"towards 0\" would be abstracted as \"=> 0...100\". \"100\" (as in percent) could denote the opposite side of the QUAY (measured at the full length of the QUAY with respect to the reference point). If the departing vehicle is represented as an arrow, \"towards 0\" would be abstracted as \"<= 0...100\". It is advised to specify a reference point that is meaningful for passengers on location." ;
    rdfs:subClassOf siri:NaturalLanguageStringStructure .

siri:accessibilityAssessment a owl:ObjectProperty ;
    rdfs:label "AccessibilityAssessment" ;
    rdfs:comment "Accessibility of the formation or a vehicle within the formation." ;
    siri:xsdType "acsb:AccessibilityAssessmentStructure" .

siri:aimedBoardingPositionName a owl:ObjectProperty ;
    rdfs:label "AimedBoardingPositionName" ;
    rdfs:comment "Scheduled BOARDING POSITION name. Can be used to indicate boarding position change." ;
    siri:xsdType "NaturalLanguageStringStructure" .

siri:aimedBoardingPositionRef a owl:ObjectProperty ;
    rdfs:label "AimedBoardingPositionRef" ;
    rdfs:comment "Physical BOARDING POSITION to use according to the planned timetable." ;
    siri:isReference true ;
    siri:xsdType "BoardingPositionRefStructure" .

siri:aimedFlexibleArea a owl:DatatypeProperty ;
    rdfs:label "AimedFlexibleArea" .

siri:aimedFlexibleAreaRef a owl:ObjectProperty ;
    rdfs:label "AimedFlexibleAreaRef" ;
    rdfs:range siri:AimedFlexibleArea ;
    siri:isReference true .

siri:aimedLocationName a owl:DatatypeProperty ;
    rdfs:label "AimedLocationName" .

siri:aimedQuayName a owl:ObjectProperty ;
    rdfs:label "AimedQuayName" ;
    rdfs:comment "Scheduled Platform name. Can be used to indicate platfrom change. (since SIRI 2.0)" ;
    siri:xsdType "NaturalLanguageStringStructure" .

siri:aimedQuayRef a owl:ObjectProperty ;
    rdfs:label "AimedQuayRef" ;
    rdfs:comment "Physical QUAY to use according to the planned timetable. (since SIRI 2.0)" ;
    siri:isReference true ;
    siri:xsdType "QuayRefStructure" .

siri:arrivalPredictionUnknown a owl:DatatypeProperty ;
    rdfs:label "ArrivalPredictionUnknown" ;
    rdfs:comment "If the producer is (temporarily) not able to deliver real-time predictions (e.g. because of a connection loss), he has various options (and combinations of them) to inform the consumer: (i) set Monitored to 'false' (ii) transmit ExpectedArrivalTime together with \"PredictionInaccurate=true\" (iii) drop/omit ExpectedArrivalTime (iv) set ArrivalStatus to 'noReport' However, this might introduce ambiguity: e.g. option (iii) might be interpreted as \"on time\" by one consumer, but also as \"indefinite delay\" by another consumer. To avoid this, the producer should transmit xxxPredictionUnknown instead of any expected times. (since SIRI 2.1)" ;
    siri:xsdType "EmptyType" .

siri:bearing a owl:DatatypeProperty ;
    rdfs:label "Bearing" ;
    rdfs:comment "Bearing in compass degrees in which VEHICLE is heading." ;
    siri:xsdType "AbsoluteBearingType" .

siri:callInfo a owl:ObjectProperty ;
    rdfs:label "CallInfo" ;
    rdfs:comment "Information about the stop at which the JOURNEY is related to another JOURNEY. (since SIRI 2.1)" ;
    siri:xsdType "RelatedCallStructure" .

siri:checkLineRef a owl:ObjectProperty ;
    rdfs:label "CheckLineRef" ;
    siri:isReference true .

siri:checkOperatorRef a owl:ObjectProperty ;
    rdfs:label "CheckOperatorRef" ;
    siri:isReference true .

siri:confidenceLevel a owl:DatatypeProperty ;
    rdfs:label "ConfidenceLevel" ;
    rdfs:comment "Confidence QUALITY LEVEL of data. Default is 'reliable'." ;
    siri:xsdType "QualityIndexEnumeration" .

siri:dataSource a owl:DatatypeProperty ;
    rdfs:label "DataSource" ;
    rdfs:comment "System originating real-time data. Can be used to make judgements of relative quality and accuracy compared to other feeds." ;
    siri:xsdType "xsd:string" .

siri:datedVehicleJourneyRef a owl:ObjectProperty ;
    rdfs:label "DatedVehicleJourneyRef" ;
    rdfs:comment "A reference to the dated VEHICLE JOURNEY that the VEHICLE is making." ;
    rdfs:range siri:DatedVehicleJourney ;
    siri:isReference true ;
    siri:xsdType "DatedVehicleJourneyCodeType" .

siri:delay a owl:DatatypeProperty ;
    rdfs:label "Delay" ;
    rdfs:comment "Delay of VEHICLE against schedule, to a precision in seconds. Early times are shown as negative values." ;
    siri:xsdType "DurationType" .

siri:departurePredictionUnknown a owl:DatatypeProperty ;
    rdfs:label "DeparturePredictionUnknown" ;
    rdfs:comment "If the producer is (temporarily) not able to deliver real-time predictions (e.g. because of a connection loss), he has various options (and combinations of them) to inform the consumer: (i) set Monitored to 'false' (ii) transmit ExpectedDepartureTime together with \"PredictionInaccurate=true\" (iii) drop/omit ExpectedDepartureTime (iv) set DepartureStatus to 'noReport' However, this might introduce ambiguity: e.g. option (iii) might be interpreted as \"on time\" by one consumer, but also as \"indefinite delay\" by another consumer. To avoid this, the producer should transmit xxxPredictionUnknown instead of any expected times. (since SIRI 2.1)" ;
    siri:xsdType "EmptyType" .

siri:endTimePrecision a owl:DatatypeProperty ;
    rdfs:label "EndTimePrecision" ;
    rdfs:comment "Precision with which to interpret the inclusive end time. Default is to the second." ;
    siri:xsdType "EndTimePrecisionEnumeration" .

siri:engineOn a owl:DatatypeProperty ;
    rdfs:label "EngineOn" ;
    rdfs:comment "Whether the engine of the vehicle is on. Default is 'true' (since SIRI 2.0)" ;
    siri:xsdType "xsd:boolean" .

siri:expectedArrivalPredictionQuality a owl:ObjectProperty ;
    rdfs:label "ExpectedArrivalPredictionQuality" ;
    rdfs:comment "Prediction quality, either as approximate level, or more quantitative percentile range of predictions that will fall within a given range of times. (since SIRI 2.0)" ;
    siri:xsdType "PredictionQualityStructure" .

siri:extraInterchange a owl:DatatypeProperty ;
    rdfs:label "ExtraInterchange" .

siri:extraJourney a owl:DatatypeProperty ;
    rdfs:label "ExtraJourney" ;
    rdfs:comment "Whether this journey is an addition to the plan. Can only be used when both participants recognise the same schedule version. If omitted, defaults to false: the journey is not an addition." ;
    siri:xsdType "xsd:boolean" .

siri:fareClass a owl:DatatypeProperty ;
    rdfs:label "FareClass" ;
    rdfs:comment "Fare class in VEHICLE for which occupancy or capacities are specified." ;
    siri:xsdType "FareClassEnumeration" .

siri:fromStopPointRef a owl:ObjectProperty ;
    rdfs:label "FromStopPointRef" ;
    rdfs:comment "Reference to the SCHEDULED STOP POINT at which the related JOURNEY PART begins." ;
    siri:isReference true ;
    siri:xsdType "StopPointRefStructure" .

siri:inCongestion a owl:DatatypeProperty ;
    rdfs:label "InCongestion" ;
    rdfs:comment "Whether the VEHICLE iis in traffic congestion. If not, present, not known." ;
    siri:xsdType "xsd:boolean" .

siri:inPanic a owl:DatatypeProperty ;
    rdfs:label "InPanic" ;
    rdfs:comment "Whether the panic alarm on the VEHICLE is activated. This may lead to indeterminate predictions. If absent, default is 'false'." ;
    siri:xsdType "xsd:boolean" .

siri:isCompleteStopSequence a owl:DatatypeProperty ;
    rdfs:label "IsCompleteStopSequence" ;
    rdfs:comment "Whether the above CALL sequence is complete, i.e. represents every CALL of the ROUTE and so can be used to replace a previous CALL sequence. Default is 'false'." ;
    siri:xsdType "xsd:boolean" .

siri:journeyPartRef a owl:ObjectProperty ;
    rdfs:label "JourneyPartRef" ;
    rdfs:comment "Reference to a JOURNEY part. (since SIRI 2.0)" ;
    siri:isReference true ;
    siri:xsdType "xsd:normalizedString" .

siri:journeyRelations a owl:ObjectProperty ;
    rdfs:label "JourneyRelations" ;
    rdfs:comment "Relations of the journey with other journeys, e.g., in case a joining/splitting takes place or the journey substitutes for another one etc." ;
    siri:xsdType "JourneyRelationsStructure" .

siri:label a owl:ObjectProperty ;
    rdfs:label "Label" ;
    rdfs:comment "Specifies how the TRAIN ELEMENT is labeled within the context of the TRAIN. This advertised label or number, e.g. \"Carriage B\" or \"23\", can be used for seat reservations and passenger orientation." ;
    siri:xsdType "NaturalLanguageStringStructure" .

siri:locationRecordedAtTime a owl:DatatypeProperty ;
    rdfs:label "LocationRecordedAtTime" ;
    rdfs:comment "Time at which location was recorded. If not present assume that the recorded at time on the containing delivery." ;
    siri:xsdType "xsd:dateTime" .

siri:monitoringError a owl:DatatypeProperty ;
    rdfs:label "MonitoringError" ;
    rdfs:comment "If Monitored is 'false', a (list of) reason(s) for non-availability of real-time data. Examples are \"GPS\", \"GPRS\", \"Radio\" etc. MonitoringError must not be used if Monitored is omitted or set to 'true'." ;
    siri:xsdType "xsd:NMTOKENS" .

siri:passengerCategory a owl:ObjectProperty ;
    rdfs:label "PassengerCategory" ;
    rdfs:comment "Adult, child, wheelchair etc." ;
    siri:xsdType "NaturalLanguageStringStructure" .

siri:progressRate a owl:DatatypeProperty ;
    rdfs:label "ProgressRate" ;
    rdfs:comment "Rate of progress of VEHICLE. Default is 'normal'" ;
    siri:xsdType "ProgressRateEnumeration" .

siri:progressStatus a owl:ObjectProperty ;
    rdfs:label "ProgressStatus" ;
    rdfs:comment "An arbitrary textual status description of the running of this VEHICLE JOURNEY. (Unbounded 0:* since SIRI 2.0)" ;
    siri:xsdType "NaturalLanguageStringStructure" .

siri:quayType a owl:DatatypeProperty ;
    rdfs:label "QuayType" .

siri:reversedOrientation a owl:DatatypeProperty ;
    rdfs:label "ReversedOrientation" ;
    rdfs:comment "Whether orientation of TRAIN ELEMENT within TRAIN is reversed or not. Default is 'false', i.e., they have the same orientation (usually forward in the direction of travel)." ;
    siri:xsdType "xsd:boolean" .

siri:status a owl:DatatypeProperty ;
    rdfs:label "Status" ;
    rdfs:comment "Status of the formation." ;
    siri:xsdType "FormationChangeEnumeration" .

siri:toStopPointRef a owl:ObjectProperty ;
    rdfs:label "ToStopPointRef" ;
    rdfs:comment "Reference to the SCHEDULED STOP POINT at which the related JOURNEY PART ends." ;
    siri:isReference true ;
    siri:xsdType "StopPointRefStructure" .

siri:url a owl:DatatypeProperty ;
    rdfs:label "Url" ;
    rdfs:comment "Url for contact (since SIRI 2.0)" ;
    siri:xsdType "xsd:anyURI" .

siri:vehicleInFormationStatus a owl:ObjectProperty ;
    rdfs:label "VehicleInFormationStatus" ;
    rdfs:comment "Information about a change of a VEHICLE within the formation, e.g., whether a VEHICLE is open, booked or has defective doors." ;
    siri:xsdType "VehicleInFormationStatusStructure" .

siri:vehicleLocation a owl:ObjectProperty ;
    rdfs:label "VehicleLocation" ;
    rdfs:comment "Current geospatial location of VEHICLE. Measured to front of vehicle." ;
    siri:xsdType "LocationStructure" .

siri:vehicleStatus a owl:DatatypeProperty ;
    rdfs:label "VehicleStatus" ;
    rdfs:comment "An classification of the progress state of running of this VEHICLE JOURNEY. (since SIRI 2.0)" ;
    siri:xsdType "VehicleStatusEnumeration" .

siri:velocity a owl:DatatypeProperty ;
    rdfs:label "Velocity" ;
    rdfs:comment "Velocity of VEHICLE. EIther actual speed or average speed may be used. (since SIRI 2.0)" ;
    siri:xsdType "VelocityType" .

siri:AbstractMonitoredCallStructure a owl:Class ;
    rdfs:label "AbstractMonitoredCall" ;
    rdfs:comment "Type for Abstract CALL at stop." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:stopPointRef ;
            siri:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:visitNumber ;
            siri:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:order ;
            siri:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:onProperty siri:stopPointName ;
            siri:xsdSequenceOrder 4 ] .

siri:ConnectingJourneyRefStructure a owl:Class ;
    rdfs:label "ConnectingJourney" ;
    rdfs:comment "Type for a reference to a connecting journey." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:framedVehicleJourneyRef ;
            siri:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:datedVehicleJourneyIndirectRef ;
            siri:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:lineRef ;
            siri:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:trainNumberRef ;
            siri:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:operatorRef ;
            siri:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:participantRef ;
            siri:xsdSequenceOrder 6 ] .

siri:StopPointRefStructure a owl:Class ;
    rdfs:label "StopPoint" ;
    rdfs:comment "Reference to a SCHEDULED STOP POINT." .

siri:actualArrivalTime a owl:DatatypeProperty ;
    rdfs:label "ActualArrivalTime" .

siri:actualDepartureTime a owl:DatatypeProperty ;
    rdfs:label "ActualDepartureTime" .

siri:additionalVehicleJourneyRef a owl:ObjectProperty ;
    rdfs:label "AdditionalVehicleJourneyRef" ;
    rdfs:comment "Refercence to other VEHICLE Journeys ((since SIRI 2.0))" ;
    siri:isReference true ;
    siri:xsdType "FramedVehicleJourneyRefStructure" .

siri:compoundTrains a owl:DatatypeProperty ;
    rdfs:label "CompoundTrains" .

siri:datedVehicleJourneyIndirectRef a owl:ObjectProperty ;
    rdfs:label "DatedVehicleJourneyIndirectRef" ;
    rdfs:comment "Optionally identify the VEHICLE JOURNEY indirectly by origin and destination and the scheduled times at these stops." ;
    siri:isReference true ;
    siri:xsdType "DatedVehicleJourneyIndirectRefStructure" .

siri:distanceFromStop a owl:DatatypeProperty ;
    rdfs:label "DistanceFromStop" ;
    rdfs:comment "Distance of VEHICLE from stop of CALL as measured along ROUTE track. Only shown if detail level is 'calls' or higher. Positive value denotes distance before stop. (since SIRI 2.0)." ;
    siri:xsdType "DistanceType" .

siri:driverName a owl:DatatypeProperty ;
    rdfs:label "DriverName" ;
    rdfs:comment "The name oo the Driver or Crew (since SIRI 2.0)" ;
    siri:xsdType "xsd:normalizedString" .

siri:driverRef a owl:ObjectProperty ;
    rdfs:label "DriverRef" ;
    rdfs:comment "A reference to the DRIVER or Crew currently logged in to operate a monitored VEHICLE. May be omitted if real-time data is not available - i.e. it is timetabled data. (since SIRI 2.0)" ;
    siri:isReference true ;
    siri:xsdType "xsd:normalizedString" .

siri:earliestExpectedDepartureTime a owl:DatatypeProperty ;
    rdfs:label "EarliestExpectedDepartureTime" ;
    rdfs:comment "Earliest time at which VEHICLE may leave the stop. Used to secure connections. Used for passenger announcements. Passengers must be at boarding point by this time to be sure of catching VEHICLE. i.e. \"Vehicle will not leave before this time\" - may be revised from original aimed time. (since SIRI 2.0)" ;
    siri:xsdType "xsd:dateTime" .

siri:euroClass a owl:DatatypeProperty ;
    rdfs:label "EuroClass" ;
    rdfs:comment "Euroclass of the vehicle type. Corresponds to the 12-digit European Identification Number (EIN)." ;
    siri:xsdType "xsd:normalizedString" .

siri:expectedDepartureCapacities a owl:DatatypeProperty ;
    rdfs:label "ExpectedDepartureCapacities" .

siri:expectedDepartureOccupancy a owl:DatatypeProperty ;
    rdfs:label "ExpectedDepartureOccupancy" .

siri:expectedDeparturePredictionQuality a owl:ObjectProperty ;
    rdfs:label "ExpectedDeparturePredictionQuality" ;
    rdfs:comment "Prediction quality, either as approximate level, or more quantitative percentile range of predictions that will fall within a given range of times. (since SIRI 2.0)" ;
    siri:xsdType "PredictionQualityStructure" .

siri:expectedLatestPassengerAccessTime a owl:DatatypeProperty ;
    rdfs:label "ExpectedLatestPassengerAccessTime" .

siri:extraCall a owl:DatatypeProperty ;
    rdfs:label "ExtraCall" ;
    rdfs:comment "Whether this DATED CALL is an addition to the plan. Can only be used when both participants recognise the same schedule version. If omitted, defaults to false: the journey is not an addition." ;
    siri:xsdType "xsd:boolean" .

siri:facilities a owl:DatatypeProperty ;
    rdfs:label "Facilities" ;
    rdfs:comment "Facilities of VEHICLE TYPE." .

siri:hasHoist a owl:DatatypeProperty ;
    rdfs:label "HasHoist" ;
    rdfs:comment "Whether vehicle has hoist for wheelchair access." ;
    siri:xsdType "xsd:boolean" .

siri:hasLiftOrRamp a owl:DatatypeProperty ;
    rdfs:label "HasLiftOrRamp" ;
    rdfs:comment "Whether vehicle has lift or ramp to facilitate wheelchair access." ;
    siri:xsdType "xsd:boolean" .

siri:height a owl:DatatypeProperty ;
    rdfs:label "Height" ;
    rdfs:comment "The length of a VEHICLE of the type." ;
    siri:xsdType "LengthType" .

siri:interchangeRef a owl:ObjectProperty ;
    rdfs:label "InterchangeRef" ;
    siri:isReference true .

siri:latestExpectedArrivalTime a owl:DatatypeProperty ;
    rdfs:label "LatestExpectedArrivalTime" ;
    rdfs:comment "Latest time at which a VEHICLE will arrive at stop. (since SIRI 2.1)" ;
    siri:xsdType "xsd:dateTime" .

siri:length a owl:DatatypeProperty ;
    rdfs:label "Length" ;
    rdfs:comment "The length of a VEHICLE of the type." ;
    siri:xsdType "LengthType" .

siri:lowFloor a owl:DatatypeProperty ;
    rdfs:label "LowFloor" ;
    rdfs:comment "Whether Vehicle is low floor to facilitate access by the mobility impaired." ;
    siri:xsdType "xsd:boolean" .

siri:maximumPassengerCapacities a owl:DatatypeProperty ;
    rdfs:label "MaximumPassengerCapacities" ;
    rdfs:comment "Break down of capacities by FARE CLASS, i.e., maximum number of passengers that TRAIN ELEMENT can carry." .

siri:numberOfStopsAway a owl:DatatypeProperty ;
    rdfs:label "NumberOfStopsAway" ;
    rdfs:comment "Count of stops along SERVICE PATTERN between current position of VEHICLE and stop of CALL as measured along ROUTE track. Only shown if detail level is 'calls' or higher. (since SIRI 2.0)." ;
    siri:xsdType "xsd:nonNegativeInteger" .

siri:provisionalExpectedDepartureTime a owl:DatatypeProperty ;
    rdfs:label "ProvisionalExpectedDepartureTime" ;
    rdfs:comment "Expected departure time of VEHICLE without waiting time due to operational actions. For people at stop this would normally be shown if different from Expected departure time. So if servcie decides not to wait may leave earler than expected departure time (since SIRI 2.0)." ;
    siri:xsdType "xsd:dateTime" .

siri:reasonForRemoval a owl:DatatypeProperty ;
    rdfs:label "ReasonForRemoval" .

siri:reversingDirection a owl:DatatypeProperty ;
    rdfs:label "ReversingDirection" ;
    rdfs:comment "Whether vehicles of the type have a reversing direction." ;
    siri:xsdType "xsd:boolean" .

siri:selfPropelled a owl:DatatypeProperty ;
    rdfs:label "SelfPropelled" ;
    rdfs:comment "Whether vehicles of the type are self-propelled." ;
    siri:xsdType "xsd:boolean" .

siri:trainBlockPart a owl:ObjectProperty ;
    rdfs:label "TrainBlockPart" ;
    rdfs:comment "If a VEHICLE JOURNEY is a coupled journey, i.e. comprises several coupled BLOCKparts, there will be a separate delivery for each BLOCKp art and this element will indicate the vehicles that the journey part uses." ;
    siri:xsdType "TrainBlockPartStructure" .

siri:trainElements a owl:DatatypeProperty ;
    rdfs:label "TrainElements" .

siri:trainNumberRef a owl:ObjectProperty ;
    rdfs:label "TrainNumberRef" ;
    rdfs:comment "Reference to TRAIN NUMBER of journey." ;
    siri:isReference true ;
    siri:xsdType "TrainNumberRefStructure" .

siri:trains a owl:DatatypeProperty ;
    rdfs:label "Trains" .

siri:typeOfFuel a owl:DatatypeProperty ;
    rdfs:label "TypeOfFuel" ;
    rdfs:comment "The type of fuel used by a vehicle of the type." ;
    siri:xsdType "TypeOfFuelEnumeration" .

siri:vehicleAtStop a owl:DatatypeProperty ;
    rdfs:label "VehicleAtStop" .

siri:weight a owl:DatatypeProperty ;
    rdfs:label "Weight" ;
    rdfs:comment "The weight of a VEHICLE of the type." ;
    siri:xsdType "WeightType" .

siri:width a owl:DatatypeProperty ;
    rdfs:label "Width" ;
    rdfs:comment "The width of a VEHICLE of the type." ;
    siri:xsdType "LengthType" .

siri:AbstractServiceJourneyInterchangeStructure a owl:Class ;
    rdfs:label "AbstractServiceJourneyInterchange" ;
    rdfs:comment "A planned SERVICE JOURNEY INTERCHANGE between two journeys. (since SIRI 2.0)" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:interchangeCode ;
            siri:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:feederStopOrder ;
            siri:xsdSequenceOrder 10 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:aimedArrivalTimeOfFeeder ;
            siri:xsdSequenceOrder 11 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:distributorRef ;
            siri:xsdSequenceOrder 12 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:distributorDepartureStopRef ;
            siri:xsdSequenceOrder 13 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:distributorVisitNumber ;
            siri:xsdSequenceOrder 14 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:distributorStopOrder ;
            siri:xsdSequenceOrder 15 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:aimedDepartureTimeOfDistributor ;
            siri:xsdSequenceOrder 16 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:staySeated ;
            siri:xsdSequenceOrder 17 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:guaranteed ;
            siri:xsdSequenceOrder 18 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:advertised ;
            siri:xsdSequenceOrder 19 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:interchangeRef ;
            siri:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:standardWaitTime ;
            siri:xsdSequenceOrder 20 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:maximumWaitTime ;
            siri:xsdSequenceOrder 21 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:maximumAutomaticWaitTime ;
            siri:xsdSequenceOrder 22 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:standardTransferTime ;
            siri:xsdSequenceOrder 23 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:minimumTransferTime ;
            siri:xsdSequenceOrder 24 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:maximumTransferTime ;
            siri:xsdSequenceOrder 25 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:extensions ;
            siri:xsdSequenceOrder 26 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:connectionLinkRef ;
            siri:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:extraInterchange ;
            siri:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:cancellation ;
            siri:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:reasonForRemoval ;
            siri:xsdSequenceOrder 6 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:feederRef ;
            siri:xsdSequenceOrder 7 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:feederArrivalStopRef ;
            siri:xsdSequenceOrder 8 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:feederVisitNumber ;
            siri:xsdSequenceOrder 9 ] ;
    siri:abstract true .

siri:arrivalCancellationReason a owl:DatatypeProperty ;
    rdfs:label "ArrivalCancellationReason" .

siri:arrivalOrientationRelativeToQuay a owl:DatatypeProperty ;
    rdfs:label "ArrivalOrientationRelativeToQuay" .

siri:arrivalProximityText a owl:DatatypeProperty ;
    rdfs:label "ArrivalProximityText" .

siri:arrivalStatus a owl:DatatypeProperty ;
    rdfs:label "ArrivalStatus" .

siri:blockRef a owl:ObjectProperty ;
    rdfs:label "BlockRef" ;
    rdfs:comment "BLOCK that VEHICLE is running." ;
    siri:isReference true ;
    siri:xsdType "BlockRefStructure" .

siri:boardingStretch a owl:DatatypeProperty ;
    rdfs:label "BoardingStretch" ;
    rdfs:comment "Whether this is a Hail and Ride Stop. Default is 'false'." ;
    siri:xsdType "xsd:boolean" .

siri:callNote a owl:ObjectProperty ;
    rdfs:label "CallNote" ;
    rdfs:comment "Text annotation that applies to this call." ;
    siri:xsdType "NaturalLanguageStringStructure" .

siri:courseOfJourneyRef a owl:ObjectProperty ;
    rdfs:label "CourseOfJourneyRef" ;
    rdfs:comment "COURSE OF JOURNEY ('Run') that VEHICLE is running." ;
    siri:isReference true ;
    siri:xsdType "CourseOfJourneyRefStructure" .

siri:departureCancellationReason a owl:DatatypeProperty ;
    rdfs:label "DepartureCancellationReason" .

siri:departureOrientationRelativeToQuay a owl:DatatypeProperty ;
    rdfs:label "DepartureOrientationRelativeToQuay" .

siri:departureProximityText a owl:DatatypeProperty ;
    rdfs:label "DepartureProximityText" .

siri:departureStatus a owl:DatatypeProperty ;
    rdfs:label "DepartureStatus" .

siri:destinationAimedArrivalTime a owl:DatatypeProperty ;
    rdfs:label "DestinationAimedArrivalTime" ;
    rdfs:comment "Timetabled arrival time at Destination." ;
    siri:xsdType "xsd:dateTime" .

siri:entranceToVehicleRef a owl:ObjectProperty ;
    rdfs:label "EntranceToVehicleRef" ;
    siri:isReference true .

siri:expectedHeadwayInterval a owl:DatatypeProperty ;
    rdfs:label "ExpectedHeadwayInterval" .

siri:monitored a owl:DatatypeProperty ;
    rdfs:label "Monitored" ;
    rdfs:comment "Whether VEHICLE JOURNEYs of LINE are normally monitored. Provides a default value for the Monitored element on individual journeys of the timetable." ;
    siri:xsdType "xsd:boolean" .

siri:name a owl:ObjectProperty ;
    rdfs:label "Name" ;
    rdfs:comment "Name of VEHICLE TYPE." ;
    siri:xsdType "NaturalLanguageStringStructure" .

siri:occupancy a owl:DatatypeProperty ;
    rdfs:label "Occupancy" .

siri:originAimedDepartureTime a owl:DatatypeProperty ;
    rdfs:label "OriginAimedDepartureTime" ;
    rdfs:comment "Timetabled departure time from Origin." ;
    siri:xsdType "xsd:dateTime" .

siri:predictionInaccurate a owl:DatatypeProperty ;
    rdfs:label "PredictionInaccurate" .

siri:predictionInaccurateReason a owl:DatatypeProperty ;
    rdfs:label "PredictionInaccurateReason" .

siri:privateCode a owl:DatatypeProperty ;
    rdfs:label "PrivateCode" ;
    siri:xsdType "xsd:normalizedString" .

siri:requestStop a owl:DatatypeProperty ;
    rdfs:label "RequestStop" ;
    rdfs:comment "Whether Vehicle stops only if requested explicitly by passenger. Default is 'false'." ;
    siri:xsdType "xsd:boolean" .

siri:shortName a owl:ObjectProperty ;
    rdfs:label "ShortName" ;
    rdfs:comment "Short Name of VEHICLE TYPE." ;
    siri:xsdType "NaturalLanguageStringStructure" .

siri:trainInCompoundTrainRef a owl:ObjectProperty ;
    rdfs:label "TrainInCompoundTrainRef" ;
    rdfs:range siri:TrainInCompoundTrain ;
    siri:isReference true .

siri:trainNumbers a owl:DatatypeProperty ;
    rdfs:label "TrainNumbers" ;
    rdfs:comment "TRAIN NUMBERs for journey. (since SIRI 2.0)" .

siri:vehicleJourneyRef a owl:ObjectProperty ;
    rdfs:label "VehicleJourneyRef" ;
    siri:isReference true .

siri:vehicleRef a owl:ObjectProperty ;
    rdfs:label "VehicleRef" ;
    rdfs:range siri:Vehicle ;
    siri:isReference true .

siri:aimedLatestPassengerAccessTime a owl:DatatypeProperty ;
    rdfs:label "AimedLatestPassengerAccessTime" .

siri:branding a owl:ObjectProperty ;
    rdfs:label "Branding" ;
    rdfs:comment "An arbitrary marketing classification. (since SIRI 2.1)" ;
    siri:xsdType "BrandingStructure" .

siri:brandingRef a owl:ObjectProperty ;
    rdfs:label "BrandingRef" ;
    rdfs:comment "Reference to a BRANDING. (since SIRI 2.1)" ;
    siri:isReference true ;
    siri:xsdType "BrandingRefStructure" .

siri:destinationDisplay a owl:ObjectProperty ;
    rdfs:label "DestinationDisplay" ;
    rdfs:comment "Description of the destination stop (vehicle signage) to show on vehicle, Can be overwritten for a journey, and then also section by section by the entry in an Individual Call. (Unbounded since SIRI 2.0)" ;
    siri:xsdType "NaturalLanguageStringStructure" .

siri:distributorRef a owl:ObjectProperty ;
    rdfs:label "DistributorRef" ;
    siri:isReference true .

siri:expectedArrivalTime a owl:DatatypeProperty ;
    rdfs:label "ExpectedArrivalTime" .

siri:expectedDepartureTime a owl:DatatypeProperty ;
    rdfs:label "ExpectedDepartureTime" .

siri:externalLineRef a owl:ObjectProperty ;
    rdfs:label "ExternalLineRef" ;
    rdfs:comment "Alternative identifier of LINE that an external system may associate with journey." ;
    siri:isReference true ;
    siri:xsdType "LineRefStructure" .

siri:feederRef a owl:ObjectProperty ;
    rdfs:label "FeederRef" ;
    siri:isReference true .

siri:firstOrLastJourney a owl:DatatypeProperty ;
    rdfs:label "FirstOrLastJourney" ;
    rdfs:comment "Whether journey is first or last jouurney of day. (since SIRI 2.0)" ;
    siri:xsdType "FirstOrLastJourneyEnumeration" .

siri:groupOfLinesRef a owl:ObjectProperty ;
    rdfs:label "GroupOfLinesRef" ;
    rdfs:comment "Reference to a GROUP OF LINEs to which journey belongs. SIRI 2.0" ;
    siri:isReference true ;
    siri:xsdType "GroupOfLinesRefStructure" .

siri:headwayService a owl:DatatypeProperty ;
    rdfs:label "HeadwayService" ;
    rdfs:comment "Whether this is a Headway Service, that is, one shown as operating at a prescribed interval rather than to a fixed timetable." ;
    siri:xsdType "xsd:boolean" .

siri:journeyNote a owl:DatatypeProperty ;
    rdfs:label "JourneyNote" .

siri:journeyParts a owl:DatatypeProperty ;
    rdfs:label "JourneyParts" ;
    rdfs:comment "JOURNEY PARTs making up JOURNEY +SIRIv2.0 e." .

siri:journeyPatternName a owl:ObjectProperty ;
    rdfs:label "JourneyPatternName" ;
    rdfs:comment "Name of Joruney Pattern" ;
    siri:xsdType "NaturalLanguageStringStructure" .

siri:journeyPatternRef a owl:ObjectProperty ;
    rdfs:label "JourneyPatternRef" ;
    rdfs:comment "Identifier of JOURNEY PATTERN that journey follows." ;
    siri:isReference true ;
    siri:xsdType "JourneyPatternRefStructure" .

siri:operationsContact a owl:ObjectProperty ;
    rdfs:label "OperationsContact" ;
    rdfs:comment "Contact details for use by operational staff. (since SIRI 2.0)" ;
    siri:xsdType "SimpleContactStructure" .

siri:originDisplay a owl:ObjectProperty ;
    rdfs:label "OriginDisplay" ;
    rdfs:comment "Description of the origin stop (vehicle signage) to show on vehicle, Can be overwritten for a journey, and then also section by section by the entry in an Individual Call. (since SIRI 2.0)" ;
    siri:xsdType "NaturalLanguageStringStructure" .

siri:publicContact a owl:ObjectProperty ;
    rdfs:label "PublicContact" ;
    rdfs:comment "Contact details for use by members of public. (since SIRI 2.0)" ;
    siri:xsdType "SimpleContactStructure" .

siri:publishedLineName a owl:DatatypeProperty ;
    rdfs:label "PublishedLineName" ;
    rdfs:comment "Name or Number by which the LINE is known to the public. (Unbounded since SIRI 2.0)" .

siri:recordedDepartureCapacities a owl:DatatypeProperty ;
    rdfs:label "RecordedDepartureCapacities" .

siri:recordedDepartureOccupancy a owl:DatatypeProperty ;
    rdfs:label "RecordedDepartureOccupancy" .

siri:routeRef a owl:ObjectProperty ;
    rdfs:label "RouteRef" ;
    rdfs:comment "Identifier of ROUTE that journey follows." ;
    siri:isReference true ;
    siri:xsdType "RouteRefStructure" .

siri:trainComponentRef a owl:ObjectProperty ;
    rdfs:label "TrainComponentRef" ;
    rdfs:range siri:TrainComponent ;
    siri:isReference true .

siri:trainElementRef a owl:ObjectProperty ;
    rdfs:label "TrainElementRef" ;
    rdfs:range siri:TrainElement ;
    siri:isReference true .

siri:vehicleJourneyName a owl:ObjectProperty ;
    rdfs:label "VehicleJourneyName" ;
    rdfs:comment "For train services with named journeys. Train name, e.g. “West Coast Express”. If omitted: No train name. Inherited property. (Unbounded since SIRI 2.0)" ;
    siri:xsdType "NaturalLanguageStringStructure" .

siri:vehicleMode a owl:DatatypeProperty ;
    rdfs:label "VehicleMode" ;
    rdfs:comment "A means of transportation such as bus, rail, etc." ;
    siri:xsdType "VehicleModesEnumeration" .

siri:advertised a owl:DatatypeProperty ;
    rdfs:label "Advertised" ;
    rdfs:comment "Whether the SERVICE JOURNEY INTERCHANGE is advertised as a connection. Default is 'false'." ;
    siri:xsdType "xsd:boolean" .

siri:aimedArrivalTimeOfFeeder a owl:DatatypeProperty ;
    rdfs:label "AimedArrivalTimeOfFeeder" .

siri:aimedDepartureTimeOfDistributor a owl:DatatypeProperty ;
    rdfs:label "AimedDepartureTimeOfDistributor" .

siri:aimedHeadwayInterval a owl:DatatypeProperty ;
    rdfs:label "AimedHeadwayInterval" .

siri:arrivalBoardingActivity a owl:DatatypeProperty ;
    rdfs:label "ArrivalBoardingActivity" .

siri:arrivalFormationAssignment a owl:DatatypeProperty ;
    rdfs:label "ArrivalFormationAssignment" .

siri:arrivalOperatorRefs a owl:DatatypeProperty ;
    rdfs:label "ArrivalOperatorRefs" .

siri:arrivalPlatformName a owl:DatatypeProperty ;
    rdfs:label "ArrivalPlatformName" .

siri:arrivalStopAssignment a owl:ObjectProperty ;
    rdfs:label "ArrivalStopAssignment" ;
    rdfs:comment "Assignment of planned arrival at scheduled STOP POINT to a phsyical QUAY (platform). If not given, assume same as for departure. (since SIRI 2.0)." ;
    siri:xsdType "PlannedStopAssignmentStructure" .

siri:compoundTrainRef a owl:ObjectProperty ;
    rdfs:label "CompoundTrainRef" ;
    rdfs:range siri:CompoundTrain ;
    siri:isReference true .

siri:controlActionRef a owl:ObjectProperty ;
    rdfs:label "ControlActionRef" ;
    rdfs:comment "Reference to a ControlAction having possible consequences on the EstimatedVehicleJourney. Note that if the ControlAction is the master ControlAction of a GroupOfControlActions it is assumed that the refence is valid for all the ControlActions of the group." ;
    siri:isReference true ;
    siri:xsdType "ControlActionRefStructure" .

siri:departureBoardingActivity a owl:DatatypeProperty ;
    rdfs:label "DepartureBoardingActivity" .

siri:departureFormationAssignment a owl:DatatypeProperty ;
    rdfs:label "DepartureFormationAssignment" .

siri:departureOperatorRefs a owl:DatatypeProperty ;
    rdfs:label "DepartureOperatorRefs" .

siri:departurePlatformName a owl:DatatypeProperty ;
    rdfs:label "DeparturePlatformName" .

siri:departureStopAssignment a owl:ObjectProperty ;
    rdfs:label "DepartureStopAssignment" ;
    siri:xsdType "PlannedStopAssignmentStructure" .

siri:destinationDisplayAtOrigin a owl:ObjectProperty ;
    rdfs:label "DestinationDisplayAtOrigin" ;
    rdfs:comment "DIRECTION name shown for jurney at the origin. (since SIRI 2.0)" ;
    siri:xsdType "NaturalLanguagePlaceNameStructure" .

siri:destinationShortName a owl:ObjectProperty ;
    rdfs:label "DestinationShortName" ;
    rdfs:comment "Short name of the DESTINATION.of the journey; used to help identify the VEHICLE JOURNEY on arrival boards. If absent, same as DestinationName. (Unbounded since SIRI 2.0)" ;
    siri:xsdType "NaturalLanguagePlaceNameStructure" .

siri:directionName a owl:ObjectProperty ;
    rdfs:label "DirectionName" ;
    rdfs:comment "Description of the DIRECTION. May correspond to a DESTINATION DISPLAY. (Unbounded since SIRI 2.0)" ;
    siri:xsdType "NaturalLanguageStringStructure" .

siri:distributorDepartureStopRef a owl:ObjectProperty ;
    rdfs:label "DistributorDepartureStopRef" ;
    siri:isReference true .

siri:distributorStopOrder a owl:DatatypeProperty ;
    rdfs:label "DistributorStopOrder" .

siri:endTime a owl:DatatypeProperty ;
    rdfs:label "EndTime" ;
    rdfs:comment "The (inclusive) end date and time." ;
    siri:xsdType "xsd:dateTime" .

siri:facilityChangeElement a owl:DatatypeProperty ;
    rdfs:label "FacilityChangeElement" .

siri:facilityConditionElement a owl:DatatypeProperty ;
    rdfs:label "FacilityConditionElement" ;
    rdfs:comment "Information about a change of Equipment availability at stop or on vehicle that may affect access or use." .

siri:feederArrivalStopRef a owl:ObjectProperty ;
    rdfs:label "FeederArrivalStopRef" ;
    siri:isReference true .

siri:feederStopOrder a owl:DatatypeProperty ;
    rdfs:label "FeederStopOrder" .

siri:feederVisitNumber a owl:DatatypeProperty ;
    rdfs:label "FeederVisitNumber" .

siri:formationCondition a owl:DatatypeProperty ;
    rdfs:label "FormationCondition" ;
    rdfs:comment "Information about a change of the formation (e.g. TRAIN composition) or changes of vehicles within the formation. (since SIRI 2.1)" .

siri:guaranteed a owl:DatatypeProperty ;
    rdfs:label "Guaranteed" ;
    rdfs:comment "Whether the SERVICE JOURNEY INTERCHANGE is guaranteed. Default is 'false'; SERVICE JOURNEY INTERCHANGE is not guaranteed." ;
    siri:xsdType "xsd:boolean" .

siri:interchangeCode a owl:DatatypeProperty ;
    rdfs:label "InterchangeCode" .

siri:maximumAutomaticWaitTime a owl:DatatypeProperty ;
    rdfs:label "MaximumAutomaticWaitTime" ;
    rdfs:comment "Maximum automatic wait time that Distributor will wait for Feeder for INTERCHANGE. (since SIRI 2.0)" ;
    siri:xsdType "xsd:duration" .

siri:maximumTransferTime a owl:DatatypeProperty ;
    rdfs:label "MaximumTransferTime" ;
    rdfs:comment "Maximum transfer duration for INTERCHANGE. SIRI v2,0" ;
    siri:xsdType "xsd:duration" .

siri:maximumWaitTime a owl:DatatypeProperty ;
    rdfs:label "MaximumWaitTime" ;
    rdfs:comment "Maximum time that Distributor will wait for Feeder for INTERCHANGE. SIRI v1.0" ;
    siri:xsdType "xsd:duration" .

siri:minimumTransferTime a owl:DatatypeProperty ;
    rdfs:label "MinimumTransferTime" ;
    rdfs:comment "Minimum transfer duration for INTERCHANGE. SIRI v2,0" ;
    siri:xsdType "xsd:duration" .

siri:originDisplayAtDestination a owl:ObjectProperty ;
    rdfs:label "OriginDisplayAtDestination" ;
    rdfs:comment "Origin name shown for jourey at the destination (since SIRI 2.0)" ;
    siri:xsdType "NaturalLanguagePlaceNameStructure" .

siri:originName a owl:ObjectProperty ;
    rdfs:label "OriginName" ;
    rdfs:comment "Name of the origin of the journey. (Unbounded since SIRI 2.0)" ;
    siri:xsdType "NaturalLanguagePlaceNameStructure" .

siri:originShortName a owl:ObjectProperty ;
    rdfs:label "OriginShortName" ;
    rdfs:comment "Short name of the origin of the journey; used to help identify the VEHICLE JOURNEY on arrival boards. If absent, same as Origin Name." ;
    siri:xsdType "NaturalLanguagePlaceNameStructure" .

siri:productCategoryRef a owl:ObjectProperty ;
    rdfs:label "ProductCategoryRef" ;
    rdfs:comment "Product Classification of VEHICLE JOURNEY- subdivides a transport mode. e.g. express, loacl." ;
    rdfs:range siri:ProductCategory ;
    siri:isReference true ;
    siri:xsdType "ProductCategoryRefStructure" .

siri:serviceFeatureRef a owl:ObjectProperty ;
    rdfs:label "ServiceFeatureRef" ;
    rdfs:comment "Classification of service into arbitrary Service categories, e.g. school bus. Recommended SIRI values based on TPEG are given in SIRI documentation and enumerated in the siri_facilities package. Corresponds to NeTEX TYPE OF SERVICe." ;
    rdfs:range siri:ServiceFeature ;
    siri:isReference true .

siri:standardTransferTime a owl:DatatypeProperty ;
    rdfs:label "StandardTransferTime" ;
    rdfs:comment "Standard transfer duration for INTERCHANGE. SIRI v2,0" ;
    siri:xsdType "xsd:duration" .

siri:standardWaitTime a owl:DatatypeProperty ;
    rdfs:label "StandardWaitTime" ;
    rdfs:comment "Standard wait time for INTERCHANGE. SIRI v2,0" ;
    siri:xsdType "xsd:duration" .

siri:startTime a owl:DatatypeProperty ;
    rdfs:label "StartTime" ;
    rdfs:comment "The (inclusive) start date and time." ;
    siri:xsdType "xsd:dateTime" .

siri:staySeated a owl:DatatypeProperty ;
    rdfs:label "StaySeated" ;
    rdfs:comment "Whether the passenger can remain in VEHICLE (i.e. BLOCKlinking). Default is 'false': the passenger must change vehicles for this connection." ;
    siri:xsdType "xsd:boolean" .

siri:stopPointName a owl:DatatypeProperty ;
    rdfs:label "StopPointName" ;
    rdfs:comment "Name of SCHEDULED STOP POINT. (Unbounded since SIRI 2.0)" .

siri:timingPoint a owl:DatatypeProperty ;
    rdfs:label "TimingPoint" .

siri:trainRef a owl:ObjectProperty ;
    rdfs:label "TrainRef" ;
    rdfs:range siri:Train ;
    siri:isReference true .

siri:vehicleFeatureRef a owl:ObjectProperty ;
    rdfs:label "VehicleFeatureRef" ;
    rdfs:comment "Features of VEHICLE providing journey. Recommended SIRI values based on TPEG are given in SIRI documentation and enumerated in the siri_facilities package." ;
    rdfs:range siri:VehicleFeature ;
    siri:isReference true ;
    siri:xsdType "VehicleFeatureRefStructure" .

siri:via a owl:ObjectProperty ;
    rdfs:label "Via" ;
    rdfs:comment "Names of VIA points, used to help identify the LINE, for example, Luton to Luton via Sutton. Currently 3 in VDV. Should only be included if the detail level was requested." ;
    siri:xsdType "ViaNameStructure" .

siri:visitNumber a owl:DatatypeProperty ;
    rdfs:label "VisitNumber" .

siri:cancellation a owl:DatatypeProperty ;
    rdfs:label "Cancellation" ;
    rdfs:comment "Whether this journey is a cancellation of a journey in the plan. Can only be used when both participants recognise the same schedule version. If omitted, defaults to 'false': the journey is not cancelled." ;
    siri:xsdType "xsd:boolean" .

siri:connectionLinkRef a owl:ObjectProperty ;
    rdfs:label "ConnectionLinkRef" ;
    siri:isReference true .

siri:destinationName a owl:ObjectProperty ;
    rdfs:label "DestinationName" ;
    rdfs:comment "Description of the destination stop (vehicle signage), Can be overwritten for a journey, and then also section by section by the entry in an individual CALl. (Unbounded since SIRI 2.0)" ;
    siri:xsdType "NaturalLanguageStringStructure" .

siri:directionRef a owl:ObjectProperty ;
    rdfs:label "DirectionRef" ;
    rdfs:comment "Identifer of DIRECTION," ;
    rdfs:range siri:Direction ;
    siri:isReference true ;
    siri:xsdType "DirectionRefStructure" .

siri:distributorVisitNumber a owl:DatatypeProperty ;
    rdfs:label "DistributorVisitNumber" .

siri:framedVehicleJourneyRef a owl:ObjectProperty ;
    rdfs:label "FramedVehicleJourneyRef" ;
    rdfs:comment "Refecence to a VEHICLE JOURNEY framed by the day. SIRI 2.0" ;
    siri:isReference true ;
    siri:xsdType "FramedVehicleJourneyRefStructure" .

siri:lineRef a owl:ObjectProperty ;
    rdfs:label "LineRef" ;
    rdfs:comment "Reference to LINE of journey." ;
    siri:isReference true ;
    siri:xsdType "LineRefStructure" .

siri:originRef a owl:ObjectProperty ;
    rdfs:label "OriginRef" ;
    siri:isReference true .

siri:stopPointRef a owl:ObjectProperty ;
    rdfs:label "StopPointRef" ;
    siri:isReference true .

siri:destinationRef a owl:ObjectProperty ;
    rdfs:label "DestinationRef" ;
    rdfs:comment "Reference to a DESTINATION." ;
    rdfs:range siri:Destination ;
    siri:isReference true .

siri:order a owl:DatatypeProperty ;
    rdfs:label "Order" .

siri:situationRef a owl:ObjectProperty ;
    rdfs:label "SituationRef" ;
    rdfs:range siri:Situation ;
    siri:isReference true .

siri:PermissionsStructure a owl:Class ;
    rdfs:label "Permissions" ;
    rdfs:comment "Type for abstract permissions." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:permissionVersionRef ;
            siri:xsdSequenceOrder 1 ] .

siri:aimedArrivalTime a owl:DatatypeProperty ;
    rdfs:label "AimedArrivalTime" .

siri:description a owl:ObjectProperty ;
    rdfs:label "Description" ;
    rdfs:comment "Description of the status of a formation or a vehicle within the formation." ;
    siri:xsdType "NaturalLanguageStringStructure" .

siri:aimedDepartureTime a owl:DatatypeProperty ;
    rdfs:label "AimedDepartureTime" .

siri:operatorRef a owl:ObjectProperty ;
    rdfs:label "OperatorRef" ;
    rdfs:comment "OPERATOR of a VEHICLE JOURNEY. Note that the operator may change over the course of a journey. This shoudl show teh operator for the curent point in the journey. Use Journey Parts tp record all the operators in the whole journeyh." ;
    siri:isReference true ;
    siri:xsdType "OperatorRefStructure" .

siri:extensions a owl:DatatypeProperty ;
    rdfs:label "Extensions" .

