@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix siri: <https://siri-cen.eu/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

siri:AimedFlexibleAreaRef a owl:Class ;
    rdfs:label "AimedFlexibleAreaRef" ;
    rdfs:subClassOf siri:FlexibleAreaRefStructure ;
    siri:xsdElement true .

siri:AirSubmodesOfTransportEnumeration a rdfs:Datatype ;
    rdfs:label "AirSubmodesOfTransportEnumeration" ;
    rdfs:comment "Values for Air ModesOfTransport: TPEG pti_table_08 and pts_table_108." ;
    owl:oneOf ( "unknown" "undefined" "internationalFlight" "domesticFlight" "intercontinentalFlight" "domesticScheduledFlight" "shuttleFlight" "intercontinentalCharterFlight" "internationalCharterFlight" "roundTripCharterFlight" "sightseeingFlight" "helicopterService" "domesticCharterFlight" "SchengenAreaFlight" "airshipService" "shortHaulInternationalFlight" "internationalAirService" "nationalAirService" "intercontinentalAirService" "nationalScheduledAirService" "shuttleAirService" "intercontinentalAirCharterService" "internationalAirCharterService" "roundTripAirCharterService" "sightseeingAirService" "helicopterAirService" "domesticAirCharterService" "SchengenAreaAirService" "onDemandService" "undefinedAirService" "undefinedAircraftService" "allAirServices" "pti8_0" "pti8_1" "pti8_2" "pti8_3" "pti8_4" "pti8_5" "pti8_6" "pti8_7" "pti8_8" "pti8_9" "pti8_10" "pti8_11" "pti8_12" "pti8_13" "pti8_14" "pti8_255" "loc15_0" "loc15_1" "loc15_2" "loc14_3" "loc15_4" "loc15_5" "loc15_6" "loc15_7" "loc15_8" "loc15_9" "loc15_10" "loc15_255" ) .

siri:AllModesEnumeration a rdfs:Datatype ;
    rdfs:label "AllModesEnumeration" ;
    rdfs:comment "Union of VEHICLE and continuous MODEs." ;
    owl:oneOf ( "walk" "car" "taxi" "cycle" "drt" "movingWalkway" "through" ) .

siri:ArrivalBoardingActivityEnumeration a rdfs:Datatype ;
    rdfs:label "ArrivalBoardingActivityEnumeration" ;
    rdfs:comment "Allowed types activity for Alighting." ;
    owl:oneOf ( "alighting" "noAlighting" "passThru" ) .

siri:ArrivalFormationAssignment a owl:Class ;
    rdfs:label "ArrivalFormationAssignment" ;
    rdfs:subClassOf siri:FormationAssignmentStructure ;
    siri:xsdElement true .

siri:ArrivalOperatorRefs a owl:Class ;
    rdfs:label "ArrivalOperatorRefs" ;
    rdfs:subClassOf siri:OperatorRefStructure ;
    siri:xsdElement true .

siri:ArrivalOrientationRelativeToQuay a owl:Class ;
    rdfs:label "ArrivalOrientationRelativeToQuay" ;
    rdfs:subClassOf siri:VehicleOrientationRelativeToQuay ;
    siri:xsdElement true .

siri:BlockRefStructure a owl:Class ;
    rdfs:label "Block" ;
    rdfs:comment "Type for reference to a BLOCK." .

siri:BoardingActivityEnumeration a rdfs:Datatype ;
    rdfs:label "BoardingActivityEnumeration" ;
    rdfs:comment "Allowed types activity for Boarding and Alighting." ;
    owl:oneOf ( "boardingAndAlighting" "noBoarding" "noAlighting" "passThru" ) .

siri:BrandingRefStructure a owl:Class ;
    rdfs:label "Branding" ;
    rdfs:comment "Type for reference to a BRANDING. (since SIRI 2.1)" .

siri:BrandingStructure a owl:Class ;
    rdfs:label "Branding" ;
    rdfs:comment "An arbitrary marketing classification. (since SIRI 2.1)" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:brandingCode ;
            siri:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:name ;
            siri:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:shortName ;
            siri:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:description ;
            siri:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:image ;
            siri:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:url ;
            siri:xsdSequenceOrder 6 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:privateCode ;
            siri:xsdSequenceOrder 7 ] .

siri:BusSubmodesOfTransportEnumeration a rdfs:Datatype ;
    rdfs:label "BusSubmodesOfTransportEnumeration" ;
    rdfs:comment "Values for Bus ModesOfTransport: TPEG pti_table_05, pts_table_105 and loc_table_10." ;
    owl:oneOf ( "unknown" "undefined" "localBus" "regionalBus" "expressBus" "nightBus" "postBus" "specialNeedsBus" "mobilityBus" "mobilityBusForRegisteredDisabled" "sightseeingBus" "shuttleBus" "highFrequencyBus" "dedicatedLaneBus" "schoolBus" "schoolAndPublicServiceBus" "railReplacementBus" "demandAndResponseBus" "airportLinkBus" "regionalBusService" "additionalBusService" "expressBusService" "stoppingBusService" "localBusService" "nightBusService" "postBusService" "specialNeedsBusService" "mobilityBusService" "mobilityBusForRegisteredDisabledService" "sightseeingBusService" "shuttleBusService" "schoolBusService" "schoolAndPublicServiceBusService" "railReplacementBusService" "demandAndResponseBusService" "undefinedBusService" "bus" "allBusServices" "pti5_0" "pti5_1" "pti5_2" "pti5_3" "pti5_4" "pti5_5" "pti5_6" "pti5_7" "pti5_8" "pti5_9" "pti5_10" "pti5_11" "pti5_12" "pti5_13" "pti5_14" "pti5_15" "pti5_16" "pti5_255" "loc_10" "loc10_0" "loc10_1" "loc10_2" "loc10_4" "loc10_5" "loc10_6" "loc10_7" "loc10_8" "loc10_9" "loc10_13" "loc10_255" ) .

siri:CallStatusEnumeration a rdfs:Datatype ;
    rdfs:label "CallStatusEnumeration" ;
    rdfs:comment "Classification of the timeliness of the CALL, according to a fixed list of values. This may reflect a presentation policy, for example CALLs less than one minute behind target time are still classified as on-time. Applications may use this to guide their own presentation of times." ;
    owl:oneOf ( "onTime" "early" "delayed" "cancelled" "arrived" "departed" "missed" "noReport" "notExpected" ) .

siri:ClearDownRefStructure a owl:Class ;
    rdfs:label "ClearDown" ;
    rdfs:comment "Reference Cleardown identifier of a stop." .

siri:ClosedTimeRangeStructure a owl:Class ;
    rdfs:label "ClosedTimeRange" ;
    rdfs:comment "Type for a range of times. Both start and end time are required." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:startTime ;
            siri:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:endTime ;
            siri:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:endTimePrecision ;
            siri:xsdSequenceOrder 3 ] .

siri:ClosedTimestampRangeStructure a owl:Class ;
    rdfs:label "ClosedTimestampRange" ;
    rdfs:comment "Type for a range of date and times. Both start and end time are required." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:startTime ;
            siri:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:endTime ;
            siri:xsdSequenceOrder 2 ] .

siri:CoachSubmodesOfTransportEnumeration a rdfs:Datatype ;
    rdfs:label "CoachSubmodesOfTransportEnumeration" ;
    rdfs:comment "Values for Coach ModesOfTransport: TPEG pti_table_03 and pts_table_103." ;
    owl:oneOf ( "unknown" "undefined" "internationalCoach" "nationalCoach" "shuttleCoach" "regionalCoach" "specialCoach" "schoolCoach" "sightseeingCoach" "touristCoach" "commuterCoach" "internationalCoachService" "nationalCoachService" "shuttleCoachService" "regionalCoachService" "additionalCoachService" "nightCoachService" "specialCoachService" "sightseeingCoachService" "touristCoachService" "commuterCoachService" "onDemandService" "undefinedCoachService" "allCoachServices" "pti3_0" "pti3_1" "pti3_2" "pti3_3" "pti3_4" "pti3_5" "pti3_6" "pti3_7" "pti3_8" "pti3_9" "pti3_255" ) .

siri:CompoundTrainRef a owl:Class ;
    rdfs:label "CompoundTrainRef" ;
    rdfs:subClassOf siri:CompoundTrainRefStructure ;
    siri:xsdElement true .

siri:ConnectionCapabilityAccessControlStructure a owl:Class ;
    rdfs:label "ConnectionCapabilityAccessControl" ;
    rdfs:comment "Abstract type for capability access control." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:checkOperatorRef ;
            siri:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:checkLineRef ;
            siri:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:checkConnectionLinkRef ;
            siri:xsdSequenceOrder 3 ],
        siri:CapabilityAccessControlStructure .

siri:ConnectionLinkPermissionStructure a owl:Class ;
    rdfs:label "ConnectionLinkPermission" ;
    rdfs:comment "Type for CONNECTION link Permission." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:connectionLinkRef ;
            siri:xsdSequenceOrder 1 ],
        siri:AbstractTopicPermissionStructure .

siri:ConnectionLinkRef a owl:Class ;
    rdfs:label "ConnectionLinkRef" ;
    rdfs:subClassOf siri:ConnectionLinkRefStructure ;
    siri:xsdElement true .

siri:ContextualisedConnectionLinkStructure a owl:Class ;
    rdfs:label "ContextualisedConnectionLink" ;
    rdfs:comment "Connection between two stops within a connection area. Used within the context of one or other end." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:connectionLinkCode ;
            siri:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:stopPointRef ;
            siri:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:stopPointName ;
            siri:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:defaultDuration ;
            siri:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:frequentTravellerDuration ;
            siri:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:occasionalTravellerDuration ;
            siri:xsdSequenceOrder 6 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:impairedAccessDuration ;
            siri:xsdSequenceOrder 7 ] .

siri:ContinuousModesEnumeration a rdfs:Datatype ;
    rdfs:label "ContinuousModesEnumeration" ;
    rdfs:comment "MODEs of transport applicable to private and non-timetabled transport." ;
    owl:oneOf ( "walk" "car" "taxi" "cycle" "drt" "movingWalkway" "through" ) .

siri:ControlActionPermissions a owl:Class ;
    rdfs:label "ControlActionPermissions" ;
    rdfs:subClassOf siri:PermissionsStructure ;
    siri:xsdElement true .

siri:ControlActionRef a owl:Class ;
    rdfs:label "ControlActionRef" ;
    rdfs:subClassOf siri:ControlActionRefStructure ;
    siri:xsdElement true .

siri:CourseOfJourneyRefStructure a owl:Class ;
    rdfs:label "CourseOfJourney" ;
    rdfs:comment "Type for reference to a COURSE OF JOURNEY (Run)." .

siri:DataFrameRefStructure a owl:Class ;
    rdfs:label "DataFrame" ;
    rdfs:comment "Type for identifier of a data VERSION FRAME." .

siri:DatedCall a owl:Class ;
    rdfs:label "DatedCall" ;
    rdfs:subClassOf siri:DatedCallStructure ;
    siri:xsdElement true .

siri:DatedJourneyPartInfoStructure a owl:Class ;
    rdfs:label "DatedJourneyPartInfo" ;
    rdfs:comment "Type for a reference to JOURNEY PART. (since SIRI 2.1)" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:journeyPartRef ;
            siri:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:trainNumberRef ;
            siri:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:operatorRef ;
            siri:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:compoundTrainRef ;
            siri:xsdSequenceOrder 4 ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:fromStopPointRef ;
            siri:xsdSequenceOrder 5 ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:toStopPointRef ;
            siri:xsdSequenceOrder 6 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:startTime ;
            siri:xsdSequenceOrder 7 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:endTime ;
            siri:xsdSequenceOrder 8 ] .

siri:DatedVehicleJourneyIndirectRefStructure a owl:Class ;
    rdfs:label "DatedVehicleJourneyIndirect" ;
    rdfs:comment "Type for Origin and Destination stop of a VEHICLE JOURNEY." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:originRef ;
            siri:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:aimedDepartureTime ;
            siri:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:destinationRef ;
            siri:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:aimedArrivalTime ;
            siri:xsdSequenceOrder 4 ] .

siri:DatedVehicleJourneyRef a owl:Class ;
    rdfs:label "DatedVehicleJourneyRef" ;
    rdfs:subClassOf siri:DatedVehicleJourneyRefStructure ;
    siri:xsdElement true .

siri:DayTypeEnumeration a rdfs:Datatype ;
    rdfs:label "DayTypeEnumeration" ;
    rdfs:comment "Values for TPEG Pti34 - DayType" ;
    owl:oneOf ( "unknown" "monday" "tuesday" "wednesday" "thursday" "friday" "saturday" "sunday" "weekdays" "weekends" "holiday" "publicHoliday" "religiousHoliday" "federalHoliday" "regionalHoliday" "nationalHoliday" "mondayToFriday" "mondayToSaturday" "sundaysAndPublicHolidays" "schoolDays" "everyDay" "undefinedDayType" ) .

siri:DaysOfWeekEnumerationx a rdfs:Datatype ;
    rdfs:label "DaysOfWeekEnumerationx" ;
    rdfs:comment "Subset of TPEG Pti34 - DayType" ;
    owl:oneOf ( "unknown" "monday" "tuesday" "wednesday" "thursday" "friday" "saturday" "sunday" "mondayToFriday" "mondayToSaturday" "weekdays" "weekends" ) .

siri:DepartureBoardingActivityEnumeration a rdfs:Datatype ;
    rdfs:label "DepartureBoardingActivityEnumeration" ;
    rdfs:comment "Allowed types activity for Boarding." ;
    owl:oneOf ( "boarding" "noBoarding" "passThru" ) .

siri:DepartureFormationAssignment a owl:Class ;
    rdfs:label "DepartureFormationAssignment" ;
    rdfs:subClassOf siri:FormationAssignmentStructure ;
    siri:xsdElement true .

siri:DepartureOperatorRefs a owl:Class ;
    rdfs:label "DepartureOperatorRefs" ;
    rdfs:subClassOf siri:OperatorRefStructure ;
    siri:xsdElement true .

siri:DepartureOrientationRelativeToQuay a owl:Class ;
    rdfs:label "DepartureOrientationRelativeToQuay" ;
    rdfs:subClassOf siri:VehicleOrientationRelativeToQuay ;
    siri:xsdElement true .

siri:DestinationRef a owl:Class ;
    rdfs:label "DestinationRef" ;
    rdfs:subClassOf siri:DestinationRefStructure ;
    siri:xsdElement true .

siri:DestinationStructure a owl:Class ;
    rdfs:label "Destination" ;
    rdfs:comment "Type for Information about a DESTINATION." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:destinationRef ;
            siri:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:destinationName ;
            siri:xsdSequenceOrder 2 ] .

siri:DirectionRefStructure a owl:Class ;
    rdfs:label "Direction" ;
    rdfs:comment "Reference to a DIRECTION." .

siri:DistributorDepartureStopRef a owl:Class ;
    rdfs:label "DistributorDepartureStopRef" ;
    rdfs:subClassOf siri:StopPointRefStructure ;
    siri:xsdElement true .

siri:DistributorRef a owl:Class ;
    rdfs:label "DistributorRef" ;
    rdfs:subClassOf siri:ConnectingJourneyRefStructure ;
    siri:xsdElement true .

siri:DriverRefStructure a owl:Class ;
    rdfs:label "Driver" ;
    rdfs:comment "Reference to a DRIVER." .

siri:EndTimePrecisionEnumeration a rdfs:Datatype ;
    rdfs:label "EndTimePrecisionEnumeration" ;
    rdfs:comment "Allowed values for EndTime Precision" ;
    owl:oneOf ( "day" "hour" "second" "milliSecond" ) .

siri:EndTimeStatusEnumeration a rdfs:Datatype ;
    rdfs:label "EndTimeStatusEnumeration" ;
    rdfs:comment "Allowed values for EndTime Status." ;
    owl:oneOf ( "undefined" "longTerm" "shortTerm" ) .

siri:EntranceToVehicleRef a owl:Class ;
    rdfs:label "EntranceToVehicleRef" ;
    rdfs:subClassOf siri:EntranceToVehicleRefStructure ;
    siri:xsdElement true .

siri:EstimatedCall a owl:Class ;
    rdfs:label "EstimatedCall" ;
    rdfs:subClassOf siri:EstimatedCallStructure ;
    siri:xsdElement true .

siri:EstimatedServiceJourneyInterchange a owl:Class ;
    rdfs:label "EstimatedServiceJourneyInterchange" ;
    rdfs:subClassOf siri:EstimatedServiceJourneyInterchangeStructure ;
    siri:xsdElement true .

siri:EstimatedTimetablePermissions a owl:Class ;
    rdfs:label "EstimatedTimetablePermissions" ;
    rdfs:subClassOf siri:PermissionsStructure ;
    siri:xsdElement true .

siri:EstimatedVehicleJourney a owl:Class ;
    rdfs:label "EstimatedVehicleJourney" ;
    rdfs:subClassOf siri:EstimatedVehicleJourneyStructure ;
    siri:xsdElement true .

siri:ExpectedDepartureCapacities a owl:Class ;
    rdfs:label "ExpectedDepartureCapacities" ;
    rdfs:subClassOf siri:PassengerCapacityStructure ;
    siri:xsdElement true .

siri:ExpectedDepartureOccupancy a owl:Class ;
    rdfs:label "ExpectedDepartureOccupancy" ;
    rdfs:subClassOf siri:VehicleOccupancyStructure ;
    siri:xsdElement true .

siri:FacilityMonitoringPermissions a owl:Class ;
    rdfs:label "FacilityMonitoringPermissions" ;
    rdfs:subClassOf siri:PermissionsStructure ;
    siri:xsdElement true .

siri:FareClassEnumeration a rdfs:Datatype ;
    rdfs:label "FareClassEnumeration" ;
    rdfs:comment "Values for Fare Class Facility. (since SIRI 2.1)" ;
    owl:oneOf ( "unknown" "firstClass" "secondClass " "secondClass" "thirdClass" "preferente" "premiumClass" "businessClass" "standardClass" "turista" "economyClass" "any" ) .

siri:FeatureRef a owl:Class ;
    rdfs:label "FeatureRef" ;
    rdfs:subClassOf siri:FeatureRefStructure ;
    siri:xsdElement true .

siri:FeederArrivalStopRef a owl:Class ;
    rdfs:label "FeederArrivalStopRef" ;
    rdfs:subClassOf siri:StopPointRefStructure ;
    siri:xsdElement true .

siri:FeederRef a owl:Class ;
    rdfs:label "FeederRef" ;
    rdfs:subClassOf siri:ConnectingJourneyRefStructure ;
    siri:xsdElement true .

siri:FirstOrLastJourneyEnumeration a rdfs:Datatype ;
    rdfs:label "FirstOrLastJourneyEnumeration" ;
    rdfs:comment "Allowed types activity for FirstOrLastJourney." ;
    owl:oneOf ( "firstServiceOfDay" "otherService" "lastServiceOfDay" "unspecified" ) .

siri:FormationChangeEnumeration a rdfs:Datatype ;
    rdfs:label "FormationChangeEnumeration" ;
    rdfs:comment "Allowed values for FORMATION CHANGE CODE. (since SIRI 2.1)" ;
    owl:oneOf ( "changedFormation" "reversedFormation" "missingVehicles" "extraVehicles" "missingTrainInCompoundTrain" "extraTrainInCompoundTrain" "missingFamilyCoach" "missingThroughCoach" "missingLowFloorCoach" "missingRestaurantCoach" "missingWheelchairSpaces" ) .

siri:FormationCondition a owl:Class ;
    rdfs:label "FormationCondition" ;
    rdfs:subClassOf siri:FormationConditionStructure ;
    siri:xsdElement true .

siri:FormationStatusStructure a owl:Class ;
    rdfs:label "FormationStatus" ;
    rdfs:comment "Description of the status of a monitored formation." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:status ;
            siri:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:onProperty siri:description ;
            siri:xsdSequenceOrder 2 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:accessibilityAssessment ;
            siri:xsdSequenceOrder 3 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:extensions ;
            siri:xsdSequenceOrder 4 ] .

siri:FramedVehicleJourneyRefStructure a owl:Class ;
    rdfs:label "FramedVehicleJourney" ;
    rdfs:comment "Type for identifer of a VEHICLE JOURNEY within data Horizon of a service." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:dataFrameRef ;
            siri:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:datedVehicleJourneyRef ;
            siri:xsdSequenceOrder 2 ] .

siri:FromServiceJourneyInterchangeStructure a owl:Class ;
    rdfs:label "FromServiceJourneyInterchange" ;
    rdfs:comment "A planned SERVICE JOURNEY INTERCHANGE from a journey. (since SIRI 2.0)" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:interchangeCode ;
            siri:xsdSequenceOrder 1 ],
        [ a owl:Restriction ;
            owl:cardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:distributorVisitNumber ;
            siri:xsdSequenceOrder 10 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:distributorStopOrder ;
            siri:xsdSequenceOrder 11 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:aimedDepartureTimeOfDistributor ;
            siri:xsdSequenceOrder 12 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:staySeated ;
            siri:xsdSequenceOrder 13 ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty siri:guaranteed ;
