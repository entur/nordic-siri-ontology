siri:ControlActionMultipleRequestStructure a owl:Class ;
    rdfs:label "ControlActionMultipleRequest" ;
    rdfs:comment "Type for Functional Service Request for Control Action Service on multiple stops." ;
    rdfs:subClassOf [ a owl:Restriction ;
