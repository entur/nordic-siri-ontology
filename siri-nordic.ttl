## -----------------------------------------------------------------
## Nordic SIRI Profile Ontology
## -----------------------------------------------------------------
## ROLE: Defines what the Nordic SIRI Profile (NSP) ALLOWS, REQUIRES,
##       and EXCLUDES beyond the SIRI XSD schema — the shared Nordic
##       real-time agreement, plus data governance and profile rules.
##
## This is the profile entry point. It imports the generated SIRI base
## (CEN-owned, vendored under base/) and the Nordic vocabulary, and is
## imported in turn by the structural, bridge and alignment overlays.
##
## Imports:
##   siri.ttl (generated) — CEN-owned SIRI base ontology, vendored under base/
##   siri-nordic-vocab.ttl — Nordic-specific vocabulary (nordic:)
##   siri-nordic-baseline.ttl — positive membership allowlist
## -----------------------------------------------------------------

@prefix siri:    <https://siri-cen.eu/ontology#> .
@prefix nordic:  <https://siri-cen.eu/nordic#> .
@prefix profile: <https://siri-cen.eu/profile#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .

## --- Import generated SIRI base + Nordic vocabulary ---
<https://siri-cen.eu/profile/nordic-siri> a owl:Ontology ;
    rdfs:label "Nordic SIRI Profile" ;
    owl:imports <https://siri-cen.eu/ontology> ,
                <https://siri-cen.eu/nordic> ,
                <https://siri-cen.eu/profile/nordic-siri-baseline> .

## =================================================================
## PROFILE DEFINITION
## =================================================================

profile:NordicSIRI a nordic:Profile ;
    rdfs:label "Nordic SIRI Profile" ;
    skos:notation "NSP" ;
    skos:definition "Nordic localisation of SIRI 2.0 for real-time public transport data exchange" ;
    nordic:version "1.1" ;
    nordic:basedOn "SIRI 2.0 XML Schema (CEN/TS 15531)" .

## =================================================================
## DATA GOVERNANCE
## =================================================================

nordic:RealTimeProducer a nordic:DataSource ;
    rdfs:label "Real-time data producer" ;
    skos:definition "Operator or data provider producing SIRI messages. Identified by ProducerRef/DataSource codespace." .

nordic:CentralAggregator a nordic:DataSource ;
    rdfs:label "Central aggregator" ;
    skos:definition "Entur AS collects SIRI data from all producers and provides a unified real-time feed." .

## =================================================================
## PROFILE CONSTRAINTS (Nordic-specific rules)
## =================================================================
## NSP-specific rules that go beyond the XSD but are mandatory for
## interoperability. Currently expressed as prose; the primary quality
## task is to promote these to executable SHACL shapes once the
## generated base is wired in. Suggested shape naming:
## profile:NSP_{ClassName}Shape.
## -----------------------------------------------------------------

profile:NordicSIRI nordic:constraint [
    nordic:rule "ET-001" ;
    nordic:description "IsCompleteStopSequence must always be true in SIRI-ET" ;
    nordic:service nordic:SIRI_ET ;
    nordic:element "EstimatedVehicleJourney/IsCompleteStopSequence" ;
    nordic:value "true"
] , [
    nordic:rule "ET-002" ;
    nordic:description "All stops must be included: RecordedCalls + EstimatedCalls = complete sequence" ;
    nordic:service nordic:SIRI_ET
] , [
    nordic:rule "ET-003" ;
    nordic:description "Replacement departures (ExtraJourney=true) require VehicleMode, RouteRef, GroupOfLinesRef, ExternalLineRef" ;
    nordic:service nordic:SIRI_ET
] , [
    nordic:rule "VM-001" ;
    nordic:description "IsCompleteStopSequence must always be false in SIRI-VM (only MonitoredCall)" ;
    nordic:service nordic:SIRI_VM ;
    nordic:element "MonitoredVehicleJourney/IsCompleteStopSequence" ;
    nordic:value "false"
] , [
    nordic:rule "VM-002" ;
    nordic:description "Delay is mandatory — use PT0S when on time" ;
    nordic:service nordic:SIRI_VM ;
    nordic:element "MonitoredVehicleJourney/Delay"
] , [
    nordic:rule "VM-003" ;
    nordic:description "VehicleRef is mandatory — every vehicle must have a unique ID" ;
    nordic:service nordic:SIRI_VM ;
    nordic:element "MonitoredVehicleJourney/VehicleRef"
] , [
    nordic:rule "VM-004" ;
    nordic:description "Vehicle coordinates must be WGS84" ;
    nordic:service nordic:SIRI_VM ;
    nordic:element "MonitoredVehicleJourney/VehicleLocation"
] , [
    nordic:rule "SX-001" ;
    nordic:description "Closing a situation requires Progress=closed and EndTime ≥ 5 hours in the future" ;
    nordic:service nordic:SIRI_SX
] , [
    nordic:rule "SX-002" ;
    nordic:description "Summary max 160 characters per language" ;
    nordic:service nordic:SIRI_SX ;
    nordic:element "PtSituationElement/Summary"
] , [
    nordic:rule "SX-003" ;
    nordic:description "SituationNumber format: CODESPACE:SituationNumber:ID — must be unique and stable" ;
    nordic:service nordic:SIRI_SX ;
    nordic:element "PtSituationElement/SituationNumber"
] , [
    nordic:rule "SX-004" ;
    nordic:description "UndefinedReason is mandatory but always empty" ;
    nordic:service nordic:SIRI_SX ;
    nordic:element "PtSituationElement/UndefinedReason"
] , [
    nordic:rule "SX-005" ;
    nordic:description "Progress restricted to open/closed only in Nordic Profile" ;
    nordic:service nordic:SIRI_SX ;
    nordic:element "PtSituationElement/Progress"
] , [
    nordic:rule "ID-001" ;
    nordic:description "All IDs follow format: Codespace:ObjectType:Identifier" ;
    rdfs:comment "Examples: NSB:ServiceJourney:1-2492-2343, NSR:Quay:709, RUT:Line:31"
] , [
    nordic:rule "DATA-001" ;
    nordic:description "Single XML file per delivery" ;
    rdfs:comment "Applies to all services"
] .

## =================================================================
## PROFILE CONSTRAINTS (SHACL shapes)
## =================================================================
## Executable form of the rules above, ported from the profile's
## earlier single-file model. sh:targetClass is bound to the real
## generated base class (element class where SIRI declares one, else
## the ...Structure type), mirroring the class binding used across
## the overlays. Shape naming: profile:NSP_{ClassName}Shape.
## PROPOSAL: the sh:path predicates below are the profile's own
## siri:{Class}_{Element} shortcuts; bind these to the real base
## properties in a dedicated property-binding pass (same principle as
## the class binding).
## -----------------------------------------------------------------

## --- EstimatedVehicleJourney (SIRI-ET) ---
profile:NSP_EstimatedVehicleJourneyShape a sh:NodeShape ;
    sh:targetClass siri:EstimatedVehicleJourney ;
    rdfs:label "EstimatedVehicleJourney — NSP constraints" ;
    sh:property [
        sh:path siri:EstimatedVehicleJourney_IsCompleteStopSequence ;
        sh:name "IsCompleteStopSequence" ;
        sh:description "ET-001: must always be true in SIRI-ET" ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:hasValue true
    ] , [
        sh:path siri:EstimatedVehicleJourney_DirectionRef ;
        sh:name "DirectionRef" ;
        sh:description "ET-004: mandatory (1:1) though not semantically used — set to 0 when unknown" ;
        sh:minCount 1 ; sh:maxCount 1
    ] ;
    rdfs:comment "ET-002: all stops must be included (RecordedCalls + EstimatedCalls = complete sequence). ET-003: replacement departures (ExtraJourney=true) require VehicleMode, RouteRef, GroupOfLinesRef and ExternalLineRef." .

## --- MonitoredVehicleJourney (SIRI-VM) ---
profile:NSP_MonitoredVehicleJourneyShape a sh:NodeShape ;
    sh:targetClass siri:MonitoredVehicleJourneyStructure ;
    rdfs:label "MonitoredVehicleJourney — NSP constraints" ;
    sh:property [
        sh:path siri:MonitoredVehicleJourney_IsCompleteStopSequence ;
        sh:name "IsCompleteStopSequence" ;
        sh:description "VM-001: must always be false in SIRI-VM (only MonitoredCall)" ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:hasValue false
    ] , [
        sh:path siri:MonitoredVehicleJourney_Delay ;
        sh:name "Delay" ;
        sh:description "VM-002: mandatory — use PT0S when on time" ;
        sh:minCount 1
    ] , [
        sh:path siri:MonitoredVehicleJourney_VehicleRef ;
        sh:name "VehicleRef" ;
        sh:description "VM-003: mandatory — every vehicle must have a unique ID" ;
        sh:minCount 1
    ] ;
    sh:xone (
        [ sh:path siri:MonitoredVehicleJourney_FramedVehicleJourneyRef ; sh:minCount 1 ]
        [ sh:path siri:MonitoredVehicleJourney_VehicleJourneyRef ; sh:minCount 1 ]
    ) ;
    rdfs:comment "VM-004: vehicle coordinates must be WGS84. VM-005: exactly one of FramedVehicleJourneyRef (ServiceJourney + date) or VehicleJourneyRef (DatedServiceJourney) — enforced via the sh:xone above." .

## --- PtSituationElement (SIRI-SX) ---
profile:NSP_PtSituationElementShape a sh:NodeShape ;
    sh:targetClass siri:PtSituationElement ;
    rdfs:label "PtSituationElement — NSP constraints" ;
    sh:property [
        sh:path siri:PtSituationElement_Source ;
        sh:name "Source" ;
        sh:description "SX-006: Source (SituationSource) is mandatory (1:1)" ;
        sh:minCount 1 ; sh:maxCount 1
    ] , [
        sh:path siri:PtSituationElement_Affects ;
        sh:name "Affects" ;
        sh:description "SX-007: Affects is mandatory (1:1); may only be empty when Progress='closed'" ;
        sh:minCount 1 ; sh:maxCount 1
    ] , [
        sh:path siri:PtSituationElement_Progress ;
        sh:name "Progress" ;
        sh:description "SX-005: restricted to open/closed in the Nordic Profile" ;
        sh:in ( "open" "closed" )
    ] , [
        sh:path siri:PtSituationElement_Summary ;
        sh:name "Summary" ;
        sh:description "SX-002: max 160 characters per language" ;
        sh:maxLength 160
    ] , [
        sh:path siri:PtSituationElement_SituationNumber ;
        sh:name "SituationNumber" ;
        sh:description "SX-003: format CODESPACE:SituationNumber:ID — must be unique and stable" ;
        sh:pattern "^[^:]+:[^:]+:.+$"
    ] , [
        sh:path siri:PtSituationElement_UndefinedReason ;
        sh:name "UndefinedReason" ;
        sh:description "SX-004: mandatory but always empty" ;
        sh:minCount 1 ; sh:maxLength 0
    ] ;
    rdfs:comment "SX-001: closing a situation requires Progress=closed and EndTime ≥ 5 hours in the future. SX-008: when several ValidityPeriods are given, all but the last must have an EndTime." .

## --- AffectedNetwork (SIRI-SX) ---
profile:NSP_AffectedNetworkShape a sh:NodeShape ;
    sh:targetClass siri:AffectedNetworkStructure ;
    rdfs:label "AffectedNetwork — NSP constraints" ;
    rdfs:comment "SX-009: AffectedNetwork requires an explicit AffectedLine or AllLines; when a VehicleMode is given it must be paired with its submode unless all modalities are affected. Conditional rule — enforce via SHACL-SPARQL." .
